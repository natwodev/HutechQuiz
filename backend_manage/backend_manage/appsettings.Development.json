      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DataProtection": {
    "ApplicationName": "HutechQuizApp",
    "FixedKey": "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF",
