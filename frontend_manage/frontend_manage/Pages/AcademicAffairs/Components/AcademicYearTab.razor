@using frontend_manage.DTOs.AcademicAffairs
@using frontend_manage.Services.AcademicAffairs
@using frontend_manage.Pages.AcademicAffairs.Components

<MudCard Elevation="0" Style="background: transparent; border: none; height: 100%; display: flex; flex-direction: column;">
    <MudCardHeader Style="background: transparent; border-bottom: 1px solid rgba(38, 68, 136, 0.2); flex-shrink: 0;">
        <MudText Typo="Typo.h6" Style="color: var(--primary-color); font-weight: 600;">Quản lý Năm học</MudText>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" 
                OnClick="OpenCreateDialog" Style="background: var(--primary-color); border: none; border-radius: 12px; font-weight: 500; text-transform: none; box-shadow: 0 4px 15px rgba(38, 68, 136, 0.3);">Thêm năm học</MudButton>
    </MudCardHeader>
    <MudCardContent Style="background: transparent; flex: 1; overflow: hidden; padding: 0;">
        <MudTable Items="@AcademicYears" Hover="true" Dense="false" Striped="true" 
                  Style="background: var(--glass-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: 16px; overflow: hidden; height: 100%;">
            <HeaderContent>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">ID</MudTh>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Tên năm học</MudTh>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Số học kỳ</MudTh>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID" Style="color: var(--text-primary);">@context.AcademicYearId</MudTd>
                <MudTd DataLabel="Tên năm học" Style="color: var(--text-primary);">@context.YearName</MudTd>
                <MudTd DataLabel="Số học kỳ" Style="color: var(--text-primary);">@context.Semesters.Count</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                OnClick="@(() => EditAcademicYear(context))" 
                                Style="background: var(--primary-color); color: white; border-radius: 8px; margin-right: 8px;" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                OnClick="@(() => DeleteAcademicYear(context))" 
                                Style="background: #ea4335; color: white; border-radius: 8px;" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" Style="background: rgba(38, 68, 136, 0.1); color: var(--text-primary);" />
            </PagerContent>
        </MudTable>
    </MudCardContent>
</MudCard>

