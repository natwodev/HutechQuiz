@using frontend_manage.DTOs.AcademicAffairs
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks

<link href="css/academic-affairs/AcademicYearsTab.css" rel="stylesheet" />

<div class="academic-years-tab">
    <div class="tab-header">
        <div class="title-area">
            <h2>QUẢN LÝ NĂM HỌC</h2>
            
        </div>
        <div class="action-area">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CreateNew">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-1" />
                Tạo năm học mới
            </MudButton>
        </div>
    </div>

    @if (_showForm)
    {
        <MudPaper Class="pa-3 mb-3" Style="max-width: 800px; margin: 0 auto;">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6" Class="mb-2">
                    @(_isEditMode ? "Chỉnh sửa năm học" : "Tạo năm học mới")
                </MudText>

                <EditForm Model="_formData" OnValidSubmit="SaveForm">
                    <DataAnnotationsValidator />
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_formData.YearName"
                                          Label="Tên năm học"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Size="Size.Small" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Spacing="2" Class="mt-3" Justify="Justify.FlexEnd" Direction="Direction.Row">
                        <MudButton Variant="Variant.Text" OnClick="CancelForm" Size="Size.Small">
                            Hủy
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Size="Size.Small">
                            Lưu
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>
    }

    @if (!_showForm)
    {
        <div class="pa-2 mb-2">
            <div class="d-flex" style="gap:12px; align-items:center; flex-wrap:wrap;">
                <input type="text"
                       class="form-control"
                       style="max-width: 320px;"
                       placeholder="Tìm theo tên năm học"
                       value="@_searchText"
                       @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="data-table-container">
            <MudTable Items="@PagedAcademicYears" Hover="true" Striped="true" Dense="true">
                <HeaderContent>
                    <MudTh>STT</MudTh>
                    <MudTh>Tên năm học</MudTh>
                    <MudTh>Số học kỳ</MudTh>
                    <MudTh>Học kỳ</MudTh>
                    <MudTh>Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var index = FilteredAcademicYears.ToList().IndexOf(context) + 1;
                    }
                    <MudTd>@index</MudTd>
                    <MudTd>@context.YearName</MudTd>
                    <MudTd>@context.Semesters.Count</MudTd>
                    <MudTd>
                        @if (context.Semesters.Any())
                        {
                            <div class="semesters-list">
                                @foreach (var semester in context.Semesters.Take(3))
                                {
                                    <MudChip T="string" Color="@(semester.IsActive ? Color.Primary : Color.Default)" 
                                           Size="Size.Small" Class="mb-1">
                                        @semester.SemesterName
                                    </MudChip>
                                }
                                @if (context.Semesters.Count > 3)
                                {
                                    <MudChip T="string" Color="Color.Secondary" Size="Size.Small">
                                        +@(context.Semesters.Count - 3) khác
                                    </MudChip>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">Chưa có học kỳ</span>
                        }
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" 
                                      Color="Color.Primary" OnClick="@(() => EditAcademicYear(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" 
                                      Color="Color.Error" OnClick="@(() => DeleteAcademicYear(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div>
                    <span>Hiển thị</span>
                    <select class="form-control d-inline-block" style="width:90px" value="@_pageSize" @onchange="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>bản ghi</span>
                </div>
                <div class="d-flex" style="gap:8px">
                    <button class="btn btn-outline-secondary" @onclick="GoPrev">« Trước</button>
                    <div class="align-self-center">Trang @(_page + 1)</div>
                    <button class="btn btn-outline-secondary" @onclick="GoNext">Sau »</button>
                </div>
            </div>
        </div>
    }
</div>
