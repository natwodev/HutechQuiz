@using frontend_manage.DTOs.AcademicAffairs
@using frontend_manage.Services.AcademicAffairs
@using frontend_manage.Pages.AcademicAffairs.Components
@using MudBlazor

<BaseDialog Title="@(IsEdit ? "Chỉnh sửa đợt thi" : "Thêm đợt thi mới")" 
           SaveText="@(IsEdit ? "Cập nhật" : "Thêm mới")" 
           IsLoading="@_isLoading" 
           OnSave="SaveExamBatch">
    <MudForm @ref="_form" @bind-IsValid="@_isValid" @bind-Errors="@_errors">
        <MudTextField @bind-Value="_examBatch.BatchName"
                     Label="Tên đợt thi"
                     Required="true"
                     RequiredError="Tên đợt thi là bắt buộc"
                     MaxLength="100"
                     Counter="100"
                     Immediate="true" />
        
        <MudTextField @bind-Value="_examBatch.Description"
                     Label="Mô tả"
                     MaxLength="500"
                     Counter="500"
                     Lines="3" />
        
        <MudSelect @bind-Value="_examBatch.SemesterId"
                  Label="Học kỳ"
                  Required="true"
                  RequiredError="Học kỳ là bắt buộc"
                  Immediate="true">
            @foreach (var semester in Semesters)
            {
                <MudSelectItem Value="@semester.SemesterId">@semester.SemesterName</MudSelectItem>
            }
        </MudSelect>
        
        <MudDatePicker @bind-Date="_startDate"
                      Label="Ngày bắt đầu"
                      Required="true"
                      RequiredError="Ngày bắt đầu là bắt buộc"
                      Immediate="true" />
        
        <MudDatePicker @bind-Date="_endDate"
                      Label="Ngày kết thúc"
                      Required="true"
                      RequiredError="Ngày kết thúc là bắt buộc"
                      Immediate="true" />
        
        <MudSwitch T="bool" @bind-Checked="_examBatch.IsActive" Label="Trạng thái hoạt động" />
    </MudForm>
</BaseDialog>

