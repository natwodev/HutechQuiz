@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="examBatch.BatchName" Label="Tên đợt thi" Required="true" RequiredError="Tên đợt thi không được để trống" />
        
        <MudTextField @bind-Value="examBatch.Description" Label="Mô tả" Lines="3" />
        
        <MudDatePicker Date="@examBatch.StartDate" DateChanged="(value) => examBatch.StartDate = value ?? DateTime.Now" Label="Ngày bắt đầu" Required="true" RequiredError="Ngày bắt đầu không được để trống" />
        
        <MudDatePicker Date="@examBatch.EndDate" DateChanged="(value) => examBatch.EndDate = value ?? DateTime.Now.AddDays(7)" Label="Ngày kết thúc" Required="true" RequiredError="Ngày kết thúc không được để trống" />
        
        <MudSelect T="int" Label="Học kỳ" @bind-Value="examBatch.SemesterId" Required="true" RequiredError="Vui lòng chọn học kỳ">
            @foreach (var semester in Semesters)
            {
                <MudSelectItem Value="@semester.SemesterId">@semester.SemesterName (@semester.AcademicYearName)</MudSelectItem>
            }
        </MudSelect>
        
        <MudSwitch T="bool" @bind-Checked="examBatch.IsActive" Label="Hoạt động" Color="Color.Primary" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="@Color" Variant="Variant.Filled" OnClick="Submit">@ButtonText</MudButton>
    </DialogActions>
</MudDialog>
