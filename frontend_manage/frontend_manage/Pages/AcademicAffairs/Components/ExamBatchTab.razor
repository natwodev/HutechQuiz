@using frontend_manage.DTOs.AcademicAffairs
@using frontend_manage.Services.AcademicAffairs
@inject ExamBatchService ExamBatchService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudCard Elevation="0">
    <MudCardHeader>
        <MudText Typo="Typo.h6">Quản lý Đợt thi</MudText>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" 
                  OnClick="OpenCreateDialog">Thêm đợt thi</MudButton>
    </MudCardHeader>
    <MudCardContent>
        <MudTable Items="@ExamBatches" Hover="true" Dense="false" Striped="true" Filter="new Func<ExamBatchDto, bool>(FilterFunc)" 
                 @bind-SelectedItem="selectedItem">
            <ToolBarContent>
                <MudTextField @bind-Value="searchString" Placeholder="Tìm kiếm" Adornment="Adornment.Start" 
                             AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Tên đợt thi</MudTh>
                <MudTh>Mô tả</MudTh>
                <MudTh>Ngày bắt đầu</MudTh>
                <MudTh>Ngày kết thúc</MudTh>
                <MudTh>Học kỳ</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh>Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.ExamBatchId</MudTd>
                <MudTd DataLabel="Tên đợt thi">@context.BatchName</MudTd>
                <MudTd DataLabel="Mô tả">@context.Description</MudTd>
                <MudTd DataLabel="Ngày bắt đầu">@context.StartDate.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Ngày kết thúc">@context.EndDate.ToString("dd/MM/yyyy")</MudTd>
                <MudTd DataLabel="Học kỳ">@context.SemesterName</MudTd>
                <MudTd DataLabel="Trạng thái">
                    <MudChip T="bool" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small">
                        @(context.IsActive ? "Đang hoạt động" : "Không hoạt động")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                  OnClick="@(() => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                  OnClick="@(() => OpenDeleteDialog(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" />
            </PagerContent>
        </MudTable>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public List<ExamBatchDto> ExamBatches { get; set; } = new();
    
    [Parameter]
    public List<SemesterDto> Semesters { get; set; } = new();
    
    [Parameter]
    public EventCallback OnExamBatchUpdated { get; set; }
    
    private ExamBatchDto selectedItem = null;
    private string searchString = "";
    
    private bool FilterFunc(ExamBatchDto examBatch) => 
        string.IsNullOrWhiteSpace(searchString) || 
        examBatch.BatchName.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
        examBatch.Description.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
        examBatch.SemesterName.Contains(searchString, StringComparison.OrdinalIgnoreCase);
    
    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { "Title", "Thêm đợt thi mới" },
            { "ButtonText", "Thêm" },
            { "Color", Color.Primary },
            { "Semesters", Semesters }
        };
        
        var dialog = await DialogService.ShowAsync<ExamBatchDialog>("Thêm đợt thi", parameters);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        {
            var newExamBatch = (ExamBatchCreateDto)result.Data;
            try
            {
                await ExamBatchService.CreateAsync(newExamBatch);
                await OnExamBatchUpdated.InvokeAsync();
                Snackbar.Add("Thêm đợt thi thành công", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
            }
        }
    }
    
    private async Task OpenEditDialog(ExamBatchDto examBatch)
    {
        var parameters = new DialogParameters
        {
            { "Title", "Cập nhật đợt thi" },
            { "ButtonText", "Cập nhật" },
            { "Color", Color.Primary },
            { "Semesters", Semesters },
            { "ExamBatch", new ExamBatchUpdateDto { 
                BatchName = examBatch.BatchName,
                Description = examBatch.Description,
                StartDate = examBatch.StartDate,
                EndDate = examBatch.EndDate,
                SemesterId = examBatch.SemesterId,
                IsActive = examBatch.IsActive
            } }
        };
        
        var dialog = await DialogService.ShowAsync<ExamBatchDialog>("Cập nhật đợt thi", parameters);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        {
            var updatedExamBatch = (ExamBatchUpdateDto)result.Data;
            try
            {
                await ExamBatchService.UpdateAsync(examBatch.ExamBatchId, updatedExamBatch);
                await OnExamBatchUpdated.InvokeAsync();
                Snackbar.Add("Cập nhật đợt thi thành công", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
            }
        }
    }
    
    private async Task OpenDeleteDialog(ExamBatchDto examBatch)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Bạn có chắc chắn muốn xóa đợt thi '{examBatch.BatchName}'?" },
            { "ButtonText", "Xóa" },
            { "Color", Color.Error }
        };
        
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Xác nhận xóa", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        {
            try
            {
                await ExamBatchService.DeleteAsync(examBatch.ExamBatchId);
                await OnExamBatchUpdated.InvokeAsync();
                Snackbar.Add("Xóa đợt thi thành công", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
            }
        }
    }
}
