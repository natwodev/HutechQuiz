@using frontend_manage.DTOs.AcademicAffairs
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks

<link href="css/academic-affairs/ExamBatchesTab.css" rel="stylesheet" />

<div class="exam-batches-tab">
    <div class="tab-header">
        <div class="title-area">
            <h2>QUẢN LÝ ĐỢT THI</h2>
            @if (ExamBatches != null && ExamBatches.Any())
            {
                <div class="info-text">
                    Tổng số đợt thi: <strong>@ExamBatches.Count</strong> | 
                    Đang hoạt động: <strong>@ExamBatches.Count(x => x.IsActive)</strong>
                </div>
            }
        </div>
        <div class="action-area">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CreateNew">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-1" />
                Tạo đợt thi mới
            </MudButton>
        </div>
    </div>

    @if (_showForm)
    {
        <MudPaper Class="pa-3 mb-3" Style="max-width: 800px; margin: 0 auto;">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6" Class="mb-2">
                    @(_isEditMode ? "Chỉnh sửa đợt thi" : "Tạo đợt thi mới")
                </MudText>

                <EditForm Model="_formData" OnValidSubmit="SaveForm">
                    <DataAnnotationsValidator />
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_formData.BatchName"
                                          Label="Tên đợt thi"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Size="Size.Small" />
                        </MudItem>
                        
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_formData.Description"
                                          Label="Mô tả"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          Lines="3" />
                        </MudItem>
                        
                        <MudItem xs="6">
                            <MudTextField Label="Ngày bắt đầu"
                                          @bind-Value="_startDateString"
                                          @onchange="OnStartDateChanged"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          InputType="InputType.Date" />
                        </MudItem>
                        
                        <MudItem xs="6">
                            <MudTextField Label="Ngày kết thúc"
                                          @bind-Value="_endDateString"
                                          @onchange="OnEndDateChanged"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          InputType="InputType.Date" />
                        </MudItem>
                        
                        <MudItem xs="12">
                            <div class="form-check">
                                <input class="form-check-input" 
                                       type="checkbox" 
                                       @bind="_formData.IsActive" 
                                       id="isActiveCheckbox">
                                <label class="form-check-label" for="isActiveCheckbox">
                                    @(_formData.IsActive ? "Hoạt động" : "Không hoạt động")
                                </label>
                            </div>
                        </MudItem>
                    </MudGrid>

                    <MudStack Spacing="2" Class="mt-3" Justify="Justify.FlexEnd" Direction="Direction.Row">
                        <MudButton Variant="Variant.Text" OnClick="CancelForm" Size="Size.Small">
                            Hủy
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Size="Size.Small">
                            Lưu
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>
    }

    @if (!_showForm)
    {
        <div class="pa-2 mb-2">
            <div class="d-flex" style="gap:12px; align-items:center; flex-wrap:wrap;">
                <input type="text"
                       class="form-control"
                       style="max-width: 280px;"
                       placeholder="Tìm theo tên/mô tả"
                       value="@_searchText"
                       @oninput="OnSearchInput" />
                <select class="form-control" style="max-width: 180px;" value="@_statusFilter" @onchange="OnStatusChanged">
                    <option value="all">Tất cả</option>
                    <option value="active">Đang hoạt động</option>
                    <option value="inactive">Chưa kích hoạt</option>
                </select>
            </div>
        </div>
        <div class="data-table-container">
            <MudTable @ref="_tableRef" ServerData="LoadExamBatches" Hover="true" Striped="true" Dense="true" RowsPerPage="@_pageSize">
                <HeaderContent>
                    <MudTh>STT</MudTh>
                    <MudTh>Tên đợt thi</MudTh>
                    <MudTh>Mô tả</MudTh>
                    <MudTh>Ngày bắt đầu</MudTh>
                    <MudTh>Ngày kết thúc</MudTh>
                    <MudTh>Học kỳ</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var index = (_page * @_pageSize) + _currentPageItems.IndexOf(context) + 1;
                    }
                    <MudTd>@index</MudTd>
                    <MudTd>@context.BatchName</MudTd>
                    <MudTd>@(context.Description ?? "Không có mô tả")</MudTd>
                    <MudTd>@context.StartDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>@context.EndDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>@context.SemesterName</MudTd>
                    <MudTd>
                        @if (context.IsActive)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">Đang hoạt động</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small">Chưa kích hoạt</MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" 
                                      Color="Color.Primary" OnClick="@(() => EditExamBatch(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" 
                                      Color="Color.Error" OnClick="@(() => DeleteExamBatch(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div>
                    <span>Hiển thị</span>
                    <select class="form-control d-inline-block" style="width:90px" value="@_pageSize" @onchange="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>bản ghi</span>
                </div>
                <div class="d-flex" style="gap:8px">
                    <button class="btn btn-outline-secondary" @onclick="GoPrev">« Trước</button>
                    <div class="align-self-center">Trang @(_page + 1)</div>
                    <button class="btn btn-outline-secondary" @onclick="GoNext">Sau »</button>
                </div>
            </div>
        </div>
    }
</div>
