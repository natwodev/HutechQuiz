@using frontend_manage.DTOs.AcademicAffairs
@using frontend_manage.Services.AcademicAffairs
@using frontend_manage.Pages.AcademicAffairs.Components
@using MudBlazor

<BaseDialog Title="@(IsEdit ? "Chỉnh sửa ca thi" : "Thêm ca thi mới")" 
           SaveText="@(IsEdit ? "Cập nhật" : "Thêm mới")" 
           IsLoading="@_isLoading" 
           OnSave="SaveExamSession">
    <MudForm @ref="_form" @bind-IsValid="@_isValid" @bind-Errors="@_errors">
        <MudTextField @bind-Value="_examSession.Name"
                     Label="Tên ca thi"
                     Required="true"
                     RequiredError="Tên ca thi là bắt buộc"
                     MaxLength="100"
                     Counter="100"
                     Immediate="true" />
        
        <MudSelect @bind-Value="_examSession.ExamBatchDetailId"
                  Label="Chi tiết đợt thi"
                  Required="true"
                  RequiredError="Chi tiết đợt thi là bắt buộc"
                  Immediate="true">
            @foreach (var examBatch in ExamBatches)
            {
                @foreach (var detail in examBatch.ExamBatchDetails)
                {
                    <MudSelectItem Value="@detail.ExamBatchDetailId">@detail.Name - @examBatch.BatchName</MudSelectItem>
                }
            }
        </MudSelect>
        
        <MudTimePicker @bind-Time="_startTime"
                      Label="Thời gian bắt đầu"
                      Required="true"
                      RequiredError="Thời gian bắt đầu là bắt buộc"
                      Immediate="true" />
        
        <MudTimePicker @bind-Time="_endTime"
                      Label="Thời gian kết thúc"
                      Required="true"
                      RequiredError="Thời gian kết thúc là bắt buộc"
                      Immediate="true" />
        
        <MudSwitch T="bool" @bind-Checked="_examSession.IsActive" Label="Trạng thái hoạt động" />
        <MudSwitch T="bool" @bind-Checked="_examSession.IsCompleted" Label="Đã hoàn thành" />
    </MudForm>
</BaseDialog>

