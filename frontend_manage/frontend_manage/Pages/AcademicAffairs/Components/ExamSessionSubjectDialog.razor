@using frontend_manage.DTOs.AcademicAffairs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Sửa ca thi môn học</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="examSessionSubject" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <MudStack Spacing="3">
                <MudNumericField @bind-Value="examSessionSubject.ExamSessionDepartmentId" 
                                  Label="ID Ca thi - Khoa" 
                                  Variant="Variant.Outlined" 
                                  Required="true"
                                  RequiredError="ID Ca thi - Khoa không được để trống"
                                  HelperText="Nhập ID của ca thi - khoa" />
                
                <MudNumericField @bind-Value="examSessionSubject.SubjectId" 
                                  Label="ID Môn học" 
                                  Variant="Variant.Outlined" 
                                  Required="true"
                                  RequiredError="ID Môn học không được để trống"
                                  HelperText="Nhập ID của môn học" />
                
                <MudNumericField @bind-Value="examSessionSubject.Duration" 
                                  Label="Thời lượng (phút)" 
                                  Variant="Variant.Outlined" 
                                  Required="true"
                                  RequiredError="Thời lượng không được để trống"
                                  Min="1" />
                
                <MudNumericField @bind-Value="examSessionSubject.OriginalExamPaperId" 
                                  Label="ID Đề gốc (tùy chọn)" 
                                  Variant="Variant.Outlined" 
                                  HelperText="Nhập ID đề gốc nếu có" />
                
                <MudTextField @bind-Value="startTimeString" 
                             Label="Thời gian bắt đầu" 
                             Variant="Variant.Outlined"
                             InputType="InputType.DateTimeLocal"
                             Required="true"
                             RequiredError="Thời gian bắt đầu không được để trống" />
                
                <MudTextField @bind-Value="endTimeString" 
                             Label="Thời gian kết thúc (tùy chọn)" 
                             Variant="Variant.Outlined"
                             InputType="InputType.DateTimeLocal" />
                
                <MudTextField @bind-Value="examSessionSubject.ExamSessionSubjectCore" 
                             Label="Mã ca thi môn học" 
                             Variant="Variant.Outlined" />
                
                <MudSwitch @bind-Value="examSessionSubject.IsCompleted" 
                          Label="Đã hoàn thành" 
                          Color="Color.Success" />
            </MudStack>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="HandleSubmit">Lưu</MudButton>
    </DialogActions>
</MudDialog>

