@using frontend_manage.DTOs.AcademicAffairs
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks

<link href="css/academic-affairs/ExamSessionSubjectsTab.css" rel="stylesheet" />

<div class="exam-session-subjects-tab">
    <div class="tab-header">
        <div class="title-area">
            <h2>QUẢN LÝ MÔN THI</h2>
            @if (ExamSessionSubjects != null && ExamSessionSubjects.Any())
            {
                <div class="info-text">
                    Tổng số môn thi: <strong>@ExamSessionSubjects.Count</strong> | 
                    Đã hoàn thành: <strong>@ExamSessionSubjects.Count(x => x.IsCompleted)</strong>
                </div>
            }
        </div>
        <div class="action-area">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="CreateNew">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-1" />
                Tạo môn thi mới
            </MudButton>
        </div>
    </div>

    @if (_showForm)
    {
        <MudPaper Class="pa-3 mb-3" Style="max-width: 800px; margin: 0 auto;">
            <MudStack Spacing="2">
                <MudText Typo="Typo.h6" Class="mb-2">
                    @(_isEditMode ? "Chỉnh sửa môn thi" : "Tạo môn thi mới")
                </MudText>

                <EditForm Model="_formData" OnValidSubmit="SaveForm">
                    <DataAnnotationsValidator />
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_formData.SubjectName"
                                          Label="Tên môn thi"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          Size="Size.Small" />
                        </MudItem>
                        
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_formData.RoomName"
                                          Label="Phòng thi"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small" />
                        </MudItem>
                        
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_formData.MonitorName"
                                          Label="Giám thị"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small" />
                        </MudItem>
                        
                        <MudItem xs="6">
                            <MudTextField Label="Ngày thi"
                                          @bind-Value="_examDateString"
                                          @onchange="OnExamDateChanged"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          InputType="InputType.Date" />
                        </MudItem>
                        
                        <MudItem xs="6">
                            <MudTextField Label="Giờ thi"
                                          @bind-Value="_examTimeString"
                                          @onchange="OnExamTimeChanged"
                                          Variant="Variant.Outlined"
                                          Size="Size.Small"
                                          InputType="InputType.Time" />
                        </MudItem>
                        
                        <MudItem xs="12">
                            <div class="form-check">
                                <input class="form-check-input" 
                                       type="checkbox" 
                                       @bind="_formData.IsCompleted" 
                                       id="isCompletedCheckbox">
                                <label class="form-check-label" for="isCompletedCheckbox">
                                    @(_formData.IsCompleted ? "Đã hoàn thành" : "Chưa hoàn thành")
                                </label>
                            </div>
                        </MudItem>
                    </MudGrid>

                    <MudStack Spacing="2" Class="mt-3" Justify="Justify.FlexEnd" Direction="Direction.Row">
                        <MudButton Variant="Variant.Text" OnClick="CancelForm" Size="Size.Small">
                            Hủy
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" ButtonType="ButtonType.Submit" Size="Size.Small">
                            Lưu
                        </MudButton>
                    </MudStack>
                </EditForm>
            </MudStack>
        </MudPaper>
    }

    @if (!_showForm)
    {
        <div class="pa-2 mb-2">
            <div class="d-flex" style="gap:12px; align-items:center; flex-wrap:wrap;">
                <input type="text"
                       class="form-control"
                       style="max-width: 320px;"
                       placeholder="Tìm theo tên môn/giám thị/phòng"
                       value="@_searchText"
                       @oninput="OnSearchInput" />
                <select class="form-control" style="max-width: 180px;" value="@_statusFilter" @onchange="OnStatusChanged">
                    <option value="all">Tất cả</option>
                    <option value="completed">Hoàn thành</option>
                    <option value="pending">Chưa hoàn thành</option>
                </select>
            </div>
        </div>
        <div class="data-table-container">
            <MudTable @ref="_tableRef" ServerData="LoadExamSessionSubjects" Hover="true" Striped="true" Dense="true" RowsPerPage="@_pageSize">
                <HeaderContent>
                    <MudTh>STT</MudTh>
                    <MudTh>Tên môn thi</MudTh>
                    <MudTh>Thời gian thi</MudTh>
                    <MudTh>Thời gian bắt đầu</MudTh>
                    <MudTh>Thời gian kết thúc</MudTh>
                    <MudTh>Phòng thi</MudTh>
                    <MudTh>Giám thị</MudTh>
                    <MudTh>Trạng thái</MudTh>
                    <MudTh>Thao tác</MudTh>
                </HeaderContent>
                <RowTemplate>
                    @{
                        var index = (_page * _pageSize) + _currentPageItems.IndexOf(context) + 1;
                    }
                    <MudTd>@index</MudTd>
                    <MudTd>@context.SubjectName</MudTd>
                    <MudTd>@context.Duration phút</MudTd>
                    <MudTd>@context.StartTime.ToString("HH:mm dd/MM/yyyy")</MudTd>
                    <MudTd>@(context.EndTime?.ToString("HH:mm dd/MM/yyyy") ?? "Chưa xác định")</MudTd>
                    <MudTd>@(context.RoomName ?? "Chưa phân phòng")</MudTd>
                    <MudTd>@(context.MonitorName ?? "Chưa phân giám thị")</MudTd>
                    <MudTd>
                        @if (context.IsCompleted)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Hoàn thành</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Chưa hoàn thành</MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" 
                                      Color="Color.Primary" OnClick="() => EditExamSessionSubject(context)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" 
                                      Color="Color.Error" OnClick="@(() => DeleteExamSessionSubject(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
            <div class="d-flex justify-content-between align-items-center mt-2">
                <div>
                    <span>Hiển thị</span>
                    <select class="form-control d-inline-block" style="width:90px" value="@_pageSize" @onchange="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                    <span>bản ghi</span>
                </div>
                <div class="d-flex" style="gap:8px">
                    <button class="btn btn-outline-secondary" @onclick="GoPrev">« Trước</button>
                    <div class="align-self-center">Trang @(_page + 1)</div>
                    <button class="btn btn-outline-secondary" @onclick="GoNext">Sau »</button>
                </div>
            </div>
        </div>
    }
</div>
