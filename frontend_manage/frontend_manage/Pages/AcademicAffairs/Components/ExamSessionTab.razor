@using frontend_manage.DTOs.AcademicAffairs
@using frontend_manage.Services.AcademicAffairs
@using frontend_manage.Pages.AcademicAffairs.Components

<MudCard Elevation="0" Style="background: transparent; border: none; height: 100%; display: flex; flex-direction: column;">
    <MudCardHeader Style="background: transparent; border-bottom: 1px solid rgba(38, 68, 136, 0.2); flex-shrink: 0;">
        <MudText Typo="Typo.h6" Style="color: var(--primary-color); font-weight: 600;">Quản lý Ca thi</MudText>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" 
                OnClick="OpenCreateDialog" Style="background: var(--warning-gradient); border: none; border-radius: 12px; font-weight: 500; text-transform: none; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);">Thêm ca thi</MudButton>
    </MudCardHeader>
    <MudCardContent Style="background: transparent; flex: 1; overflow: hidden; padding: 0;">
        <MudTable Items="@ExamSessions" Hover="true" Dense="false" Striped="true" 
                  Style="background: var(--glass-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: 16px; overflow: hidden; height: 100%;">
            <HeaderContent>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">ID</MudTh>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Tên ca thi</MudTh>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Đợt thi</MudTh>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Thời gian bắt đầu</MudTh>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Thời gian kết thúc</MudTh>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Trạng thái</MudTh>
                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID" Style="color: var(--text-primary);">@context.ExamSessionId</MudTd>
                <MudTd DataLabel="Tên ca thi" Style="color: var(--text-primary);">@context.Name</MudTd>
                <MudTd DataLabel="Đợt thi" Style="color: var(--text-primary);">@context.ExamBatchDetailName</MudTd>
                <MudTd DataLabel="Thời gian bắt đầu" Style="color: var(--text-primary);">@context.StartTime.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Thời gian kết thúc" Style="color: var(--text-primary);">@context.EndTime.ToString("dd/MM/yyyy HH:mm")</MudTd>
                <MudTd DataLabel="Trạng thái">
                    <MudChip T="bool" Color="@(context.IsActive ? Color.Success : Color.Error)" Size="Size.Small"
                             Style="@(context.IsActive ? "background: var(--success-gradient); color: var(--primary-color);" : "background: var(--error-gradient); color: var(--primary-color);")">
                        @(context.IsActive ? "Hoạt động" : "Không hoạt động")
                    </MudChip>
                    @if (context.IsCompleted)
                    {
                        <MudChip T="bool" Color="Color.Info" Size="Size.Small" Class="ml-2" Style="background: var(--info-gradient); color: var(--primary-color);">Đã hoàn thành</MudChip>
                    }
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                OnClick="@(() => EditExamSession(context))" 
                                Style="background: var(--warning-gradient); color: var(--primary-color); border-radius: 8px; margin-right: 8px;" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                OnClick="@(() => DeleteExamSession(context))" 
                                Style="background: var(--error-gradient); color: var(--primary-color); border-radius: 8px;" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" Style="background: rgba(38, 68, 136, 0.1); color: var(--primary-color);" />
            </PagerContent>
        </MudTable>
    </MudCardContent>
</MudCard>

