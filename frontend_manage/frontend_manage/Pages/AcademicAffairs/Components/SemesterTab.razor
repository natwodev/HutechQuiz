@using frontend_manage.DTOs.AcademicAffairs
@using frontend_manage.Services.AcademicAffairs
@inject SemesterService SemesterService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudCard Elevation="0">
    <MudCardHeader>
        <MudText Typo="Typo.h6">Quản lý Học kỳ</MudText>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" 
                  OnClick="OpenCreateDialog">Thêm học kỳ</MudButton>
    </MudCardHeader>
    <MudCardContent>
        <MudTable Items="@Semesters" Hover="true" Dense="false" Striped="true" Filter="new Func<SemesterDto, bool>(FilterFunc)" 
                 @bind-SelectedItem="selectedItem">
            <ToolBarContent>
                <MudTextField @bind-Value="searchString" Placeholder="Tìm kiếm" Adornment="Adornment.Start" 
                             AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Tên học kỳ</MudTh>
                <MudTh>Năm học</MudTh>
                <MudTh>Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.SemesterId</MudTd>
                <MudTd DataLabel="Tên học kỳ">@context.SemesterName</MudTd>
                <MudTd DataLabel="Năm học">@context.AcademicYearName</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                  OnClick="@(() => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                  OnClick="@(() => OpenDeleteDialog(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" />
            </PagerContent>
        </MudTable>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public List<SemesterDto> Semesters { get; set; } = new();
    
    [Parameter]
    public List<AcademicYearDto> AcademicYears { get; set; } = new();
    
    [Parameter]
    public EventCallback OnSemesterUpdated { get; set; }
    
    private SemesterDto selectedItem = null;
    private string searchString = "";
    
    private bool FilterFunc(SemesterDto semester) => 
        string.IsNullOrWhiteSpace(searchString) || 
        semester.SemesterName.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
        semester.AcademicYearName.Contains(searchString, StringComparison.OrdinalIgnoreCase);
    
    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            { "Title", "Thêm học kỳ mới" },
            { "ButtonText", "Thêm" },
            { "Color", Color.Primary },
            { "AcademicYears", AcademicYears }
        };
        
        var dialog = await DialogService.ShowAsync<SemesterDialog>("Thêm học kỳ", parameters);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        {
            var newSemester = (SemesterCreateDto)result.Data;
            try
            {
                await SemesterService.CreateAsync(newSemester);
                await OnSemesterUpdated.InvokeAsync();
                Snackbar.Add("Thêm học kỳ thành công", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
            }
        }
    }
    
    private async Task OpenEditDialog(SemesterDto semester)
    {
        var parameters = new DialogParameters
        {
            { "Title", "Cập nhật học kỳ" },
            { "ButtonText", "Cập nhật" },
            { "Color", Color.Primary },
            { "AcademicYears", AcademicYears },
            { "Semester", new SemesterUpdateDto { 
                SemesterName = semester.SemesterName, 
                AcademicYearId = semester.AcademicYearId 
            } }
        };
        
        var dialog = await DialogService.ShowAsync<SemesterDialog>("Cập nhật học kỳ", parameters);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        {
            var updatedSemester = (SemesterUpdateDto)result.Data;
            try
            {
                await SemesterService.UpdateAsync(semester.SemesterId, updatedSemester);
                await OnSemesterUpdated.InvokeAsync();
                Snackbar.Add("Cập nhật học kỳ thành công", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
            }
        }
    }
    
    private async Task OpenDeleteDialog(SemesterDto semester)
    {
        var parameters = new DialogParameters
        {
            { "ContentText", $"Bạn có chắc chắn muốn xóa học kỳ '{semester.SemesterName}'?" },
            { "ButtonText", "Xóa" },
            { "Color", Color.Error }
        };
        
        var options = new DialogOptions { CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Xác nhận xóa", parameters, options);
        var result = await dialog.Result;
        
        if (!result.Canceled)
        {
            try
            {
                await SemesterService.DeleteAsync(semester.SemesterId);
                await OnSemesterUpdated.InvokeAsync();
                Snackbar.Add("Xóa học kỳ thành công", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Lỗi: {ex.Message}", Severity.Error);
            }
        }
    }
}
