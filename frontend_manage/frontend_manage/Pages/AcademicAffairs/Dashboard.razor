@page "/academic-affairs/dashboard"
@using frontend_manage.DTOs.AcademicAffairs
@using frontend_manage.DTOs
@using frontend_manage.Pages.AcademicAffairs.Components
@using MudBlazor

<PageTitle>Academic Affairs Dashboard - HUTECH Exam Suite</PageTitle>

<link href="css/monitor/MonitorPage.css" rel="stylesheet" />
<link href="css/admin/admin-dashboard.css" rel="stylesheet" />

<div class="monitor-page">
    <!-- Header -->
    <div class="monitor-header">
        <div class="header-left">
            <div class="logo-container">
                <img src="/images/logo-dai-hoc-hutech_012634748.png" alt="HUTECH" class="logo" />
            </div>
            <div class="header-titles">
                <h1>TRƯỜNG ĐẠI HỌC CÔNG NGHỆ THÀNH PHỐ HỒ CHÍ MINH (HUTECH)</h1>
                <div class="subtitle">
                    EXAM SUITE - ACADEMIC AFFAIRS <span class="edition-tag">Professional Edition</span>
                </div>
                <div class="header-description">Quản lý học vụ</div>
            </div>
        </div>
        <div class="header-right">
            <span class="mode-tag">Academic Affairs</span>
            <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Logout" OnClick="Logout" Style="margin-left: 16px;">
                Đăng xuất
            </MudButton>
        </div>
        </div>

    <!-- Navigation -->
    <div class="monitor-nav">
        <div class="nav-item active">
            <span>QUẢN LÝ HỌC VỤ</span>
        </div>
    </div>

    <!-- Content Area -->
    <div class="monitor-content">
        <div class="tab-content-active">
        <!-- Main Tabs -->
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" Class="mt-4">
            <!-- Quản lý cấu trúc học vụ -->
            <MudTabPanel Text="Cấu trúc học vụ">
                <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3">
            <MudTabPanel Text="Năm học">
                <AcademicYearTab AcademicYears="_academicYears" OnAcademicYearUpdated="RefreshData" />
            </MudTabPanel>
            <MudTabPanel Text="Học kỳ">
                <SemesterTab Semesters="_semesters" AcademicYears="_academicYears" OnSemesterUpdated="RefreshData" />
            </MudTabPanel>
                </MudTabs>
            </MudTabPanel>

            <!-- Quản lý tổ chức thi -->
            <MudTabPanel Text="Tổ chức thi">
                <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3">
            <MudTabPanel Text="Đợt thi">
                <ExamBatchTab ExamBatches="_examBatches" Semesters="_semesters" OnExamBatchUpdated="RefreshData" />
            </MudTabPanel>
            <MudTabPanel Text="Chi tiết đợt thi">
                        <ExamBatchDetailTab ExamBatchDetails="_examBatchDetails" ExamBatches="_examBatches" OnExamBatchDetailUpdated="RefreshData" />
            </MudTabPanel>
            <MudTabPanel Text="Ca thi">
                <ExamSessionTab ExamSessions="@_examSessions" ExamBatches="_examBatches" OnExamSessionUpdated="RefreshData" />
            </MudTabPanel>
                    <MudTabPanel Text="Ca thi môn học">
                        <ExamSessionSubjectTab ExamSessionSubjects="_examSessionSubjects" OnExamSessionSubjectUpdated="RefreshData" />
            </MudTabPanel>
                </MudTabs>
            </MudTabPanel>
        </MudTabs>
        </div>
    </div>

    <!-- Footer -->
    <div class="monitor-footer">
        <div class="footer-left">
            <span class="footer-time">--:--</span>
            <span class="footer-date">--/--/----</span>
        </div>
        <div class="footer-center">
            <div class="footer-logo">
                <span class="footer-brand">HUTECH</span>
                <span class="footer-divider">|</span>
                <span>Academic Affairs</span>
            </div>
            <div class="footer-copyright">© 2025 Trường Đại học Công nghệ TP.HCM. All rights reserved.</div>
        </div>
        <div class="footer-right">
            <span class="footer-version">Version 1.0.1</span>
            <span class="footer-divider">|</span>
            <span class="footer-developers">Developed by Natwodev & Juo</span>
                        </div>
                        </div>

    <!-- Loading Indicator -->
    @if (_loading)
    {
        <div class="d-flex justify-center align-center" style="height: 100vh; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(255,255,255,0.7); z-index: 9999;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
</div>
