@page "/academic-affairs/dashboard"
@page "/academic-affairs/dashboard/{Tab:int}"
@using Microsoft.AspNetCore.Components
@using frontend_manage.Services.AcademicAffairs
@using frontend_manage.DTOs.AcademicAffairs
@using frontend_manage.Pages.AcademicAffairs.Components
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@inherits ComponentBase
@implements IDisposable

<link href="css/academic-affairs/Dashboard.css" rel="stylesheet" />

<div class="academic-dashboard">
    <!-- Header -->
    <div class="dashboard-header">
        <div class="header-left">
            <div class="logo-container">
                <img src="/images/logo-dai-hoc-hutech_012634748.png" alt="HUTECH" class="logo" />
            </div>
            <div class="header-titles">
                <h1>TRƯỜNG ĐẠI HỌC CÔNG NGHỆ THÀNH PHỐ HỒ CHÍ MINH (HUTECH)</h1>
                <div class="subtitle">
                    EXAM SUITE - ACADEMIC AFFAIRS <span class="edition-tag">Professional Edition</span>
                </div>
                <div class="header-description">Hệ thống quản lý học vụ và ca thi</div>
            </div>
        </div>
        <div class="header-right">
            <span class="mode-tag">Academic Affairs (Management Mode)</span>
            
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Inherit" OnClick="GoBackToMain" Title="Quay lại trang chủ" />
            <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" />
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
            <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" Title="Đăng xuất" />
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="dashboard-nav">
        <div class="nav-item @(activeTab == 0 ? "active" : "")" @onclick="() => ActivateTab(0)">
            <MudIcon Icon="@Icons.Material.Filled.Schedule" />
            <span>CA THI</span>
        </div>
        <div class="nav-item @(activeTab == 1 ? "active" : "")" @onclick="() => ActivateTab(1)">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" />
            <span>ĐỢT THI</span>
        </div>
        <div class="nav-item @(activeTab == 2 ? "active" : "")" @onclick="() => ActivateTab(2)">
            <MudIcon Icon="@Icons.Material.Filled.School" />
            <span>MÔN THI</span>
        </div>
        <div class="nav-item @(activeTab == 3 ? "active" : "")" @onclick="() => ActivateTab(3)">
            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" />
            <span>NĂM HỌC</span>
        </div>
    </div>

    <!-- Content Area -->
    <div class="dashboard-content">
        @if (isLoading)
        {
            <div class="@(activeTab == 0 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 0 || previousTab == 0)
                {
                    <div class="loading-container">
                        <div class="loading-spinner"></div>
                        <div class="loading-text">Đang tải dữ liệu ca thi...</div>
                    </div>
                }
            </div>
            <div class="@(activeTab == 1 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 1 || previousTab == 1)
                {
                    <div class="loading-container">
                        <div class="loading-spinner"></div>
                        <div class="loading-text">Đang tải dữ liệu đợt thi...</div>
                    </div>
                }
            </div>
            <div class="@(activeTab == 2 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 2 || previousTab == 2)
                {
                    <div class="loading-container">
                        <div class="loading-spinner"></div>
                        <div class="loading-text">Đang tải dữ liệu môn thi...</div>
                    </div>
                }
            </div>
            <div class="@(activeTab == 3 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 3 || previousTab == 3)
                {
                    <div class="loading-container">
                        <div class="loading-spinner"></div>
                        <div class="loading-text">Đang tải dữ liệu năm học...</div>
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="@(activeTab == 0 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 0 || previousTab == 0)
                {
                    <div class="error-container">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                            @errorMessage
                        </MudAlert>
                    </div>
                }
            </div>
            <div class="@(activeTab == 1 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 1 || previousTab == 1)
                {
                    <div class="error-container">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                            @errorMessage
                        </MudAlert>
                    </div>
                }
            </div>
            <div class="@(activeTab == 2 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 2 || previousTab == 2)
                {
                    <div class="error-container">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                            @errorMessage
                        </MudAlert>
                    </div>
                }
            </div>
            <div class="@(activeTab == 3 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 3 || previousTab == 3)
                {
                    <div class="error-container">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                            @errorMessage
                        </MudAlert>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="@(activeTab == 0 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 0 || previousTab == 0)
                {
                    <ExamSessionsTab ExamSessions="@examSessions" OnRefresh="LoadExamSessions" />
                }
            </div>
            <div class="@(activeTab == 1 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 1 || previousTab == 1)
                {
                    <ExamBatchesTab ExamBatches="@examBatches" OnRefresh="LoadExamBatches" />
                }
            </div>
            <div class="@(activeTab == 2 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 2 || previousTab == 2)
                {
                    <ExamSessionSubjectsTab ExamSessionSubjects="@examSessionSubjects" OnRefresh="LoadExamSessionSubjects" />
                }
            </div>
            <div class="@(activeTab == 3 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 3 || previousTab == 3)
                {
                    <AcademicYearsTab AcademicYears="@academicYears" OnRefresh="LoadAcademicYears" />
                }
            </div>
        }
    </div>

    <!-- Footer -->
    <div class="dashboard-footer">
        <div class="footer-left">
            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="footer-icon" />
            <span class="footer-time">@currentTime</span>
            <span class="footer-date">@currentDate</span>
        </div>
        <div class="footer-center">
            <div class="footer-logo">
                <span class="footer-brand">HUTECH</span>
                <span class="footer-divider">|</span>
                <span>Academic Affairs Management System</span>
            </div>
            <div class="footer-copyright">© 2025 Trường Đại học Công nghệ TP.HCM. All rights reserved.</div>
        </div>
        <div class="footer-right">
            <span class="footer-version">Version 1.0.1</span>
            <span class="footer-divider">|</span>
            <span class="footer-developers">Developed by Natwodev & Juo</span>
            <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" Class="footer-icon ms-1" />
        </div>
    </div>
</div>

@* Code is now in Dashboard.razor.cs *@
