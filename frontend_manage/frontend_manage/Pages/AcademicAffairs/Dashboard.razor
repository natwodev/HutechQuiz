@page "/academicaffairs/dashboard"
@using frontend_manage.DTOs.AcademicAffairs
@using frontend_manage.Services.AcademicAffairs
@using frontend_manage.Pages.AcademicAffairs.Components

<PageTitle>Quản lý Phòng đào tạo</PageTitle>

<link href="~/css/academic-affairs.css" rel="stylesheet" />

<MudContainer MaxWidth="MaxWidth.False" Class="pa-0 dashboard-container">
    <!-- Header Section - Monitor Style -->
    <div class="dashboard-header">
        <div class="header-left">
            <div class="logo-container">
                <img src="/images/logo-dai-hoc-hutech_012634748.png" alt="HUTECH" class="logo" />
            </div>
            <div class="header-titles">
                <h1 class="dashboard-title">TRƯỜNG ĐẠI HỌC CÔNG NGHỆ THÀNH PHỐ HỒ CHÍ MINH (HUTECH)</h1>
                <div class="dashboard-subtitle">
                    ACADEMIC AFFAIRS MANAGEMENT <span class="edition-tag">Professional Edition</span>
                </div>
                <div class="header-description">Hệ thống quản lý thi cử và đào tạo</div>
            </div>
        </div>
        <div class="header-right">
            <span class="mode-tag">Academic Affairs (Management Mode)</span>
            <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" />
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
            <MudButton Color="Color.Error" Variant="Variant.Filled" 
                      Class="action-button"
                      OnClick="Logout">
                <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                Đăng xuất
            </MudButton>
        </div>
    </div>


    <!-- Main Tabs -->
    <div class="dashboard-tabs fade-in-up">
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pa-4" Style="background: transparent;">
            <MudTabPanel Text="Năm học">
                <AcademicYearTab AcademicYears="_academicYears" OnAcademicYearUpdated="RefreshData" />
            </MudTabPanel>
            <MudTabPanel Text="Học kỳ">
                <SemesterTab Semesters="_semesters" AcademicYears="_academicYears" OnSemesterUpdated="RefreshData" />
            </MudTabPanel>
            <MudTabPanel Text="Đợt thi">
                <ExamBatchTab ExamBatches="_examBatches" Semesters="_semesters" OnExamBatchUpdated="RefreshData" />
            </MudTabPanel>
            <MudTabPanel Text="Chi tiết đợt thi">
                <MudCard Elevation="0" Style="background: transparent; border: none; height: 100%; display: flex; flex-direction: column;">
                    <MudCardHeader Style="background: transparent; border-bottom: 1px solid rgba(38, 68, 136, 0.2); flex-shrink: 0;">
                        <MudText Typo="Typo.h6" Style="color: var(--primary-color); font-weight: 600;">Quản lý Chi tiết đợt thi</MudText>
                        <MudSpacer />
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" 
                                  Class="action-button" StartIcon="@Icons.Material.Filled.Add" 
                                  OnClick="OpenCreateExamBatchDetailDialog">Thêm chi tiết đợt thi</MudButton>
                    </MudCardHeader>
                    <MudCardContent Style="background: transparent; flex: 1; overflow: hidden; padding: 0;">
                        <MudTable Items="@_examBatchDetails" Hover="true" Dense="false" Striped="true" 
                                  Style="background: var(--glass-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: 16px; overflow: hidden; height: 100%;">
                            <HeaderContent>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">ID</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Tên chi tiết</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Đợt thi</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Thao tác</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="ID" Style="color: var(--text-primary);">@context.ExamBatchDetailId</MudTd>
                                <MudTd DataLabel="Tên chi tiết" Style="color: var(--text-primary);">@context.Name</MudTd>
                                <MudTd DataLabel="Đợt thi" Style="color: var(--text-primary);">@context.ExamBatchName</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                                OnClick="@(() => EditExamBatchDetail(context))" 
                                                Style="background: var(--primary-color); color: white; border-radius: 8px; margin-right: 8px;" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                                OnClick="@(() => DeleteExamBatchDetail(context))" 
                                                Style="background: #ea4335; color: white; border-radius: 8px;" />
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" Style="background: rgba(38, 68, 136, 0.1); color: var(--text-primary);" />
                            </PagerContent>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>
            <MudTabPanel Text="Ca thi">
                <ExamSessionTab ExamSessions="@_examSessions" ExamBatches="_examBatches" OnExamSessionUpdated="RefreshData" />
            </MudTabPanel>
            <MudTabPanel Text="Khoa tham gia ca thi">
                <MudCard Elevation="0" Style="background: transparent; border: none; height: 100%; display: flex; flex-direction: column;">
                    <MudCardHeader Style="background: transparent; border-bottom: 1px solid rgba(38, 68, 136, 0.2); flex-shrink: 0;">
                        <MudText Typo="Typo.h6" Style="color: var(--primary-color); font-weight: 600;">Quản lý Khoa tham gia ca thi</MudText>
                        <MudSpacer />
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" 
                                  Class="action-button" StartIcon="@Icons.Material.Filled.Add" 
                                  OnClick="OpenCreateExamSessionDepartmentDialog">Thêm khoa tham gia ca thi</MudButton>
                    </MudCardHeader>
                    <MudCardContent Style="background: transparent; flex: 1; overflow: hidden; padding: 0;">
                        <MudTable Items="@_examSessionDepartments" Hover="true" Dense="false" Striped="true" 
                                  Style="background: var(--glass-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: 16px; overflow: hidden; height: 100%;">
                            <HeaderContent>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">ID</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Ca thi</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Khoa</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Thao tác</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="ID" Style="color: var(--text-primary);">@context.ExamSessionDepartmentId</MudTd>
                                <MudTd DataLabel="Ca thi" Style="color: var(--text-primary);">@context.ExamSessionName</MudTd>
                                <MudTd DataLabel="Khoa" Style="color: var(--text-primary);">@context.DepartmentName</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                                OnClick="@(() => EditExamSessionDepartment(context))" 
                                                Style="background: var(--primary-color); color: white; border-radius: 8px; margin-right: 8px;" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                                OnClick="@(() => DeleteExamSessionDepartment(context))" 
                                                Style="background: #ea4335; color: white; border-radius: 8px;" />
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" Style="background: rgba(38, 68, 136, 0.1); color: var(--text-primary);" />
                            </PagerContent>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>
            <MudTabPanel Text="Ca thi môn học">
                <MudCard Elevation="0" Style="background: transparent; border: none; height: 100%; display: flex; flex-direction: column;">
                    <MudCardHeader Style="background: transparent; border-bottom: 1px solid rgba(38, 68, 136, 0.2); flex-shrink: 0;">
                        <MudText Typo="Typo.h6" Style="color: var(--primary-color); font-weight: 600;">Quản lý Ca thi môn học</MudText>
                        <MudSpacer />
                        <MudButton Color="Color.Primary" Variant="Variant.Filled" 
                                  Class="action-button" StartIcon="@Icons.Material.Filled.Add" 
                                  OnClick="OpenCreateExamSessionSubjectDialog">Thêm ca thi môn học</MudButton>
                    </MudCardHeader>
                    <MudCardContent Style="background: transparent; flex: 1; overflow: hidden; padding: 0;">
                        <MudTable Items="@_examSessionSubjects" Hover="true" Dense="false" Striped="true" 
                                  Style="background: var(--glass-bg); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: 16px; overflow: hidden; height: 100%;">
                            <HeaderContent>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">ID</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Ca thi - Khoa</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Môn học</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Thời lượng</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Đề gốc</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Trạng thái</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Mã ca thi</MudTh>
                                <MudTh Style="color: var(--primary-color); font-weight: 600; background: rgba(38, 68, 136, 0.1);">Thao tác</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="ID" Style="color: var(--text-primary);">@context.ExamSessionSubjectId</MudTd>
                                <MudTd DataLabel="Ca thi - Khoa" Style="color: var(--text-primary);">@context.ExamSessionId</MudTd>
                                <MudTd DataLabel="Môn học" Style="color: var(--text-primary);">@context.SubjectName</MudTd>
                                <MudTd DataLabel="Thời lượng" Style="color: var(--text-primary);">@context.Duration phút</MudTd>
                                <MudTd DataLabel="Đề gốc" Style="color: var(--text-primary);">@(context.OriginalExamPaperTitle ?? "Chưa có đề")</MudTd>
                                <MudTd DataLabel="Trạng thái">
                                    <MudChip T="bool" Color="@(context.IsCompleted ? Color.Success : Color.Warning)" Size="Size.Small">
                                        @(context.IsCompleted ? "Đã hoàn thành" : "Chưa hoàn thành")
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Mã ca thi" Style="color: var(--text-primary);">@context.ExamSessionSubjectCore</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                                OnClick="@(() => EditExamSessionSubject(context))" 
                                                Style="background: var(--primary-color); color: white; border-radius: 8px; margin-right: 8px;" />
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small">
                                        <MudMenuItem OnClick="@(() => UpdateOriginalExamPaper(context))">Cập nhật đề thi</MudMenuItem>
                                    </MudMenu>
                                </MudTd>
                            </RowTemplate>
                            <PagerContent>
                                <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" Style="background: rgba(38, 68, 136, 0.1); color: var(--text-primary);" />
                            </PagerContent>
                        </MudTable>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>
        </MudTabs>
    </div>


    <!-- Footer - Monitor Style -->
    <div class="dashboard-footer">
        <div class="footer-left">
            <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="footer-icon" />
            <span class="footer-time">@DateTime.Now.ToString("HH:mm:ss")</span>
            <span class="footer-date">@DateTime.Now.ToString("dd/MM/yyyy")</span>
        </div>
        <div class="footer-center">
            <div class="footer-logo">
                <span class="footer-brand">HUTECH</span>
                <span class="footer-divider">|</span>
                <span>Academic Affairs Management System</span>
            </div>
            <div class="footer-copyright">© 2025 Trường Đại học Công nghệ TP.HCM. All rights reserved.</div>
        </div>
        <div class="footer-right">
            <span class="footer-version">Version 1.0.1</span>
            <span class="footer-divider">|</span>
            <span class="footer-developers">Developed by Natwodev & Juo</span>
            <MudIcon Icon="@Icons.Custom.Brands.GitHub" Size="Size.Small" Class="footer-icon ms-1" />
        </div>
    </div>

    <!-- Loading Indicator -->
    @if (_loading)
    {
        <div class="loading-overlay d-flex justify-center align-center" style="height: 100vh; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999;">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
        </div>
    }
</MudContainer>
