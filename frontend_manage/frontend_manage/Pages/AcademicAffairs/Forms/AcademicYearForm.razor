@page "/academic-affairs/forms/academic-year-form"
@page "/academic-affairs/forms/academic-year-form/{Id:int}"
@using MudBlazor
@using frontend_manage.DTOs.AcademicAffairs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudPaper Class="pa-6">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h4" Class="mb-4">
                @(IsEdit ? "Chỉnh sửa năm học" : "Tạo năm học mới")
            </MudText>

            <EditForm Model="AcademicYear" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="AcademicYear.YearName"
                                  Label="Tên năm học"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Vui lòng nhập tên năm học" />
                </MudStack>

                <MudStack Spacing="2" Class="mt-4" Justify="Justify.FlexEnd" Direction="Direction.Row">
                    <MudButton Variant="Variant.Text" OnClick="Cancel">
                        Hủy
                    </MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="isLoading">
                        @(isLoading ? "Đang xử lý..." : (IsEdit ? "Cập nhật" : "Tạo mới"))
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudStack>
    </MudPaper>
</MudContainer>
