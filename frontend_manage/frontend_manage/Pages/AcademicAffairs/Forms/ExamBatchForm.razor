@page "/academic-affairs/forms/exam-batch-form"
@page "/academic-affairs/forms/exam-batch-form/{Id:int}"
@using MudBlazor
@using frontend_manage.DTOs.AcademicAffairs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudPaper Class="pa-6">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h4" Class="mb-4">
                @(IsEdit ? "Chỉnh sửa đợt thi" : "Tạo đợt thi mới")
            </MudText>

            <EditForm Model="ExamBatch" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="ExamBatch.BatchName"
                                  Label="Tên đợt thi"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Vui lòng nhập tên đợt thi" />

                    <MudTextField @bind-Value="ExamBatch.Description"
                                  Label="Mô tả"
                                  Variant="Variant.Outlined"
                                  Lines="3" />

                    <MudDatePicker @bind-Date="StartDate"
                                   Label="Ngày bắt đầu"
                                   Variant="Variant.Outlined"
                                   Required="true" />

                    <MudDatePicker @bind-Date="EndDate"
                                   Label="Ngày kết thúc"
                                   Variant="Variant.Outlined"
                                   Required="true" />

                    <MudTextField @bind-Value="ExamBatch.SemesterName"
                                  Label="Học kỳ"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Vui lòng nhập học kỳ" />

                    <MudSwitch T="bool" @bind-Checked="ExamBatch.IsActive"
                               Label="Kích hoạt đợt thi"
                               Color="Color.Primary" />
                </MudStack>

                <MudStack Spacing="2" Class="mt-4" Justify="Justify.FlexEnd" Direction="Direction.Row">
                    <MudButton Variant="Variant.Text" OnClick="Cancel">
                        Hủy
                    </MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="isLoading">
                        @(isLoading ? "Đang xử lý..." : (IsEdit ? "Cập nhật" : "Tạo mới"))
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudStack>
    </MudPaper>
</MudContainer>
