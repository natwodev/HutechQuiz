@page "/academic-affairs/forms/exam-session-subject-form"
@page "/academic-affairs/forms/exam-session-subject-form/{Id:int}"
@using MudBlazor
@using frontend_manage.DTOs.AcademicAffairs
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-4">
    <MudPaper Class="pa-6">
        <MudStack Spacing="4">
            <MudText Typo="Typo.h4" Class="mb-4">
                @(IsEdit ? "Chỉnh sửa môn thi" : "Tạo môn thi mới")
            </MudText>

            <EditForm Model="ExamSessionSubject" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="ExamSessionSubject.SubjectName"
                                  Label="Tên môn thi"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  RequiredError="Vui lòng nhập tên môn thi" />

                    <MudNumericField @bind-Value="ExamSessionSubject.Duration"
                                     Label="Thời gian thi (phút)"
                                     Variant="Variant.Outlined"
                                     Required="true"
                                     Min="1"
                                     Max="300" />

                    <MudDatePicker @bind-Date="StartDate"
                                   Label="Ngày bắt đầu"
                                   Variant="Variant.Outlined"
                                   Required="true" />

                    <MudTimePicker @bind-Time="StartTimeSpan"
                                   Label="Giờ bắt đầu"
                                   Variant="Variant.Outlined"
                                   Required="true" />

                    <MudTextField @bind-Value="ExamSessionSubject.RoomName"
                                  Label="Phòng thi"
                                  Variant="Variant.Outlined" />

                    <MudTextField @bind-Value="ExamSessionSubject.MonitorName"
                                  Label="Giám thị"
                                  Variant="Variant.Outlined" />

                    <MudSwitch T="bool" @bind-Checked="ExamSessionSubject.IsCompleted"
                               Label="Đã hoàn thành"
                               Color="Color.Success" />
                </MudStack>

                <MudStack Spacing="2" Class="mt-4" Justify="Justify.FlexEnd" Direction="Direction.Row">
                    <MudButton Variant="Variant.Text" OnClick="Cancel">
                        Hủy
                    </MudButton>
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" Disabled="isLoading">
                        @(isLoading ? "Đang xử lý..." : (IsEdit ? "Cập nhật" : "Tạo mới"))
                    </MudButton>
                </MudStack>
            </EditForm>
        </MudStack>
    </MudPaper>
</MudContainer>
