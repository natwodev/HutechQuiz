@using frontend_manage.DTOs.AcademicAffairs

<MudCard Elevation="0">
    <MudCardHeader>
        <MudText Typo="Typo.h6" Style="font-size: 1.1rem; font-weight: 600;">Quản lý Ca thi môn học</MudText>
    </MudCardHeader>
    <MudCardContent>
        <MudTable Items="@ExamSessionSubjects" Hover="true" Dense="true" Striped="true" Filter="new Func<ExamSessionSubjectDto, bool>(FilterFunc)">
            <ToolBarContent>
                <MudTextField @bind-Value="searchString" Placeholder="Tìm kiếm" Adornment="Adornment.Start" 
                             AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>ID</MudTh>
                <MudTh>Ca thi - Khoa</MudTh>
                <MudTh>Môn học</MudTh>
                <MudTh>Thời lượng</MudTh>
                <MudTh>Đề gốc</MudTh>
                <MudTh>Trạng thái</MudTh>
                <MudTh>Mã ca thi</MudTh>
                <MudTh>Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="ID">@context.ExamSessionSubjectId</MudTd>
                <MudTd DataLabel="Ca thi - Khoa">@context.ExamSessionDepartmentId</MudTd>
                <MudTd DataLabel="Môn học">@context.SubjectName</MudTd>
                <MudTd DataLabel="Thời lượng">@context.Duration phút</MudTd>
                <MudTd DataLabel="Đề gốc">@(context.OriginalExamPaperTitle ?? "Chưa có đề")</MudTd>
                <MudTd DataLabel="Trạng thái">
                    <div style="display: inline-block; padding: 4px 10px; background-color: @(context.IsCompleted ? "#4caf50" : "#ff9800"); color: white; border-radius: 12px; font-size: 0.75rem; font-weight: 500;">
                        @(context.IsCompleted ? "Đã hoàn thành" : "Chưa hoàn thành")
                    </div>
                </MudTd>
                <MudTd DataLabel="Mã ca thi">@context.ExamSessionSubjectCore</MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" 
                                  OnClick="@(() => EditExamSessionSubject(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 25, 50 }" />
            </PagerContent>
        </MudTable>
    </MudCardContent>
</MudCard>

