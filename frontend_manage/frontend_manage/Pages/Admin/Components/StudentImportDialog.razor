@using Microsoft.AspNetCore.Components.Forms

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="examSessionSubjectCore" 
                         Label="Mã ca thi môn học" 
                         Variant="Variant.Outlined" 
                         Required="true"
                         RequiredError="Mã ca thi môn học không được để trống"
                         HelperText="Nhập mã ca thi môn học (ExamSessionSubjectCore)" />
            
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <InputFile OnChange="OnInputFileChange" accept=".xlsx,.xls" />
                @if (selectedFile != null)
                {
                    <div style="display: flex; align-items: center; gap: 8px; padding: 4px 12px; background-color: #4caf50; color: white; border-radius: 16px;">
                        <span>@selectedFile.Name</span>
                        <button type="button" @onclick="ClearFile" style="background: none; border: none; color: white; cursor: pointer; padding: 0 4px; font-size: 18px; line-height: 1;">&times;</button>
                    </div>
                }
            </MudStack>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Hủy</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="HandleImport" Disabled="@(selectedFile == null || string.IsNullOrEmpty(examSessionSubjectCore))">
            Import
        </MudButton>
    </DialogActions>
</MudDialog>

