@page "/dashboard"
@using frontend_manage.DTOs
@using frontend_manage.Services
@using frontend_manage.Pages.Admin
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject Api AdminApi

<PageTitle>Dashboard Admin</PageTitle>

<!-- Header -->
<div class="bg-primary text-white p-3 mb-4 rounded shadow-sm d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-0">Trang quản trị</h2>
        <small>Chào mừng bạn đến với hệ thống quản lý thi</small>
    </div>
</div>

<!-- Nội dung chính -->
<div class="container-fluid">
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Danh sách phòng thi của các môn học</h5>
        </div>
        <div class="card-body">
            <!-- Loading -->
            <div class="text-center text-secondary" hidden="@(!isLoading)">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2">Đang tải dữ liệu...</p>
            </div>

            <!-- Lỗi -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }

            <!-- Không có dữ liệu -->
            @if (!isLoading && (examRooms == null || !examRooms.Any()))
            {
                <div class="alert alert-warning">Không có phòng thi nào.</div>
            }

            <!-- Bảng dữ liệu -->
            @if (!isLoading && examRooms != null && examRooms.Any())
            {
                <table class="table table-striped table-bordered">
                    <thead class="table-light">
                        <tr>
                            <th>Môn học</th>
                            <th>Phòng thi</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var room in examRooms)
                        {
                            <tr>
                                <td>@room.SubjectName</td>
                                <td>@room.RoomName</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary"
                                            @onclick="() => GoToExamRoom(room.ExamRoomId, room.ExamSessionSubjectId)">
                                        Xem phòng thi
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
    private bool isAdmin;
    private bool isAdminChecked = false;
    private bool isLoading = false;
    private List<ExamSessionSubjectRoomDto>? examRooms;
    private string? errorMessage;
    private List<StudentExamRoomStatusDto>? studentsInRoom;
    private bool isLoadingStudents = false;
    private string? errorStudentMessage;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            // Check if authenticated first
            var isAuthenticated = await AuthService.IsAuthenticated();
            if (!isAuthenticated)
            {
                Navigation.NavigateTo("/login");
                return;
            }
            
            // Check if is admin
            isAdmin = await AuthService.IsAdmin();
            isAdminChecked = true;
            if (!isAdmin)
            {
                Navigation.NavigateTo("/");
                return;
            }
            
            // Load data
            isLoading = true;
            errorMessage = null;
            try
            {
                examRooms = await AdminApi.GetExamSessionSubjectsWithRoomsAsync();
            }
            catch (Exception ex)
            {
                // Check if the error is due to authentication
                if (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized"))
                {
                    Navigation.NavigateTo("/login");
                    return;
                }
                
                errorMessage = ex.Message;
                examRooms = null;
            }
            finally
            {
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi không xác định: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task GoToExamRoom(int examRoomId, int examSessionSubjectId)
    {
        Navigation.NavigateTo($"/exam-room-students?examRoomId={examRoomId}&examSessionSubjectId={examSessionSubjectId}");
    }
} 