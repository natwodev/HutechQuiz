
@page "/login"
@using frontend_manage.DTOs
@using frontend_manage.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Đăng nhập</PageTitle>

<div class="login-grid">
    <div class="login-video-col">
        <video autoplay loop muted playsinline class="video-background">
            <source src="/images/login/login-video.mp4" type="video/mp4">
            Trình duyệt của bạn không hỗ trợ video.
        </video>
    </div>
    <div class="login-form-col">
        <div class="login-content">
            <h3>Đăng nhập</h3>
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger">@ErrorMessage</div>
            }
            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label for="username" class="form-label">Tên đăng nhập</label>
                    <InputText id="username" class="form-control" @bind-Value="loginModel.UserName" />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Mật khẩu</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
                </div>
                <button type="submit" class="btn btn-primary">Đăng nhập</button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginModelDto loginModel = new();
    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Check if already authenticated
            var isAuth = await AuthService.IsAuthenticated();
            if (isAuth)
            {
                await NavigateBasedOnRole();
                return;
            }
            
            // Kiểm tra xem đã đăng nhập bằng cookie chưa
            var authResult = await AuthService.CheckCookieAuth();
            if (authResult.IsSuccess)
            {
                await NavigateBasedOnRole();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Lỗi kiểm tra xác thực: {ex.Message}";
        }
    }

    private async Task HandleLogin()
    {
        try
        {
            ErrorMessage = null;
            
            // Sử dụng cookie login cho admin
            var result = await AuthService.LoginWithCookie(loginModel.UserName, loginModel.Password);
            if (result.IsSuccess)
            {
                // Check authentication state immediately after login
                var isAuth = await AuthService.IsAuthenticated();
                if (isAuth)
                {
                    await NavigateBasedOnRole();
                }
                else
                {
                    // Try with JWT login as fallback
                    var jwtResult = await AuthService.Login(loginModel.UserName, loginModel.Password);
                    if (jwtResult.IsSuccess)
                    {
                        await NavigateBasedOnRole();
                    }
                    else
                    {
                        ErrorMessage = jwtResult.ErrorMessage;
                    }
                }
            }
            else
            {
                ErrorMessage = result.ErrorMessage;
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Lỗi đăng nhập: {ex.Message}";
        }
    }

    private async Task NavigateBasedOnRole()
    {
        try
        {
            // Get the role from the token
            var role = await AuthService.GetUserRoleFromToken();
            Console.WriteLine($"[Login] NavigateBasedOnRole - User role: {role ?? "null"}");
            
            // Display the correct dashboard based on role
            if (role == "Admin")
            {
                // Force reload to ensure page gets fresh data with authentication
                Navigation.NavigateTo("/dashboard", forceLoad: true);
            }
            else if (role == "Lecturer")
            {
                Navigation.NavigateTo("/lecturer/dashboard", forceLoad: true);
            }
            else if (role == "AcademicAffairs")
            {
                Navigation.NavigateTo("/academicaffairs/dashboard", forceLoad: true);
            }
            else if (role == "ExamManager")
            {
                Navigation.NavigateTo("/exammanager/dashboard", forceLoad: true);
            }
            else if (role == "ITManager")
            {
                Navigation.NavigateTo("/itmanager/dashboard", forceLoad: true);
            }
            else
            {
                // Default route if role is unknown
                Console.WriteLine("[Login] NavigateBasedOnRole - Unknown role, navigating to root");
                Navigation.NavigateTo("/", forceLoad: true);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Login] NavigateBasedOnRole - Error: {ex.Message}");
            ErrorMessage = $"Lỗi chuyển trang: {ex.Message}";
        }
    }
} 