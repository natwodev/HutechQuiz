
@page "/login"
@using frontend_manage.DTOs
@using frontend_manage.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Đăng nhập</PageTitle>

<div class="login-grid">
    <div class="login-video-col">
        <video autoplay loop muted playsinline class="video-background">
            <source src="/images/login/login-video.mp4" type="video/mp4">
            Trình duyệt của bạn không hỗ trợ video.
        </video>
    </div>
    <div class="login-form-col">
        <div class="login-content">
            <h3>Đăng nhập</h3>
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger">@ErrorMessage</div>
            }
            <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-3">
                    <label for="username" class="form-label">Tên đăng nhập</label>
                    <InputText id="username" class="form-control" @bind-Value="loginModel.UserName" />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Mật khẩu</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
                </div>
                <button type="submit" class="btn btn-primary">Đăng nhập</button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginModelDto loginModel = new();
    private string? ErrorMessage;

    private async Task HandleLogin()
    {
        ErrorMessage = null;
        var result = await AuthService.Login(loginModel.UserName, loginModel.Password);
        if (result.IsSuccess)
        {
            var role = await AuthService.GetUserRoleFromToken();
            if (role == "Admin")
            {
                Navigation.NavigateTo("/dashboard");
            }
            else if (role == "Lecturer")
            {
                Navigation.NavigateTo("/lecturer/dashboard");
            }
            else if (role == "AcademicAffairs")
            {
                Navigation.NavigateTo("/academicaffairs/dashboard");
            }
            else if (role == "ExamManager")
            {
                Navigation.NavigateTo("/exammanager/dashboard");
            }
            else if (role == "ITManager")
            {
                Navigation.NavigateTo("/itmanager/dashboard");
            }
            else
            {
                Navigation.NavigateTo("/");
            }
        }
        else
        {
            ErrorMessage = result.ErrorMessage;
        }
    }
} 