@page "/debug-auth"
@using frontend_manage.Services
@inject AuthService AuthService
@inject HttpClient HttpClient
@inject CookieHttpService CookieHttpService
@inject IJSRuntime JSRuntime

<PageTitle>Debug Authentication</PageTitle>

<MudContainer>
    <MudPaper Class="pa-4 ma-2">
        <MudText Typo="Typo.h4" GutterBottom="true">Debug Authentication</MudText>
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshData" Class="mb-4">
            Refresh Status
        </MudButton>
        
        <MudDivider Class="my-4" />
        
        <MudStack Spacing="3">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-2">Authentication Status</MudText>
                    <MudText>Is Authenticated: @isAuthenticated</MudText>
                    <MudText>Has Required Role: @hasRequiredRole</MudText>
                    <MudText>User Role: @userRole</MudText>
                </MudCardContent>
            </MudCard>

            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-2">Detailed Debug Info</MudText>
                    <MudText Typo="Typo.body2" Style="white-space: pre-line; font-family: monospace;">@debugInfo</MudText>
                </MudCardContent>
            </MudCard>

            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.h6" Class="mb-2">Test API Call</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="TestApiCall" Class="mb-2">
                        Test Academic Years API (HttpClient)
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="TestApiCallWithCookie" Class="mb-2">
                        Test Academic Years API (CookieHttpService)
                    </MudButton>
                    @if (!string.IsNullOrEmpty(apiTestResult))
                    {
                        <MudText Typo="Typo.body2" Style="white-space: pre-line; font-family: monospace;">@apiTestResult</MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private bool isAuthenticated = false;
    private bool hasRequiredRole = false;
    private string userRole = "";
    private string debugInfo = "";
    private string apiTestResult = "";

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
    }

    private async Task RefreshData()
    {
        try
        {
            isAuthenticated = await AuthService.IsAuthenticated();
            hasRequiredRole = await AuthService.HasRequiredRole();
            userRole = await AuthService.GetUserRoleFromToken() ?? "null";
            debugInfo = await AuthService.GetDebugInfo();
        }
        catch (Exception ex)
        {
            debugInfo = $"Error getting debug info: {ex.Message}";
        }
        
        StateHasChanged();
    }

    private async Task TestApiCall()
    {
        try
        {
            // Test với HttpClient đã config AuthHeaderHandler
            var response = await HttpClient.GetAsync("http://localhost:5163/api/AcademicYear");
            var content = await response.Content.ReadAsStringAsync();
            
            var contentPreview = content.Length > 200 ? content.Substring(0, 200) + "..." : content;
            var authHeader = HttpClient.DefaultRequestHeaders.Authorization?.ToString() ?? "None";
            
            apiTestResult = $"HttpClient API Test Result:\n" +
                           $"- Status Code: {response.StatusCode}\n" +
                           $"- Is Success: {response.IsSuccessStatusCode}\n" +
                           $"- Content Length: {content.Length}\n" +
                           $"- Content Preview: {contentPreview}\n" +
                           $"Request Headers:\n" +
                           $"- Authorization: {authHeader}";
        }
        catch (Exception ex)
        {
            apiTestResult = $"HttpClient Error: {ex.Message}";
        }
        
        StateHasChanged();
    }

    private async Task TestApiCallWithCookie()
    {
        try
        {
            // Test với CookieHttpService (sử dụng fetch với credentials)
            var result = await CookieHttpService.GetStringAsync("http://localhost:5163/api/AcademicYear");
            
            var contentPreview = result?.Length > 200 ? result.Substring(0, 200) + "..." : result ?? "No content";
            
            apiTestResult = $"CookieHttpService API Test Result:\n" +
                           $"- Success: {!string.IsNullOrEmpty(result)}\n" +
                           $"- Content Length: {result?.Length ?? 0}\n" +
                           $"- Content Preview: {contentPreview}";
        }
        catch (Exception ex)
        {
            apiTestResult = $"CookieHttpService Error: {ex.Message}";
        }
        
        StateHasChanged();
    }
}
