@using frontend_manage.DTOs

<label class="answer-option @(SelectedAnswerId==Answer.AnswerId? "selected" : string.Empty)">
    <input type="radio" name="@GroupName" checked="@(SelectedAnswerId==Answer.AnswerId)" @onchange="@(()=>OnSelect.InvokeAsync(Answer.AnswerId))" />
    <span class="indicator" aria-hidden="true"></span>
    <span class="answer-letter">@Letter.</span>
    <span class="katex-content answer-text">@((MarkupString)NormalizeContent(Answer.AnswerContent))</span>
</label>



