@using frontend_manage.DTOs
@using MudBlazor

<div class="exam-session-info">
    <MudExpansionPanels MultiExpansion="false" Class="exam-session-info-panels">
        <MudExpansionPanel Text="Thông tin ca thi" Icon="@Icons.Material.Filled.Info" IsExpanded="@_isExpanded">
            <MudList T="object" Dense="true" Class="mb-2">
                <MudListItem T="object">
                    <b>Mã SV:</b>&nbsp;@StudentSession?.StudentCode
                </MudListItem>
                <MudListItem T="object">
                    <b>Môn:</b>&nbsp;@StudentSession?.SubjectName
                </MudListItem>
                <MudListItem T="object">
                    <b>Mã đề:</b>&nbsp;@StudentSession?.ShuffledExamPaperId
                </MudListItem>
                @if (!string.IsNullOrWhiteSpace(StudentSession?.RoomName))
                {
                    <MudListItem T="object">
                        <b>Phòng:</b>&nbsp;@StudentSession.RoomName
                    </MudListItem>
                }
                <MudListItem T="object">
                    <b>Thời lượng:</b>&nbsp;@StudentSession?.Duration phút
                </MudListItem>
            </MudList>
        </MudExpansionPanel>
    </MudExpansionPanels>
</div>

@code {
    [Parameter] public StudentExamSessionCacheDto? StudentSession { get; set; }
    [Parameter] public bool AllowViewMaterialsShuffled { get; set; }
    [Parameter] public bool AllowViewMaterialsOriginal { get; set; }
    
    private bool _isExpanded = false; // Mặc định thu gọn để tiết kiệm không gian
}

