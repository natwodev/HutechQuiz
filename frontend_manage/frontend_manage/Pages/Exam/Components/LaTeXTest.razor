@using frontend_manage.Services
@inject IMathJaxService MathJaxService
@inject IJSRuntime JSRuntime

<MudPaper Class="pa-4 mb-4" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
    <MudText Typo="Typo.h6" GutterBottom="true">Test LaTeX Rendering</MudText>
    
    <MudText Typo="Typo.body1" GutterBottom="true">
        Inline formula: \(x^2 + y^2 = z^2\)
    </MudText>
    
    <MudText Typo="Typo.body1" GutterBottom="true">
        Display formula: \[E = mc^2\]
    </MudText>
    
    <MudText Typo="Typo.body1" GutterBottom="true">
        Dollar inline: $a + b = c$
    </MudText>
    
    <MudText Typo="Typo.body1" GutterBottom="true">
        Dollar display: $$\int_{-\infty}^{\infty} e^{-x^2} dx = \sqrt{\pi}$$
    </MudText>
    
    <MudText Typo="Typo.body1" GutterBottom="true">
        Complex formula: \[\frac{-b \pm \sqrt{b^2 - 4ac}}{2a}\]
    </MudText>
    
    <MudText Typo="Typo.body1" GutterBottom="true">
        Test question: Giải phương trình $x^2 - 5x + 6 = 0$
    </MudText>
    
    <MudText Typo="Typo.body1" GutterBottom="true">
        Đáp án A: $x = 2$ và $x = 3$
    </MudText>
    
    <MudText Typo="Typo.body1" GutterBottom="true">
        Đáp án B: $x = -2$ và $x = -3$
    </MudText>
</MudPaper>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Đợi một chút để DOM được render
            await Task.Delay(1000);
            
            // Gọi MathJax để render LaTeX
            try
            {
                await JSRuntime.InvokeVoidAsync("MathJax.typesetPromise");
                Console.WriteLine("LaTeX test: MathJax typeset completed");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"LaTeX test: Error typesetting MathJax: {ex.Message}");
            }
        }
    }
}
