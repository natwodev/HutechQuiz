@using frontend_manage.DTOs
@using MudBlazor
@using System.Text.RegularExpressions

<style>
    .option-circle {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 2px dashed #999;
        background-color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        font-weight: bold;
        font-size: 14px;
        position: relative;
        z-index: 2;
    }
    
    .option-circle:hover {
        border-color: #1976d2;
        background-color: #e3f2fd;
    }
    
    .option-circle.selected {
        border-color: #1976d2;
        background-color: #1976d2;
        color: white;
    }
    
    .option-circle.filled {
        border-color: #4caf50;
        background-color: #4caf50;
        color: white;
    }
    
    .category-item {
        position: relative;
        z-index: 2;
    }
    
    .connection-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }
    
    .connection-line {
        stroke: #f44336;
        stroke-width: 3;
        fill: none;
    }
    
    .connection-line:hover {
        stroke: #d32f2f;
        stroke-width: 4;
    }
    
    .matching-container {
        position: relative;
    }
</style>

<MudPaper Class="pa-4 mb-4" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
    <MudText Typo="Typo.h6" GutterBottom="true">Test LaTeX trong câu trả lời</MudText>
    
    <MudText Typo="Typo.body1" GutterBottom="true">
        <b>Câu hỏi: Giải phương trình $x^2 + 2x + 1 = 0$</b>
    </MudText>
    
    <MudRadioGroup T="int?" Class="mt-3" Value="@selectedAnswer" ValueChanged="@((value) => selectedAnswer = value ?? 0)">
        <MudPaper Class="pa-2 mb-2" Style="border: 1px solid #ddd; border-radius: 6px; background-color: #fafafa;">
            <MudRadio T="int?" Value="1">
                @((MarkupString)"A. $x = -1$")
            </MudRadio>
        </MudPaper>
        
        <MudPaper Class="pa-2 mb-2" Style="border: 1px solid #ddd; border-radius: 6px; background-color: #fafafa;">
            <MudRadio T="int?" Value="2">
                @((MarkupString)"B. $x = 1$")
            </MudRadio>
        </MudPaper>
        
        <MudPaper Class="pa-2 mb-2" Style="border: 1px solid #ddd; border-radius: 6px; background-color: #fafafa;">
            <MudRadio T="int?" Value="3">
                @((MarkupString)"C. $x = 0$")
            </MudRadio>
        </MudPaper>
        
        <MudPaper Class="pa-2 mb-2" Style="border: 1px solid #ddd; border-radius: 6px; background-color: #fafafa;">
            <MudRadio T="int?" Value="4">
                @((MarkupString)@"D. $$\int_0^1 x^2 dx = \frac{1}{3}$$")
            </MudRadio>
        </MudPaper>
    </MudRadioGroup>
</MudPaper>

<!-- Matching Question Component -->
<MudPaper Class="pa-4 mb-4" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
    <MudText Typo="Typo.h6" GutterBottom="true">Câu hỏi nối</MudText>
    
    <MudText Typo="Typo.body1" GutterBottom="true">
        <b>Câu hỏi: Nối các loại địa chỉ IP với ví dụ tương ứng</b>
    </MudText>
    
    <div class="matching-container">
        <MudGrid Class="mt-3">
            <MudItem xs="5" Class="pr-1">
                <MudText Typo="Typo.subtitle1" GutterBottom="true" Style="font-weight: bold;">Categories:</MudText>
                @foreach (var category in matchingCategories)
                {
                    <MudPaper Class="pa-3 mb-3 category-item" 
                              Style="@GetCategoryStyle(category.Id)" 
                              @onclick="@(() => SelectCategory(category.Id))"
                              data-category-id="@category.Id">
                        <MudStack Row Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Style="height: 100%;">
                            <MudText Style="margin-right: 15px; flex: 1;">@category.Text</MudText>
                            <MudChip T="string" Color="@GetCategoryColor(category.Id)" Size="Size.Small" Style="min-width: 30px; text-align: center;">
                                @category.Label
                            </MudChip>
                        </MudStack>
                    </MudPaper>
                }
            </MudItem>
            
            <MudItem xs="1">
                <!-- Khoảng cách giữa hai cột -->
            </MudItem>
            
            <MudItem xs="6" Class="pl-1">
                <MudText Typo="Typo.subtitle1" GutterBottom="true" Style="font-weight: bold; text-align: right;">Options:</MudText>
                @foreach (var option in matchingOptions)
                {
                    <MudPaper Class="pa-3 mb-3" Style="border: 1px solid #ddd; border-radius: 6px; background-color: #fafafa; min-height: 60px;">
                        <MudStack Row Justify="Justify.FlexStart" AlignItems="AlignItems.Center" Style="height: 100%;">
                            <div class="option-circle" 
                                 style="@GetOptionCircleStyle(option.Id)" 
                                 @onclick="@(async () => await SelectOption(option.Id))"
                                 data-option-id="@option.Id">
                                @GetOptionCircleContent(option.Id)
                            </div>
                            <MudText Style="margin-left: 15px;">@option.Text</MudText>
                        </MudStack>
                    </MudPaper>
                }
            </MudItem>
        </MudGrid>
        
        <!-- Connection Lines Overlay -->
        <div class="connection-overlay">
            <svg width="100%" height="100%" style="position: absolute; top: 0; left: 0;" id="connection-svg">
                @foreach (var option in matchingOptions.Where(o => !string.IsNullOrEmpty(o.SelectedCategory)))
                {
                    var categoryId = GetCategoryIdByLabel(option.SelectedCategory);
                    <path class="connection-line" 
                          d="@GetConnectionPath(categoryId, option.Id)" 
                          data-category-id="@categoryId"
                          data-option-id="@option.Id" />
                }
            </svg>
        </div>
    </div>
    
    <MudDivider Class="my-4" />
    
    <MudStack Row Justify="Justify.Center" Class="mt-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CheckMatchingAnswers">
            Kiểm tra kết quả
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ResetMatchingAnswers" Class="ml-2">
            Làm lại
        </MudButton>
    </MudStack>
    
    @if (!string.IsNullOrEmpty(matchingResult))
    {
        <MudAlert Severity="@GetAlertSeverity()" Class="mt-3">
            @matchingResult
        </MudAlert>
    }
</MudPaper>

@code {
    private int selectedAnswer = 0;
    
    // Matching question data
    private List<MatchingCategory> matchingCategories = new()
    {
        new MatchingCategory { Id = 1, Label = "A", Text = "a private address" },
        new MatchingCategory { Id = 2, Label = "B", Text = "a loopback address" },
        new MatchingCategory { Id = 3, Label = "C", Text = "an experimental address" },
        new MatchingCategory { Id = 4, Label = "D", Text = "a link-local address" }
    };
    
    private List<MatchingOption> matchingOptions = new()
    {
        new MatchingOption { Id = 1, Text = "172.19.20.5", CorrectAnswer = "A", SelectedCategory = "" },
        new MatchingOption { Id = 2, Text = "127.0.0.1", CorrectAnswer = "B", SelectedCategory = "" },
        new MatchingOption { Id = 3, Text = "169.254.1.5", CorrectAnswer = "D", SelectedCategory = "" },
        new MatchingOption { Id = 4, Text = "240.2.6.255", CorrectAnswer = "C", SelectedCategory = "" }
    };
    
    private string matchingResult = "";
    private bool isCorrectAnswer = false;
    private int? selectedCategoryId = null;
    private int? selectedOptionId = null;
    
    private Color GetCategoryColor(int categoryId)
    {
        return categoryId switch
        {
            1 => Color.Primary,
            2 => Color.Secondary,
            3 => Color.Tertiary,
            4 => Color.Info,
            _ => Color.Default
        };
    }
    
    private string GetCategoryStyle(int categoryId)
    {
        var baseStyle = "border: 1px solid #ddd; border-radius: 6px; background-color: #fafafa; min-height: 60px; cursor: pointer; transition: all 0.2s ease;";
        
        if (selectedCategoryId == categoryId)
        {
            return baseStyle + " border: 2px solid #1976d2; background-color: #e3f2fd; box-shadow: 0 2px 8px rgba(25, 118, 210, 0.3);";
        }
        
        return baseStyle;
    }
    
    private void SelectCategory(int categoryId)
    {
        selectedCategoryId = selectedCategoryId == categoryId ? null : categoryId;
        StateHasChanged();
    }
    
    private async Task SelectOption(int optionId)
    {
        var option = matchingOptions.FirstOrDefault(o => o.Id == optionId);
        
        if (option != null && option.SelectedCategory != "")
        {
            // Option đã được chọn, hủy kết nối
            option.SelectedCategory = "";
            selectedCategoryId = null;
            selectedOptionId = null;
            StateHasChanged();
            return;
        }
        
        if (selectedCategoryId.HasValue)
        {
            // Nối dây từ category đã chọn đến option này
            var category = matchingCategories.FirstOrDefault(c => c.Id == selectedCategoryId.Value);
            
            if (category != null)
            {
                // Kiểm tra xem category này đã được sử dụng chưa
                var existingOption = matchingOptions.FirstOrDefault(o => o.SelectedCategory == category.Label);
                if (existingOption != null)
                {
                    // Category đã được sử dụng, không cho phép chọn lại
                    return;
                }
                
                option.SelectedCategory = category.Label;
                selectedCategoryId = null; // Reset category selection
                selectedOptionId = null;
            }
        }
        else
        {
            // Chọn option để chuẩn bị nối dây
            selectedOptionId = selectedOptionId == optionId ? null : optionId;
        }
        StateHasChanged();
        // Cập nhật connection lines sau khi state thay đổi
        await Task.Delay(50);
        StateHasChanged();
    }
    
    private string GetOptionCircleStyle(int optionId)
    {
        var option = matchingOptions.FirstOrDefault(o => o.Id == optionId);
        
        if (option != null && option.SelectedCategory != "")
        {
            return "option-circle filled";
        }
        
        if (selectedOptionId == optionId)
        {
            return "option-circle selected";
        }
        
        return "option-circle";
    }
    
    private string GetOptionCircleContent(int optionId)
    {
        var option = matchingOptions.FirstOrDefault(o => o.Id == optionId);
        
        if (option != null && option.SelectedCategory != "")
        {
            return option.SelectedCategory;
        }
        
        return "";
    }
    
    private int GetCategoryIdByLabel(string label)
    {
        var category = matchingCategories.FirstOrDefault(c => c.Label == label);
        return category?.Id ?? 0;
    }
    
    private void CheckMatchingAnswers()
    {
        int correctCount = 0;
        int totalCount = matchingOptions.Count;
        
        foreach (var option in matchingOptions)
        {
            if (option.SelectedCategory == option.CorrectAnswer)
            {
                correctCount++;
            }
        }
        
        isCorrectAnswer = correctCount == totalCount;
        
        if (isCorrectAnswer)
        {
            matchingResult = $"Chúc mừng! Bạn đã trả lời đúng tất cả {totalCount} câu hỏi.";
        }
        else
        {
            matchingResult = $"Bạn đã trả lời đúng {correctCount}/{totalCount} câu hỏi. Hãy thử lại!";
        }
        
        StateHasChanged();
    }
    
    private void ResetMatchingAnswers()
    {
        foreach (var option in matchingOptions)
        {
            option.SelectedCategory = "";
        }
        matchingResult = "";
        isCorrectAnswer = false;
        selectedCategoryId = null;
        selectedOptionId = null;
        StateHasChanged();
    }
    
    private Severity GetAlertSeverity()
    {
        return isCorrectAnswer ? Severity.Success : Severity.Warning;
    }
    
    private string GetConnectionPath(int categoryId, int optionId)
    {
        // Tính toán vị trí của category và option để vẽ đường nối
        var categoryIndex = matchingCategories.FindIndex(c => c.Id == categoryId);
        var optionIndex = matchingOptions.FindIndex(o => o.Id == optionId);
        
        if (categoryIndex == -1 || optionIndex == -1)
            return "";
        
        // Vị trí từ cạnh bên phải của category box
        var categoryX = 250; // Cạnh bên phải của category box
        var categoryY = 160 + (categoryIndex * 100); // Trung tâm theo chiều dọc của box
        
        // Vị trí đến cạnh bên trái của option box
        var optionX = 590; // Cạnh bên trái của option box
        var optionY = 160 + (optionIndex * 100); // Trung tâm theo chiều dọc của box
        
        // Tạo đường thẳng đơn giản từ cạnh phải category đến cạnh trái option
        var path = $"M {categoryX} {categoryY} L {optionX} {optionY}";
        
        return path;
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UpdateConnectionLines();
        }
        await base.OnAfterRenderAsync(firstRender);
    }
    
    private async Task UpdateConnectionLines()
    {
        await Task.Delay(100); // Đợi DOM render xong
        // Có thể thêm JavaScript để tính toán vị trí chính xác
    }
    
    // Data models for matching questions
    public class MatchingCategory
    {
        public int Id { get; set; }
        public string Label { get; set; } = "";
        public string Text { get; set; } = "";
    }
    
    public class MatchingOption
    {
        public int Id { get; set; }
        public string Text { get; set; } = "";
        public string CorrectAnswer { get; set; } = "";
        public string SelectedCategory { get; set; } = "";
    }
}