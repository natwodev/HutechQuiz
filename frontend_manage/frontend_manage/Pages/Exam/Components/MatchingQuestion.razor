@using frontend_manage.DTOs

<div class="matching-root" id="@ContainerId">
    <div class="matching-header">
        <div class="side-title">Chọn cột A, sau đó chọn cột B để nối</div>
        <div class="legend">
            <span class="dot left"></span> Trái ↔ <span class="dot right"></span> Phải
        </div>
    </div>
    <svg class="matching-lines" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"></svg>
    <div class="matching-columns">
        <div class="col left">
            @foreach (var left in LeftItems)
            {
                var id = $"left-{left.AnswerId}";
                var isActive = _pendingLeft == left.AnswerId;
                <div id="@id" class="match-item @(isActive? "active":"")" @onclick="@(()=>SelectLeft(left.AnswerId))">
                    <span class="anchor left" aria-hidden="true"></span>
                    <span class="match-text katex-content">@((MarkupString)NormalizeContent(left.AnswerContent))</span>
                </div>
            }
        </div>
        <div class="col right">
            @foreach (var right in RightItems)
            {
                var id = $"right-{right.AnswerId}";
                <div id="@id" class="match-item" @onclick="@(()=>SelectRight(right.AnswerId))">
                    <span class="match-text katex-content">@((MarkupString)NormalizeContent(right.AnswerContent))</span>
                    <span class="anchor right" aria-hidden="true"></span>
                </div>
            }
        </div>
    </div>
</div>



