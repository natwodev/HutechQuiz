@using frontend_manage.DTOs
@using MudBlazor

@if (Question != null)
{
    // Kiểm tra xem đây có phải câu cha không (có câu con)
    bool isParentQuestion = Question.ChildQuestions?.Any() == true;
    
    // Hiển thị câu hỏi chính
    if (!string.IsNullOrEmpty(Question.QuestionContent))
    {
        if (isParentQuestion)
        { 
            // Câu cha: hiển thị phạm vi câu hỏi con (không có MudPaper)
            <MudText id="@($"question-parent-{Question.OriginalExamPaperDetailId}")" Typo="Typo.body1" GutterBottom="true">
                <b>@((MarkupString)ProcessQuestionContentAsync(Question.QuestionContent).Result)</b>
            </MudText>
        }
        else
        {
            // Câu đơn: có số thứ tự và MudPaper riêng
            <MudPaper Class="pa-3 mb-3" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
                <MudText id="@($"question-{QuestionNumber}")" Typo="Typo.body1" GutterBottom="true">
                    <b>Câu @(QuestionNumber): @((MarkupString)ProcessQuestionContentAsync(Question.QuestionContent).Result)</b>
                </MudText>
                
                @if (Question.Answers != null && Question.Answers?.Count > 0)
                {
                                    <MudRadioGroup T="int?" 
                               Class="mt-2" 
                               Style="display: flex; flex-direction: column;"
                               Value="@GetSelectedAnswerAsInt(Question.OriginalExamPaperDetailId)"
                               ValueChanged="@(async (selectedAnswerId) => 
                                                 await HandleAnswerSelectedWithDebounce(new AnswerSelectedArgs 
                                                 { 
                                                     QuestionId = Question.OriginalExamPaperDetailId, 
                                                     AnswerId = selectedAnswerId ?? 0 
                                                 }))">
                        @foreach (var answer in Question.Answers.OrderBy(a => a.Order))
                        {
                            <MudPaper Class="pa-2 mb-2" 
                                      Style="border: 1px solid #ddd; border-radius: 6px; background-color: #fafafa; width: 100%;">
                                <MudRadio T="int?" Value="@answer.AnswerId" Style="width: 100%;">
                                    @((MarkupString)answer.AnswerContent)
                                </MudRadio>
                            </MudPaper>
                        }
                    </MudRadioGroup>
                }
            </MudPaper>
        }
    }

    // Hiển thị câu hỏi con
    if (Question.ChildQuestions?.Any() == true)
    {
        @foreach (var childQuestion in Question.ChildQuestions.OrderBy(c => c.Order))
        {
            var childQuestionNumber = GetChildQuestionNumber(childQuestion);
            <MudPaper Class="pa-3 mb-3" Style="border: 1px solid #e0e0e0; border-radius: 8px;">
                @if (!string.IsNullOrEmpty(childQuestion.QuestionContent))
                {
                    <MudText id="@($"question-{childQuestionNumber}")" Typo="Typo.body1" GutterBottom="true">
                        <b>Câu @(childQuestionNumber): @((MarkupString)ProcessQuestionContentAsync(childQuestion.QuestionContent).Result)</b>
                </MudText>
                }

                @if (childQuestion.Answers != null && childQuestion.Answers?.Count > 0)
                {
                    <MudRadioGroup T="int?" 
                                   Class="mt-2" 
                                   Style="display: flex; flex-direction: column;"
                                   Value="@GetSelectedChildAnswerAsInt(childQuestion.OriginalExamPaperDetailId)"
                                   ValueChanged="@(async (selectedAnswerId) => 
                                                     await HandleChildAnswerSelectedWithDebounce(new AnswerSelectedArgs 
                                                     { 
                                                         QuestionId = childQuestion.OriginalExamPaperDetailId, 
                                                         AnswerId = selectedAnswerId ?? 0 
                                                     }))">
                        @foreach (var answer in childQuestion.Answers.OrderBy(a => a.Order))
                        {
                            <MudPaper Class="pa-2 mb-2" 
                                      Style="border: 1px solid #ddd; border-radius: 6px; background-color: #fafafa; width: 100%;">
                                <MudRadio T="int?" Value="@answer.AnswerId" Style="width: 100%;">
                                    @((MarkupString)answer.AnswerContent)
                                </MudRadio>
                            </MudPaper>
                        }
                    </MudRadioGroup>
                }
            </MudPaper>
        }
    }
}

