<MudStack>
    <MudText Typo="Typo.subtitle2">Điều hướng câu hỏi</MudText>
    <MudPaper Elevation="0" Class="pa-2" Style="background:#fafafa; border-radius:8px;">
        <div style="display:flex; flex-wrap:wrap; gap:8px;">
            @for (int display = 1; display <= TotalQuestions; display++)
            {
                var number = display; // avoid closure capture issues
                var idx = number - 1;
                var answered = AnsweredMap.ContainsKey(QuestionIds[idx]);
                <MudButton Style="width:40px; min-width:40px;" Size="Size.Small" Variant="@((answered) ? Variant.Filled : Variant.Outlined)" Color="@(answered? Color.Success: Color.Default)" OnClick="@(()=>OnNavigate.InvokeAsync(idx))">@number</MudButton>
            }
        </div>
    </MudPaper>
</MudStack>
@code {
    [Parameter] public int TotalQuestions { get; set; }
    [Parameter] public EventCallback<int> OnNavigate { get; set; }
    [Parameter] public Dictionary<int, object?> AnsweredMap { get; set; } = new();
    [Parameter] public List<int> QuestionIds { get; set; } = new();
}


