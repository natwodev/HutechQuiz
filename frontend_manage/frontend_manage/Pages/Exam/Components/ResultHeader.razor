@inject NavigationManager Navigation
@inject frontend_manage.Services.AuthService AuthService

<header class="result-header" style="background: #264488 !important;">
    <div class="result-header-left">
        <div class="result-brand">
            <img src="images/logo-dai-hoc-hutech_012634748.png"
                 alt="Trắc Nghiệm"
                 class="result-logo" />

            <div class="result-brand-text">
                <div class="result-brand-title">
                    TRƯỜNG ĐẠI HỌC CÔNG NGHỆ THÀNH PHỐ HỒ CHÍ MINH - HUTECH 
                </div>
                <span class="result-brand-subtitle">
                    Hệ thống thi trực tuyến HUTECH
                </span>
            </div>
        </div>
    </div>
    
    <div class="result-header-right">
        <button type="button" class="home-button" title="Đăng xuất" @onclick="HandleLogout">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
            </svg>
        </button>
    </div>
</header>

@code {
    private async Task HandleLogout()
    {
        await AuthService.Logout();
    }
}
