<div class="student-info">
    <MudStack Spacing="1">
        <MudText Typo="Typo.overline" Color="Color.Primary">THÔNG TIN THÍ SINH</MudText>
        <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Size="Size.Medium" Color="Color.Primary">@GetInitials(StudentName)</MudAvatar>
            <MudStack Spacing="1">
                <MudText Typo="Typo.h6">@StudentName</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">MSSV: @StudentCode</MudText>
            </MudStack>
        </MudStack>
        <MudDivider Class="my-2" />
        <MudStack Spacing="1">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Trạng thái</MudText>
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Success">Đang làm bài</MudChip>
        </MudStack>
    </MudStack>
</div>



