@using MudBlazor

<MudPaper Elevation="2" Class="violation-counter-paper" Style="margin-bottom: 16px;">
    <MudStack Spacing="2">
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                Cảnh báo vi phạm
            </MudText>
        </div>
        
        <div class="violation-counter-content">
            <div class="violation-counter-display">
                <MudText Typo="Typo.h4" Style="text-align: center; font-weight: bold; margin: 8px 0;">
                    <span class="@GetViolationCountClass()">@ViolationCount</span>
                    <MudText Typo="Typo.body2" Style="color: #666; font-weight: normal;">/ @MaxViolations</MudText>
                </MudText>
            </div>
            
            <MudProgressLinear Value="@GetViolationPercentage()" 
                              Color="@GetViolationColor()" 
                              Variant="Variant.Filled"
                              Style="height: 8px; border-radius: 4px; margin: 8px 0;" />
            
            @if (ViolationCount >= MaxViolations)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Style="margin-top: 8px;">
                    <MudText Typo="Typo.body2" Style="font-weight: bold;">
                        Đã vi phạm @MaxViolations lần! Bài thi sẽ tự động nộp...
                    </MudText>
                </MudAlert>
            }
            else if (ViolationCount > 0)
            {
                <MudAlert Severity="@GetAlertSeverity()" Variant="Variant.Filled" Style="margin-top: 8px;">
                    <MudText Typo="Typo.body2">
                        Còn @(MaxViolations - ViolationCount) lần vi phạm, bài thi sẽ tự động nộp!
                    </MudText>
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Style="margin-top: 8px;">
                    <MudText Typo="Typo.body2">
                        Chưa có vi phạm nào
                    </MudText>
                </MudAlert>
            }
        </div>
    </MudStack>
</MudPaper>

<style>
    .violation-counter-paper {
        padding: 16px;
        border-radius: 8px;
        background: linear-gradient(135deg, #fff 0%, #f8f9fa 100%);
        border: 2px solid #e0e0e0;
    }
    
    .violation-counter-content {
        padding: 8px 0;
    }
    
    .violation-counter-display {
        text-align: center;
        padding: 12px;
        background: #f5f5f5;
        border-radius: 8px;
        margin-bottom: 8px;
    }
    
    .violation-count-safe {
        color: #4caf50;
    }
    
    .violation-count-warning {
        color: #ff9800;
    }
    
    .violation-count-danger {
        color: #f44336;
        animation: pulse 1s infinite;
    }
    
    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: 0.7;
        }
    }
</style>

@code {
    [Parameter] public int ViolationCount { get; set; }
    [Parameter] public int MaxViolations { get; set; } = 3;
    
    private string GetViolationCountClass()
    {
        if (ViolationCount >= MaxViolations)
            return "violation-count-danger";
        if (ViolationCount >= MaxViolations - 1)
            return "violation-count-warning";
        return "violation-count-safe";
    }
    
    private Color GetViolationColor()
    {
        if (ViolationCount >= MaxViolations)
            return Color.Error;
        if (ViolationCount >= MaxViolations - 1)
            return Color.Warning;
        return Color.Success;
    }
    
    private Severity GetAlertSeverity()
    {
        if (ViolationCount >= MaxViolations - 1)
            return Severity.Warning;
        return Severity.Info;
    }
    
    private double GetViolationPercentage()
    {
        return (ViolationCount / (double)MaxViolations) * 100;
    }
}

