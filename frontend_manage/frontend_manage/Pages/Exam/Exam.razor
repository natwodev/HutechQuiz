@page "/Exam"
@using frontend_manage.Pages.Exam.Components
@using frontend_manage.Components.MonitorLayout
@using MudBlazor

<link href="css/monitor/MonitorPage.css" rel="stylesheet" />
<link href="css/exam/question-rendering.css" rel="stylesheet" />

<div id="exam-shell" class="exam-shell">
    @* Fixed Header *@
    <ExamHeader StudentSession="@StudentSession"
                ShouldShowTimer="@ShouldShowTimer"
                IsTimerVisible="@_showTimer"
                IsFullscreen="@_isFullscreen"
                ToggleTimerVisibility="ToggleTimerVisibility"
                ToggleFullscreen="ToggleFullscreenAsync"
                OnExamTimerExpired="HandleExamTimerExpired" />

    @* Main Content - Scrollable *@
    <main class="exam-main">
        <ExamStatusAlerts MissingExamSessionId="@(!StudentExamSessionId.HasValue)"
                          IsLoading="@_isLoading" />

        @if (_response != null && _questionDisplayItems.Any())
        {
            <div class="exam-content-wrapper">
                @* Main Question Panel - Scrollable với tất cả câu hỏi *@
                <div class="exam-question-area">
                    @* Render tất cả câu hỏi *@
                    @foreach (var questionItem in _questionDisplayItems)
                    {
                        var questionIndex = _questionDisplayItems.IndexOf(questionItem);
                        var questionId = $"question-{questionItem.Question.OriginalExamPaperDetailId}";
                        var isActive = questionIndex == _activeQuestionIndex;
                        
                        <div id="@questionId" 
                             class="question-container @(isActive ? "active-question" : "")" 
                             style="margin-bottom: 2rem; scroll-margin-top: 100px;">
                            <MudPaper Class="pa-4 exam-panel" Elevation="0">
                                <QuestionItem Question="@questionItem.Question"
                                              ShuffledExamPaperCore="@_response?.ExamPaper?.ShuffledExamPaperCore"
                                              DisplayNumber="@GetQuestionLabel(questionItem.Question.OriginalExamPaperDetailId)"
                                              LabelProvider="GetQuestionLabel"
                                              SelectedAnswerId="@GetSelectedAnswerId(questionItem.Question.OriginalExamPaperDetailId)"
                                              SelectedAnswerProvider="GetSelectedAnswerId"
                                              OnAnswered="HandleQuestionAnswered" />
                            </MudPaper>
                        </div>
                    }
                </div>

                @* Right Sidebar - Session Info & Navigation *@
                <aside class="exam-sidebar-right">
                    <ExamSessionInfo StudentSession="@StudentSession"
                                     AllowViewMaterialsShuffled="@(_response?.ExamPaper?.AllowViewMaterials ?? false)"
                                     AllowViewMaterialsOriginal="@(_response?.OriginalExamPaper?.AllowViewMaterials ?? false)" />
                    
                    @* Violation Counter *@
                    @if (!(_response?.ExamPaper?.AllowViewMaterials ?? true))
                    {
                        <ViolationCounter ViolationCount="@_violationCount" 
                                         MaxViolations="@MAX_VIOLATIONS" />
                    }
                    
                    <QuestionNavigation TotalQuestions="@_navigationItems.Count"
                                        QuestionIds="@_navigationItems.Select(n => n.QuestionId).ToList()"
                                        ParentIndices="@_navigationItems.Select(n => n.ParentIndex).ToList()"
                                        AnsweredMap="@_questionAnswers"
                                        ActiveQuestionIndex="@_activeQuestionIndex"
                                        OnNavigate="NavigateToEntry"
                                        SubmitExam="SubmitExam" />
                </aside>
            </div>
        }
    </main>

    @* Fixed Footer *@
    <div class="exam-footer">
        <Footer ShowClock="true" />
    </div>
</div>
