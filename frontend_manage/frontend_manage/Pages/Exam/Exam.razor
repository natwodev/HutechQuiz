@page "/Exam"
@using frontend_manage.Pages.Exam.Components
@using MudBlazor

<div id="exam-shell" class="exam-shell">
    @* Fixed Header *@
    <ExamHeader StudentSession="@StudentSession"
                ShouldShowTimer="@ShouldShowTimer"
                IsTimerVisible="@_showTimer"
                IsFullscreen="@_isFullscreen"
                ToggleTimerVisibility="ToggleTimerVisibility"
                ToggleFullscreen="ToggleFullscreenAsync"
                OnExamTimerExpired="HandleExamTimerExpired" />

    @* Main Content - Scrollable *@
    <main class="exam-main">
        <ExamStatusAlerts MissingExamSessionId="@(!StudentExamSessionId.HasValue)"
                          IsLoading="@_isLoading" />

        @if (_response != null && _questionDisplayItems.Any())
        {
            <div class="exam-content-wrapper">
                @* Main Question Panel *@
                <div class="exam-question-area">
                    <QuestionDisplayPanel ActiveQuestion="@ActiveQuestion?.Question"
                                          CurrentIndex="@_activeQuestionIndex"
                                          TotalQuestions="@_questionDisplayItems.Count"
                                          OnPrevious="PreviousQuestion"
                                          OnNext="NextQuestion"
                                          GetQuestionLabel="GetQuestionLabel"
                                          GetSelectedAnswerId="GetSelectedAnswerId"
                                          OnAnswered="HandleQuestionAnswered"
                                          StudentSession="@StudentSession"
                                          OnExamTimerExpired="HandleExamTimerExpired" />
                </div>

                @* Right Sidebar - Session Info & Navigation *@
                <aside class="exam-sidebar-right">
                    <ExamSessionInfo StudentSession="@StudentSession"
                                     AllowViewMaterialsShuffled="@(_response?.ExamPaper?.AllowViewMaterials ?? false)"
                                     AllowViewMaterialsOriginal="@(_response?.OriginalExamPaper?.AllowViewMaterials ?? false)" />
                    <QuestionNavigation TotalQuestions="@_navigationItems.Count"
                                        QuestionIds="@_navigationItems.Select(n => n.QuestionId).ToList()"
                                        ParentIndices="@_navigationItems.Select(n => n.ParentIndex).ToList()"
                                        AnsweredMap="@_questionAnswers"
                                        ActiveQuestionIndex="@_activeQuestionIndex"
                                        OnNavigate="NavigateToEntry" />
                </aside>
            </div>
        }
    </main>

    @* Fixed Footer *@
    <ExamFooter CanReload="@_canTriggerFetch"
                ReloadLabel="@_fetchButtonLabel"
                ActiveQuestionIndex="@_activeQuestionIndex"
                TotalQuestions="@_questionDisplayItems.Count"
                ReloadExam="ReloadExamAsync"
                PreviousQuestion="PreviousQuestion"
                NextQuestion="NextQuestion" />
</div>
