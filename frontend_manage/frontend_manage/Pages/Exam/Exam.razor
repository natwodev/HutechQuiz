@page "/Exam"
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject frontend_manage.Pages.Login.InfoApi InfoApi

@using FrontEnd.DTOs
@using Microsoft.AspNetCore.Components

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int? examSessionSubjectId { get; set; }

    private ShuffledExamPaperDto? shuffledExam;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (examSessionSubjectId == null)
        {
            errorMessage = "Không tìm thấy thông tin ca thi môn học.";
            return;
        }
        try
        {
            shuffledExam = await InfoApi.StartExamAsync(examSessionSubjectId.Value);
            if (shuffledExam == null)
            {
                errorMessage = "Không thể lấy đề thi hoán vị.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}

<h3>Làm bài thi</h3>
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (shuffledExam == null)
{
    <p>Đang tải đề thi...</p>
}
else
{
    <div class="mb-3">
        <h4>@shuffledExam.Title (@shuffledExam.ShuffledExamPaperCore)</h4>
        <p><b>Mã đề:</b> @shuffledExam.ShuffledExamPaperCore</p>
        <p><b>Trạng thái phê duyệt:</b> @(shuffledExam.IsApproved ? "Đã duyệt" : "Chưa duyệt")</p>
    </div>
    <ol>
        @foreach (var q in shuffledExam.Details.OrderBy(d => d.Order))
        {
            <li class="mb-3">
                <div>@((MarkupString)q.QuestionContent)</div>
                <div class="mt-2">
                    <div><input type="radio" name="q@q.ShuffledExamPaperDetailId" /> @((MarkupString)q.Answer1)</div>
                    <div><input type="radio" name="q@q.ShuffledExamPaperDetailId" /> @((MarkupString)q.Answer2)</div>
                    <div><input type="radio" name="q@q.ShuffledExamPaperDetailId" /> @((MarkupString)q.Answer3)</div>
                    <div><input type="radio" name="q@q.ShuffledExamPaperDetailId" /> @((MarkupString)q.Answer4)</div>
                </div>
            </li>
        }
    </ol>
}