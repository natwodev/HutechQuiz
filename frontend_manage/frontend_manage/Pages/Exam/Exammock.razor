@page "/exam/mock"
@using frontend_manage.DTOs
@using frontend_manage.Pages.Exam.Components
@using frontend_manage.Services
@inject IKaTeXService KaTeX
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.False" Class="pa-2" Style="min-height:100vh; background:#f7f9fc;">
    <MudGrid>
        <MudItem xs="12" md="9">
            <MudPaper Elevation="1" Class="pa-4" Style="border-radius:12px; min-height:70vh;">
                @if (FlatQuestions.Count > 0)
                {
                    var idx = 1;
                    foreach (var q in FlatQuestions)
                    {
                        <div id="@($"q-{q.OriginalExamPaperDetailId}")" class="mb-6">
                            <QuestionItem Question="@q" DisplayNumber="@idx.ToString()" OnAnswered="@OnAnswered" />
                            @{ idx++; }
                            <MudDivider Class="my-4" />
                        </div>
                    }
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudPaper Elevation="1" Class="pa-3" Style="border-radius:12px; position:sticky; top:12px;">
                <StudentInfo StudentName="@StudentName" StudentCode="@StudentCode" />
                <MudDivider Class="my-2" />
                <ExamTimer DurationMinutes="@DurationMinutes" StartTime="@StartTime" OnTimeUp="@SubmitExam" />
                <MudDivider Class="my-2" />
                <QuestionNavigation TotalQuestions="@FlatQuestions.Count" OnNavigate="@ScrollTo" AnsweredMap="@AnsweredMapDerived" QuestionIds="@QuestionIds" />
                <MudDivider Class="my-2" />
                <MudButton Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" OnClick="@SubmitExam">Nộp bài</MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>


