@page "/Exam/Result"

<PageTitle>Kết quả bài thi</PageTitle>

<MudPaper Class="pa-6">
    <MudText Typo="Typo.h4">Kết quả</MudText>
    <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
        @(_submission?.StudentCode is null ? "Không xác định sinh viên" : $"Mã sinh viên: {_submission.StudentCode}")
    </MudText>
</MudPaper>

@if (_isLoading)
{
    <div class="d-flex justify-center my-10">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" Style="width:80px;height:80px;" />
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-6">
        @_errorMessage
    </MudAlert>
}
else if (_submission is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-6">
        Không có dữ liệu kết quả để hiển thị. Vui lòng quay lại và thử lại.
    </MudAlert>
}
else
{
    <MudGrid Class="mt-6">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.h5">Thông tin bài thi</MudText>
                <MudDivider Class="my-4" />
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Điểm</MudText>
                        <MudText Typo="Typo.h6">@ScoreDisplay</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Số câu đúng</MudText>
                        <MudText Typo="Typo.h6">
                            @(_submission.CorrectAnswers?.ToString() ?? "Chưa có")
                            / @(_submission.TotalQuestions?.ToString() ?? "?")
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Bắt đầu</MudText>
                        <MudText>@FormatDate(_submission.StartTime)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Nộp bài</MudText>
                        <MudText>@FormatDate(_submission.EndTime)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Thời lượng làm bài</MudText>
                        <MudText>@FormatDuration(_submission.StartTime, _submission.EndTime)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Đề thi hoán vị</MudText>
                        <MudText>@_submission.ShuffledExamPaperId</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.h5">Thông tin lưu vết</MudText>
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2">Chuỗi đáp án đã lưu</MudText>
                <MudPaper Class="pa-3 mb-4" Style="font-family: monospace; white-space: pre-wrap;">
                    @_submission.StudentAnswersString ?? "Không có"
                </MudPaper>
                <MudText Typo="Typo.subtitle2">Đáp án đúng</MudText>
                <MudPaper Class="pa-3" Style="font-family: monospace; white-space: pre-wrap;">
                    @_submission.AnswerKey ?? "Không có"
                </MudPaper>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-6 mt-6">
        <MudText Typo="Typo.h5">Tổng quan câu trả lời</MudText>
        <MudDivider Class="my-4" />

        <MudStack Spacing="2" Class="mb-5">
            <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Color="Color.Success" Typo="Typo.subtitle1">Câu trả lời đúng</MudText>
                <MudChip T="int" Color="Color.Success" Variant="Variant.Filled" Style="min-width:48px;justify-content:center;">
                    @_correctCount
                </MudChip>
            </MudStack>
            <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Color="Color.Error" Typo="Typo.subtitle1">Câu trả lời sai</MudText>
                <MudChip T="int" Color="Color.Error" Variant="Variant.Filled" Style="min-width:48px;justify-content:center;">
                    @_incorrectCount
                </MudChip>
            </MudStack>
            <MudStack Direction="Row" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Color="Color.Warning" Typo="Typo.subtitle1">Chưa trả lời</MudText>
                <MudChip T="int" Color="Color.Dark" Variant="Variant.Filled" Style="min-width:48px;justify-content:center;">
                    @_unansweredCount
                </MudChip>
            </MudStack>
        </MudStack>

        @if (_answerComparisons is { Count: > 0 })
        {
            <MudDivider Class="my-4" />
            <MudStack Direction="Row" Spacing="1" Class="flex-wrap gap-2 mb-6">
                @foreach (var answer in _answerComparisons)
                {
                    <MudTooltip Text="@($"Câu {answer.QuestionId}")">
                        <MudChip T="int"
                                 Style="width:42px;height:42px;border-radius:50%;justify-content:center;"
                                 Color="@GetStateColor(answer.State)"
                                 Variant="Variant.Filled"
                                 Size="Size.Medium">
                            @answer.QuestionId
                        </MudChip>
                    </MudTooltip>
                }
            </MudStack>
        }

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.h5">Chi tiết đáp án</MudText>
        <MudDivider Class="my-4" />

        @if (_answerComparisons != null && _answerComparisons.Count > 0)
        {
            <MudTable Items="_answerComparisons" Dense="true" Hover="true" Bordered="true">
                <HeaderContent>
                    <MudTh>Câu</MudTh>
                    <MudTh>Đã chọn</MudTh>
                    <MudTh>Đáp án đúng</MudTh>
                    <MudTh>Trạng thái</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Câu">@context.QuestionId</MudTd>
                    <MudTd DataLabel="Đã chọn">@FormatAnswerValue(context.StudentAnswer)</MudTd>
                    <MudTd DataLabel="Đáp án đúng">@FormatAnswerValue(context.CorrectAnswer)</MudTd>
                    <MudTd DataLabel="Trạng thái">
                        <MudChip T="string" Color="@GetStateColor(context.State)" Variant="Variant.Filled" Size="Size.Small">
                            @GetStateLabel(context.State)
                        </MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudText Color="Color.Secondary">Không có dữ liệu chi tiết câu trả lời.</MudText>
        }
    </MudPaper>
}