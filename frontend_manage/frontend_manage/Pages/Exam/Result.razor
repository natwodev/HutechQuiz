@page "/Exam/Result"

<PageTitle>Kết quả bài thi</PageTitle>

<link href="css/result-page.css" rel="stylesheet" />

<ResultHeader />

<div class="result-bg" style="background: url('/images/Home_Page2.jpg') no-repeat center center fixed; background-size: cover;"></div>

@if (_isLoading)
{
    <div class="result-loading">
        <div class="loader"></div>
        <p>Đang tải kết quả...</p>
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="result-page">
        <div class="alert alert-error">
            <span class="alert-icon">⚠️</span>
            <span>@_errorMessage</span>
        </div>
    </div>
}
else if (_submission is null)
{
    <div class="result-page">
        <div class="alert alert-info">
            <span class="alert-icon">ℹ️</span>
            <span>Không có dữ liệu kết quả để hiển thị. Vui lòng quay lại và thử lại.</span>
        </div>
    </div>
}
else
{
    <div class="result-page">
        <div class="result-content">
            @* Left Section - Score & Student Info *@
            <div class="result-left">
                @* Score Card *@
                <div class="score-card @GetScoreClass()">
                    <div class="score-ring">
                        <svg viewBox="0 0 100 100">
                            <circle class="score-ring-bg" cx="50" cy="50" r="45"></circle>
                            <circle class="score-ring-progress" cx="50" cy="50" r="45" 
                                    style="stroke-dasharray: @GetScoreProgress() 283;"></circle>
                        </svg>
                        <div class="score-text">
                            @if (_submission.Score.HasValue)
                            {
                                <span class="score-num">@($"{_submission.Score.Value:F1}")</span>
                                <span class="score-max">/10</span>
                            }
                            else
                            {
                                <span class="score-num">--</span>
                            }
                        </div>
                    </div>
                    <h2 class="result-title">@GetResultMessage()</h2>
                    <p class="student-code">@(_submission?.StudentCode ?? "Sinh viên")</p>
                </div>

                @* Quick Stats *@
                <div class="quick-stats">
                    <div class="stat correct">
                        <span class="stat-num">@_correctCount</span>
                        <span class="stat-label">Đúng</span>
                    </div>
                    <div class="stat incorrect">
                        <span class="stat-num">@_incorrectCount</span>
                        <span class="stat-label">Sai</span>
                    </div>
                    <div class="stat skipped">
                        <span class="stat-num">@_unansweredCount</span>
                        <span class="stat-label">Bỏ qua</span>
                    </div>
                </div>
            </div>

            @* Right Section - Details *@
            <div class="result-right">
                @* Time Info *@
                <div class="info-card">
                    <h3 class="card-title">
                        <span class="icon">⏱️</span>
                        Thời gian làm bài
                    </h3>
                    <div class="time-grid">
                        <div class="time-item">
                            <span class="time-icon start">▶</span>
                            <div>
                                <span class="time-label">Bắt đầu</span>
                                <span class="time-value">@FormatDate(_submission.StartTime)</span>
                            </div>
                        </div>
                        <div class="time-item">
                            <span class="time-icon end">⏹</span>
                            <div>
                                <span class="time-label">Nộp bài</span>
                                <span class="time-value">@FormatDate(_submission.EndTime)</span>
                            </div>
                        </div>
                        <div class="time-item duration">
                            <span class="time-icon timer">⏰</span>
                            <div>
                                <span class="time-label">Thời lượng</span>
                                <span class="time-value highlight">@FormatDuration(_submission.StartTime, _submission.EndTime)</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* Answer Details *@
                <div class="info-card answers-card">
                    <h3 class="card-title">
                        <span class="icon">📊</span>
                        Chi tiết câu trả lời
                    </h3>
                    @if (_answerComparisons is { Count: > 0 })
                    {
                        <div class="answers-grid">
                            @foreach (var (answer, index) in _answerComparisons.Select((a, i) => (a, i)))
                            {
                                <div @key="@answer.QuestionId" class="answer-dot @GetAnswerClass(answer.State)" title="Câu @(index + 1): @GetStateLabel(answer.State)">
                                    @(index + 1)
                                </div>
                            }
                        </div>
                        <div class="answers-legend">
                            <span><span class="dot correct"></span> Đúng</span>
                            <span><span class="dot incorrect"></span> Sai</span>
                            <span><span class="dot skipped"></span> Bỏ qua</span>
                        </div>
                    }
                    else
                    {
                        <p class="no-data">Không có dữ liệu chi tiết câu trả lời.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}