@page "/Exam/Result"


<PageTitle>Kết quả bài thi</PageTitle>

@if (loading)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
        <MudPaper Elevation="4" Class="pa-6">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Medium" />
            <MudText Class="ml-3">Đang tải kết quả...</MudText>
        </MudPaper>
    </MudContainer>
}
else if (examResult?.Data != null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
        <MudPaper Elevation="4" Class="pa-6">
            <!-- Exam Info -->
            <MudPaper Class="pa-4 mb-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                    Thông tin bài thi
                </MudText>
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudCard Class="ma-2" Elevation="2">
                            <MudCardContent>
                                <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-1">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="mr-1" />
                                    Mã sinh viên
                                </MudText>
                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">
                                    @examResult.Data.StudentCode
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Class="ma-2" Elevation="2">
                            <MudCardContent>
                                <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-1">
                                    <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" Class="mr-1" />
                                    Mã đề thi
                                </MudText>
                                <MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">
                                    @examResult.Data.ShuffledExamPaperId
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Class="ma-2" Elevation="2">
                            <MudCardContent>
                                <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-1">
                                    <MudIcon Icon="@Icons.Material.Filled.Grade" Size="Size.Small" Class="mr-1" />
                                    Điểm số
                                </MudText>
                                <MudText Typo="Typo.h6" Color="@(examResult.Data.Score.HasValue ? (examResult.Data.Score >= 8 ? Color.Success : examResult.Data.Score >= 6.5 ? Color.Warning : Color.Error) : Color.Default)" Class="font-weight-bold">
                                    @(examResult.Data.Score?.ToString("F2") ?? "N/A")
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudCard Class="ma-2" Elevation="2">
                            <MudCardContent>
                                <MudText Typo="Typo.caption" Color="Color.Info" Class="mb-1">
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                                    Số câu đúng
                                </MudText>
                                <MudText Typo="Typo.h6" Color="Color.Info" Class="font-weight-bold">
                                    @(examResult.Data.CorrectAnswers?.ToString() ?? "0")/@(examResult.Data.TotalQuestions?.ToString() ?? "0")
                                </MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Answers -->
            @if (questionAnswers.Any())
            {
                <MudPaper Class="pa-4 mb-4" Elevation="1">
                    <MudText Typo="Typo.h6" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" />
                        Bảng câu trả lời
                    </MudText>
                    <MudGrid Class="mt-4">
                        @for (int i = 0; i < questionAnswers.Count; i++)
                        {
                            var q = questionAnswers[i];
                            var displayNumber = (i + 1).ToString();
                            <MudItem xs="2" sm="1" md="1" lg="1">
                                <MudPaper Class="pa-1 text-center" Elevation="1">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@displayNumber</MudText>
                                    <MudButton Variant="Variant.Filled"
                                               Color="@GetAnswerColor(q)"
                                               StartIcon="@GetAnswerIcon(q)"
                                               Class="mud-width-full">
                                        @GetAnswerText(q)
                                    </MudButton>

                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                    
                    <!-- Legend - Di chuyển xuống dưới bảng câu trả lời -->
                    <MudDivider Class="my-4" />
                    <MudGrid Class="mt-4">
                        <MudItem xs="4">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-1" />
                                Đúng
                            </MudText>
                        </MudItem>
                        <MudItem xs="4">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" Class="mr-1" />
                                Sai
                            </MudText>
                        </MudItem>
                        <MudItem xs="4">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                <MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Default" Size="Size.Small" Class="mr-1" />
                                Không trả lời
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudPaper>
            }

            <!-- Actions -->
            <MudGrid Class="mt-6">
                <MudItem xs="12" md="6">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               OnClick="GoToStudentDashboard" StartIcon="@Icons.Material.Filled.Home">
                        Về trang chủ
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-4">
        <MudPaper Elevation="4" Class="pa-6">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                <MudText>Không tìm thấy kết quả bài thi hoặc có lỗi xảy ra.</MudText>
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                       OnClick="GoToStudentDashboard" StartIcon="@Icons.Material.Filled.Home">
                Về trang chủ
            </MudButton>
        </MudPaper>
    </MudContainer>
}
