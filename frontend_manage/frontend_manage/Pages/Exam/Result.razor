@page "/Exam/Result"

<PageTitle>Kết quả bài thi</PageTitle>

<ResultHeader />

<div style="position:fixed; inset:0; width:100vw; height:100vh; z-index:-1; background: url('/images/Home_Page2.jpg') no-repeat center center fixed; background-size: cover;"></div>

@if (_isLoading)
{
    <div class="d-flex justify-center my-10">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" Style="width:80px;height:80px;" />
    </div>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-6">
        @_errorMessage
    </MudAlert>
}
else if (_submission is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-6">
        Không có dữ liệu kết quả để hiển thị. Vui lòng quay lại và thử lại.
    </MudAlert>
}
else
{
    <MudGrid Class="mt-6">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.h5">Thông tin bài thi</MudText>
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                    @(_submission?.StudentCode is null ? "Không xác định sinh viên" : $"Mã sinh viên: {_submission.StudentCode}")
                </MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Điểm</MudText>
                        @if (_submission?.Score.HasValue == true)
                        {
                            <img src="@ScoreSvgDataUri" alt="Điểm số" style="max-width: 100%; height: auto;" />
                        }
                        else
                        {
                            <MudText Typo="Typo.h6">Chưa có điểm</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Số câu đúng</MudText>
                        <MudText Typo="Typo.h6">
                            @(_submission.CorrectAnswers?.ToString() ?? "Chưa có")
                            / @(_submission.TotalQuestions?.ToString() ?? "?")
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Bắt đầu</MudText>
                        <MudText>@FormatDate(_submission.StartTime)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Nộp bài</MudText>
                        <MudText>@FormatDate(_submission.EndTime)</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.subtitle2">Thời lượng làm bài</MudText>
                        <MudText>@FormatDuration(_submission.StartTime, _submission.EndTime)</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-6">
                <MudText Typo="Typo.h5">Thống kê</MudText>
                <MudDivider Class="my-4" />
                <div style="display:flex; gap:32px; align-items:center; justify-content:space-between;">

                    <div style="display:flex; align-items:center; gap:8px;">
                        <MudText Color="Color.Success" Typo="Typo.subtitle1">Câu trả lời đúng</MudText>
                        <MudChip T="int" Color="Color.Success" Variant="Variant.Filled" Style="min-width:48px;justify-content:center;">
                            @_correctCount
                        </MudChip>
                    </div>

                    <div style="display:flex; align-items:center; gap:8px;">
                        <MudText Color="Color.Error" Typo="Typo.subtitle1">Câu trả lời sai</MudText>
                        <MudChip T="int" Color="Color.Error" Variant="Variant.Filled" Style="min-width:48px;justify-content:center;">
                            @_incorrectCount
                        </MudChip>
                    </div>

                    <div style="display:flex; align-items:center; gap:8px;">
                        <MudText Color="Color.Warning" Typo="Typo.subtitle1">Chưa trả lời</MudText>
                        <MudChip T="int" Color="Color.Warning" Variant="Variant.Filled" Style="min-width:48px;justify-content:center;">
                            @_unansweredCount
                        </MudChip>
                    </div>
                </div>

                <MudDivider Class="my-4" />

                @if (_answerComparisons is { Count: > 0 })
                {
                    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(42px, 1fr)); gap: 8px;">
                        @foreach (var (answer, index) in _answerComparisons.Select((answer, index) => (answer, index)))
                        {
                            var stt = index + 1;
                            <MudTooltip Text="@($"Câu {answer.QuestionId}")">
                                <MudChip T="int"
                                         Style="width:42px;height:42px;border-radius:50%;justify-content:center;margin:0 auto;"
                                         Color="@GetStateColor(answer.State)"
                                         Variant="Variant.Filled"
                                         Size="Size.Medium">
                                    @stt
                                </MudChip>
                            </MudTooltip>
                        }
                    </div>
                }
                else
                {
                    <MudText Color="Color.Secondary">Không có dữ liệu chi tiết câu trả lời.</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
    
   
}