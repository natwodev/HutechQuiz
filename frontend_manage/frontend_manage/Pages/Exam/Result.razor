@page "/Exam/Result"
@using MudBlazor
@using Microsoft.JSInterop
@using frontend_manage.DTOs
@using frontend_manage.Services
@using System.Text.RegularExpressions
@using System.Linq

<div class="result-page-wrapper">
    <!-- Header với logo -->
    <MudPaper Elevation="2" Class="result-header">
        <MudContainer MaxWidth="MaxWidth.Large" Class="d-flex align-center justify-space-between py-2">
            <MudButton 
                Variant="Variant.Text" 
                Class="logo-button"
                DisableRipple="true">
                <img src="/images/logo-dai-hoc-hutech_012634748.png" alt="Hutech Logo" class="hutech-logo" />
                <MudText Typo="Typo.h6" Class="ml-2 text-primary">HUTECH</MudText>
            </MudButton>
        </MudContainer>
    </MudPaper>

    <div class="result-bg">
        <MudContainer MaxWidth="MaxWidth.Large" Class="er-container">

            <!-- HERO (nền riêng, tách nội dung) -->
            <MudPaper Elevation="0" Class="er-hero">
                <div class="er-hero__bg"></div>
                <MudGrid Class="er-hero__grid" GutterSize="16px" AlignItems="Center">
                    <MudItem xs="12">
                        <div class="er-hero__title-wrap">
                            <MudText Typo="Typo.h4" Class="er-hero__title">Kết quả bài thi</MudText>
                            <MudText Typo="Typo.subtitle2" Class="er-hero__subtitle">
                                Tổng quan điểm số, thời lượng và trạng thái câu hỏi
                            </MudText>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            @if (isLoading)
            {
                <MudPaper Class="pa-6 mt-6 d-flex align-center justify-center">
                    <MudProgressCircular Color="Color.Primary" Size="Size.Large"/>
                    <MudText Class="ml-3">Đang tải kết quả...</MudText>
                </MudPaper>
            }
            else if (submission != null)
            {
               
                
                
                <MudGrid GutterSize="24px" Class="mb-4">
                    <!-- Thông tin -->
                    <MudItem xs="12" md="7">
                        <MudCard Elevation="6" Class="er-card er-card--info">
                            <MudCardHeader>
                                <MudText Typo="Typo.h6" Class="fw-bold">Thông tin bài thi</MudText>
                            </MudCardHeader>
                            <MudCardContent>
                                <div class="info-grid">
                                    <div class="info-row"><div class="k">Mã sinh viên</div><div class="v">@submission.StudentCode</div></div>
                                    <div class="info-row"><div class="k">Mã đề thi</div><div class="v">@submission.ShuffledExamPaperId</div></div>
                                    <div class="info-row"><div class="k">Điểm số</div><div class="v">@((submission.Score ?? 0).ToString("0.00"))</div></div>
                                    <div class="info-row"><div class="k">Bắt đầu</div><div class="v">@(submission.StartTime?.ToString("dd/MM/yyyy HH:mm:ss") ?? "")</div></div>
                                    <div class="info-row"><div class="k">Kết thúc</div><div class="v">@submission.EndTime.ToString("dd/MM/yyyy HH:mm:ss")</div></div>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    
                    
                    
                    
                    <!-- Điểm (SVG lớn) -->
                    <MudItem xs="12" md="5">
                        <MudCard Elevation="8" Class="er-card stat-card stat-card--score">
                            <MudCardContent Class="stat-card__content er-score-svg-wrap">
                                <img src="" alt="Điểm thi" class="er-score-svg" />
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                    
                    
                </MudGrid>

                <!-- HÀNG 2: Heatmap (ô to hơn) -->
                <MudCard Elevation="6" Class="er-card">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6" Class="fw-bold">Kết quả câu hỏi</MudText>
                        <MudSpacer/>
                        <div class="er-legend-compact">
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Dense="true">Đúng</MudChip>
                            <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Dense="true">Sai</MudChip>
                            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Dense="true">Chưa TL</MudChip>
                        </div>
                    </MudCardHeader>

                    <MudCardContent>
                        
                    </MudCardContent>
                </MudCard>
                
            }
            else
            {
                <MudPaper Class="pa-6 mt-6">
                    <MudText>Không có dữ liệu kết quả để hiển thị.</MudText>
                </MudPaper>
            }
        </MudContainer>
    </div>
</div>

