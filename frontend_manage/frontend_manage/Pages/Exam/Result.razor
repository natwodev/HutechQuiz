@page "/Exam/Result"
@using MudBlazor

<div class="result-page-wrapper">
    <div class="result-bg">
        <MudContainer MaxWidth="MaxWidth.Large" Class="er-container">

            <!-- HERO (nền riêng, tách nội dung) -->
            <MudPaper Elevation="0" Class="er-hero">
                <div class="er-hero__bg"></div>
                <MudGrid Class="er-hero__grid" GutterSize="16px" AlignItems="Center">
                    <MudItem xs="12">
                        <div class="er-hero__title-wrap">
                            <MudText Typo="Typo.h4" Class="er-hero__title">Kết quả bài thi</MudText>
                            <MudText Typo="Typo.subtitle2" Class="er-hero__subtitle">
                                Tổng quan điểm số, thời lượng và trạng thái câu hỏi
                            </MudText>
                        </div>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            @if (isLoading)
            {
                <MudSkeleton Animation="Animation.Wave" Width="60%" Height="36px" Class="mb-4"/>
                <MudSkeleton Animation="Animation.Wave" Height="280px"/>
            }
            else if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Dense="true" Class="mb-4">
                    @errorMessage
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" OnClick="@Reload">Thử lại</MudButton>
                </MudAlert>
            }
            else if (result is not null)
            {
               
                    var total   = result.Data.TotalQuestions;
                    var correct = (HeatCells?.Count(c => c.StatusCss == "ok") ?? 0);
                    var wrong   = (HeatCells?.Count(c => c.StatusCss == "bad") ?? 0);
                    var empty   = (HeatCells?.Count(c => c.StatusCss == "empty") ?? 0);
                    var accuracy = total > 0 ? (double)correct / total * 100d : 0d;
                

                <!-- HÀNG 1: Thông tin bài thi (trái) + Điểm SVG (phải) -->
                <MudGrid GutterSize="24px" Class="mb-4">
                    <!-- Thông tin -->
                    <MudItem xs="12" md="7">
                        <MudCard Elevation="6" Class="er-card er-card--info">
                            <MudCardHeader>
                                <MudText Typo="Typo.h6" Class="fw-bold">Thông tin bài thi</MudText>
                            </MudCardHeader>
                            <MudCardContent>
                                <div class="info-grid">
                                    <div class="info-row"><div class="k">Mã sinh viên</div><div class="v">@result.Data.StudentCode</div></div>
                                    <div class="info-row"><div class="k">Mã đề thi</div><div class="v">@result.Data.ShuffledExamPaperId</div></div>
                                    <div class="info-row"><div class="k">Bắt đầu</div><div class="v">@result.Data.StartTime.ToString("dd/MM/yyyy HH:mm:ss")</div></div>
                                    <div class="info-row"><div class="k">Kết thúc</div><div class="v">@result.Data.EndTime.ToString("dd/MM/yyyy HH:mm:ss")</div></div>
                                </div>

                                <div class="info-stats">
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Dense="true">@correct</MudChip>
                                    <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Dense="true" Class="ml-2">@wrong</MudChip>
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Dense="true" Class="ml-2">@empty</MudChip>
                                    <span class="info-note">/ @total câu • Tỉ lệ đúng: @($"{accuracy:0.#}%")</span>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <!-- Điểm (SVG lớn) -->
                    <MudItem xs="12" md="5">
                        <MudCard Elevation="8" Class="er-card stat-card stat-card--score">
                            <MudCardContent Class="stat-card__content er-score-svg-wrap">
                                <img src="@ScoreSvgDataUri" alt="Điểm thi" class="er-score-svg" />
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>

                <!-- HÀNG 2: Heatmap (ô to hơn) -->
                <MudCard Elevation="6" Class="er-card">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6" Class="fw-bold">Kết quả câu hỏi</MudText>
                        <MudSpacer/>
                        <div class="er-legend-compact">
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Dense="true">Đúng</MudChip>
                            <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Dense="true">Sai</MudChip>
                            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Dense="true">Chưa TL</MudChip>
                        </div>
                    </MudCardHeader>

                    <MudCardContent>
                        @if ((HeatCells?.Count ?? 0) == 0)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                                Chưa có dữ liệu để vẽ heatmap.
                            </MudAlert>
                        }
                        else
                        {
                           
                                // Ô to hơn: 24px, khoảng cách 8px
                                const int cell = 24;
                                const int gap  = 8;
                                const int cols = 14; // đổi 7 nếu muốn cảm giác như GitHub (7 hàng)
                                var wrapWidth = cols * (cell + gap) - gap;
                                var containerStyle = $"display:flex;flex-wrap:wrap;align-items:flex-start;max-width:{wrapWidth}px";
                            

                            <div class="heatmap-wrap">
                                <div style="@containerStyle">
                                    @foreach (var c in HeatCells!)
                                    {
                                        var bg = c.StatusCss == "ok"  ? "#43a047"
                                               : c.StatusCss == "bad" ? "#e53935"
                                                                      : "#b0bec5";
                                        var bd = c.StatusCss == "ok"  ? "#2e7d32"
                                               : c.StatusCss == "bad" ? "#b71c1c"
                                                                      : "#78909c";
                                        var tip = $"Câu {c.QuestionNo}: {c.StatusText}";
                                        var cellStyle = $"display:inline-block;width:{cell}px;height:{cell}px;margin:{gap/2}px;" +
                                                        $"background:{bg};border:1px solid {bd};border-radius:5px;box-sizing:border-box";

                                        <span title="@tip" aria-label="@tip" style="@cellStyle"></span>
                                    }
                                </div>
                            </div>
                        }
                    </MudCardContent>
                </MudCard>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                    Không tìm thấy kết quả.
                </MudAlert>
            }
        </MudContainer>
    </div>
</div>
