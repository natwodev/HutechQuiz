@page "/Exam/Result"
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Kết quả bài thi</PageTitle>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int? studentExamSessionId { get; set; }

    // Dữ liệu ảo trực tiếp
    private bool success = true;
    private string message = "Nộp bài thi thành công. Điểm: 0,00, Đúng: 0/16 câu";
    private string studentCode = "028";
    private int shuffledExamPaperId = 357;
    private double score = 0;
    private int correctAnswers = 0;
    private int totalQuestions = 16;
    private DateTime endTime = DateTime.Parse("2025-08-05T23:09:43.910037");
    private string studentAnswersString = "(1,-);(2,-);(3,-);(4,-);(5,-);(6,-);(7,-);(8.1,-);(8.2,-);(8.3,-);(9.1,-);(9.2,-);(9.3,-);(10.1,-);(10.2,-);(10.3,-)";

    private string GetScoreColor()
    {
        if (score >= 8.0) return "success";
        if (score >= 6.5) return "warning";
        return "error";
    }

    private string GetScoreText()
    {
        if (score >= 8.0) return "Xuất sắc";
        if (score >= 6.5) return "Khá";
        if (score >= 5.0) return "Trung bình";
        return "Chưa đạt";
    }

    private string GetPercentage()
    {
        if (totalQuestions == 0) return "0%";
        var percentage = (double)correctAnswers / totalQuestions * 100;
        return $"{percentage:F1}%";
    }

    private void GoBackToLogin()
    {
        Navigation.NavigateTo("/Login");
    }

    private void ViewDetailedResults()
    {
        // TODO: Navigate to detailed results page
        Snackbar.Add("Tính năng xem chi tiết đang được phát triển", Severity.Info);
    }
}

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-4">
    <MudPaper Elevation="4" Class="pa-6">
        <!-- Header -->
        <MudGrid Class="mb-6">
            <MudItem xs="12" Class="text-center">
                <MudIcon Icon="@Icons.Material.Filled.Assessment" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                <MudText Typo="Typo.h4" Color="Color.Primary" Class="mb-2">
                    Kết quả bài thi
                </MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    @message
                </MudText>
            </MudItem>
        </MudGrid>

        <!-- Score Card -->
        <MudPaper Class="pa-4 mb-4" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <MudGrid>
                <MudItem xs="12" md="6" Class="text-center">
                    <MudText Typo="Typo.h2" Class="mb-2">
                        @score.ToString("F2")
                    </MudText>
                    <MudText Typo="Typo.body1">
                        Điểm số
                    </MudText>
                </MudItem>
                <MudItem xs="12" md="6" Class="text-center">
                    <MudText Typo="Typo.h4" Class="mb-2">
                        @GetScoreText()
                    </MudText>
                    <MudText Typo="Typo.body1">
                        Đánh giá
                    </MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Statistics -->
        <MudGrid Class="mb-6">
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 text-center" Elevation="2">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h4" Color="Color.Success">
                        @correctAnswers
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Câu đúng
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 text-center" Elevation="2">
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h4" Color="Color.Error">
                        @(totalQuestions - correctAnswers)
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Câu sai
                    </MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudPaper Class="pa-4 text-center" Elevation="2">
                    <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Info" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h4" Color="Color.Info">
                        @GetPercentage()
                    </MudText>
                    <MudText Typo="Typo.body2">
                        Tỷ lệ đúng
                    </MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>

        <!-- Exam Details -->
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" />
                Thông tin bài thi
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Mã sinh viên:</MudText>
                    <MudText Typo="Typo.body1" Class="mb-2">@studentCode</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Mã đề thi:</MudText>
                    <MudText Typo="Typo.body1" Class="mb-2">@shuffledExamPaperId</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Tổng số câu:</MudText>
                    <MudText Typo="Typo.body1" Class="mb-2">@totalQuestions</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Thời gian nộp:</MudText>
                    <MudText Typo="Typo.body1" Class="mb-2">@endTime.ToString("dd/MM/yyyy HH:mm:ss")</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        <!-- Answer Summary -->
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.List" Class="mr-2" />
                Tóm tắt đáp án
            </MudText>
            <MudText Typo="Typo.body2" Class="mb-3">
                @studentAnswersString
            </MudText>
            <MudChip T="string" Color="Color.Info" Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-1" />
                Dấu "-" nghĩa là câu hỏi chưa được trả lời
            </MudChip>
        </MudPaper>

        <!-- Action Buttons -->
        <MudGrid Class="mt-6">
            <MudItem xs="12" md="6">
                <MudButton Variant="Variant.Outlined" 
                          Color="Color.Primary" 
                          FullWidth="true"
                          OnClick="ViewDetailedResults"
                          StartIcon="@Icons.Material.Filled.Assessment">
                    Xem chi tiết
                </MudButton>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Primary" 
                          FullWidth="true"
                          OnClick="GoBackToLogin"
                          StartIcon="@Icons.Material.Filled.Home">
                    Về trang chủ
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>
</MudContainer>

<style>
    .mud-main-content {
        padding: 0;
    }
</style> 