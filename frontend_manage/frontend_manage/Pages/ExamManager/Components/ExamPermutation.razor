@using MudBlazor
@using frontend_manage.Services.ExamManager
@using MudBlazor

<MudPaper Class="pa-4" Elevation="4">
    <MudText Typo="Typo.h6" Class="mb-2">Tạo đề hoán vị</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        <MudSelect T="string" 
                   @bind-Value="originalExamPaperCore" 
                   Label="Mã đề gốc" 
                   Variant="Variant.Outlined"
                   Style="min-width: 300px;"
                   Disabled="@isLoadingOriginalExams"
                   Placeholder="@(isLoadingOriginalExams ? "Đang tải..." : "-- Chọn mã đề gốc --")">
            @if (!isLoadingOriginalExams)
            {
                @foreach (var option in originalExamPaperOptions)
                {
                    <MudSelectItem Value="@option.Value">@option.Text</MudSelectItem>
                }
            }
        </MudSelect>
        <MudNumericField @bind-Value="count" Label="Số lượng hoán vị" Variant="Variant.Outlined" Min="1" Style="min-width: 150px;" />
        <MudButton Color="Color.Secondary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AutoAwesome" OnClick="CreateShuffledAsync" Disabled="isCreating || string.IsNullOrWhiteSpace(originalExamPaperCore) || count < 1">Tạo</MudButton>
        @if (isCreating)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
    </MudStack>

    @if (!string.IsNullOrEmpty(message))
    {
        <MudAlert Severity="@(message.StartsWith("Lỗi") ? Severity.Error : Severity.Success)" Class="mt-2">@message</MudAlert>
    }
</MudPaper>

@code { }


