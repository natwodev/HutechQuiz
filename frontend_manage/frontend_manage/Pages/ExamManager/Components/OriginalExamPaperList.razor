@using MudBlazor
@using frontend_manage.DTOs
@using frontend_manage.Services.ExamManager
@using Microsoft.JSInterop
@inject ExamManagerService ExamManagerService
@inject IJSRuntime JSRuntime
@inject AuthService AuthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Class="pa-4" Elevation="4">
    <MudText Typo="Typo.h6" Class="mb-3">Danh sách đề thi gốc</MudText>
    
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
    }
    
    @if (isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-3" />
        <MudText>Đang tải danh sách đề thi...</MudText>
    }
    else if (examPapers == null || examPapers.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Chưa có đề thi nào trong hệ thống.</MudAlert>
    }
    else
    {
        <MudTable Items="@examPapers" Hover="true" Dense="true" Striped="true" Bordered="true">
            <HeaderContent>
                <MudTh>Mã đề</MudTh>
                <MudTh>Tiêu đề</MudTh>
                <MudTh>Môn học</MudTh>
                <MudTh>Số câu</MudTh>
                <MudTh>Thời gian (phút)</MudTh>
                <MudTh>Đề hoán vị</MudTh>
                <MudTh>Thao tác</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Mã đề">@context.OriginalExamPaperCore</MudTd>
                <MudTd DataLabel="Tiêu đề">@context.Title</MudTd>
                <MudTd DataLabel="Môn học">@(context.SubjectName ?? "N/A")</MudTd>
                <MudTd DataLabel="Số câu">@context.TotalQuestions</MudTd>
                <MudTd DataLabel="Thời gian">@context.DurationMinutes</MudTd>
                <MudTd DataLabel="Đề hoán vị">@context.TotalShuffledPapers</MudTd>
                <MudTd DataLabel="Thao tác">
                    <div style="display: flex; gap: 8px; align-items: center;">
                        <MudButton 
                            Size="Size.Small" 
                            Variant="Variant.Text" 
                            Color="Color.Primary"
                            StartIcon="@Icons.Material.Filled.Visibility"
                            OnClick="() => ViewDetails(context.OriginalExamPaperCore)">
                            Xem chi tiết
                        </MudButton>
                        <MudButton 
                            Size="Size.Small" 
                            Variant="Variant.Text" 
                            Color="Color.Error"
                            StartIcon="@Icons.Material.Filled.Delete"
                            OnClick="() => ConfirmDelete(context.OriginalExamPaperId, context.OriginalExamPaperCore, context.TotalShuffledPapers)">
                            Xóa cứng
                        </MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<OriginalExamPaperListItemDto>? examPapers;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // Cho phép cả Admin và ExamManager xem danh sách
        var role = await AuthService.GetUserRoleFromToken();
        var canView = role == "Admin" || role == "ExamManager";
        
        if (!canView)
        {
            examPapers = new List<OriginalExamPaperListItemDto>();
            isLoading = false;
            errorMessage = "Bạn không có quyền xem danh sách đề thi gốc.";
            return;
        }

        await LoadExamPapers();
    }

    private async Task LoadExamPapers()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            examPapers = await ExamManagerService.GetAllOriginalExamPapersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải danh sách đề thi: {ex.Message}";
            examPapers = new List<OriginalExamPaperListItemDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ViewDetails(string core)
    {
        var uri = $"/exammanager/preview/original?core={Uri.EscapeDataString(core)}";
        await JSRuntime.InvokeVoidAsync("open", uri, "_blank");
    }

    /// <summary>
    /// Hiển thị dialog xác nhận xóa cứng đề thi gốc và các đề hoán vị liên quan
    /// </summary>
    /// <param name="originalExamPaperId">ID của đề thi gốc</param>
    /// <param name="originalExamPaperCore">Mã đề thi gốc</param>
    /// <param name="totalShuffledPapers">Số lượng đề hoán vị sẽ bị xóa</param>
    private async Task ConfirmDelete(int originalExamPaperId, string originalExamPaperCore, int totalShuffledPapers)
    {
        var parameters = new DialogParameters
        {
            ["OriginalExamPaperId"] = originalExamPaperId,
            ["OriginalExamPaperCore"] = originalExamPaperCore,
            ["TotalShuffledPapers"] = totalShuffledPapers
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<DeleteOriginalExamPaperDialog>(
            "Xác nhận xóa cứng đề thi gốc",
            parameters,
            options);

        var result = await dialog.Result;
        
        if (!result.Canceled && result.Data is bool deleteConfirmed && deleteConfirmed)
        {
            await DeleteOriginalExamPaper(originalExamPaperId);
        }
    }

    /// <summary>
    /// Xóa cứng đề thi gốc và tất cả các đề hoán vị liên quan
    /// </summary>
    /// <param name="originalExamPaperId">ID của đề thi gốc cần xóa</param>
    private async Task DeleteOriginalExamPaper(int originalExamPaperId)
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            await ExamManagerService.HardDeleteOriginalExamPaperAsync(originalExamPaperId);
            
            Snackbar.Add("Đã xóa cứng đề thi gốc và tất cả các đề hoán vị liên quan thành công", Severity.Success);
            
            // Reload danh sách đề thi
            await LoadExamPapers();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi xóa cứng đề thi gốc: {ex.Message}";
            Snackbar.Add(errorMessage, Severity.Error);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}

