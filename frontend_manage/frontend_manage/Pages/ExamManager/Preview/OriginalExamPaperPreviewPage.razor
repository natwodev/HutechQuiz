@page "/exammanager/preview/original"
@using frontend_manage.DTOs
@using frontend_manage.Pages.ExamManager.Components
@using frontend_manage.Pages.Exam.Components
@using frontend_manage.Pages.ExamManager.Preview.Components
@using frontend_manage.Components.MonitorLayout
@using System.Linq
@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms

<link href="css/exammanager/preview-page.css" rel="stylesheet" />
<link href="css/monitor/MonitorPage.css" rel="stylesheet" />

<div class="preview-page">
    <!-- Header -->
    <Header
        Subtitle="EXAM SUITE - ORIGINAL EXAM PREVIEW"
        EditionTag="Professional Edition"
        Description="Hệ thống xem trước đề thi gốc"
        ModeTag="Preview Mode">
    </Header>

    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-4 preview-page-container">
        <MudPaper Elevation="4" Class="pa-6">

        <!-- Exam Meta Information -->
                    <div class="preview-meta-card">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap;">
                        <div style="flex: 1; min-width: 300px;">
                            <div class="preview-meta-row">
                                <span class="preview-meta-label">Mã đề gốc:</span>
                                <span class="preview-meta-value">@Exam?.OriginalExamPaperCore</span>
                        @if (!string.IsNullOrWhiteSpace(Exam?.OriginalExamPaperCore))
                        {
                            <MudIconButton 
                                Icon="@Icons.Material.Filled.QrCode" 
                                Color="Color.Primary" 
                                Size="Size.Small"
                                OnClick="ToggleQRCodeDisplay"
                                Title="Hiển thị/Ẩn QR Code" />
                        }
                            </div>
                            <div class="preview-meta-row">
                                <span class="preview-meta-label">Tiêu đề:</span>
                                <span class="preview-meta-value">@Exam?.Title</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Exam?.Description))
                            {
                                <div class="preview-meta-row">
                                    <span class="preview-meta-label">Mô tả:</span>
                                    <span class="preview-meta-value">@Exam?.Description</span>
                                </div>
                            }
                            <div class="preview-meta-row">
                                <span class="preview-meta-label">Môn học:</span>
                                <span class="preview-meta-value">@GetSubjectName(Exam?.SubjectId ?? 0)</span>
                            </div>
                            <div class="preview-meta-row">
                                <span class="preview-meta-label">Thời gian làm bài:</span>
                                <span class="preview-meta-value">@(Exam?.DurationMinutes ?? 0) phút</span>
                            </div>
                            <div class="preview-meta-row">
                                <span class="preview-meta-label">Tổng số câu:</span>
                                <span class="preview-meta-value">@(GetTotalQuestionsCount())</span>
                            </div>
                            <div class="preview-meta-row">
                                <span class="preview-meta-label">Loại đề thi:</span>
                                <span class="preview-meta-value">@(Exam?.IsManualCreated == true ? "Tạo thủ công" : "Import từ file")</span>
                            </div>
                        </div>
                        <div class="preview-action-buttons">
                    <MudButton 
                        Color="Color.Success" 
                        Variant="Variant.Filled"
                        OnClick="ToggleAddQuestionMode"
                        Disabled="@IsAddQuestionButtonDisabled"
                        StartIcon="@Icons.Material.Filled.Add">
                        @(isAddQuestionMode ? "Hủy" : "Thêm câu hỏi")
                    </MudButton>
                    <MudButton 
                        Color="Color.Primary" 
                        Variant="Variant.Filled"
                        OnClick="ToggleEditMode" 
                        Disabled="@(isUpdating || isAddQuestionMode || editingQuestionId.HasValue)">
                        @(isEditMode ? "Hủy" : "Chỉnh sửa")
                    </MudButton>
                        </div>
                    </div>

            @if (showQRCode && !string.IsNullOrEmpty(qrCodeBase64))
            {
                <div class="preview-qr-container">
                    <div class="preview-qr-title">Mã QR Code - Mã đề gốc</div>
                    <img src="data:image/png;base64,@qrCodeBase64" alt="QR Code" class="preview-qr-image" />
                    <div class="preview-qr-code-text">Mã đề: @Exam?.OriginalExamPaperCore</div>
                </div>
            }

            @if (isEditMode)
            {
                <MudDivider Class="my-4" />
                <MudPaper Elevation="0" Class="pa-4" Style="background: #f9f9f9;">
                    <MudStack Spacing="3">
                        <MudTextField 
                            Label="Tiêu đề" 
                            Variant="Variant.Outlined" 
                            @bind-Value="editRequest.Title" 
                            Immediate="true" />
                        <MudTextField 
                            Label="Mô tả" 
                            Variant="Variant.Outlined" 
                            Lines="3" 
                            @bind-Value="editRequest.Description" 
                            Immediate="true" />
                        <MudSelect T="int"
                            Label="Môn học" 
                            Variant="Variant.Outlined" 
                            @bind-Value="editRequest.SubjectId"
                            Immediate="true">
                            @foreach (var subject in subjects)
                            {
                                <MudSelectItem T="int" Value="@subject.SubjectId">@subject.SubjectName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField 
                            Label="Thời gian làm bài (phút)" 
                            Variant="Variant.Outlined" 
                            @bind-Value="editRequest.DurationMinutes" 
                            Min="1"
                            Immediate="true" />
                        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                            <MudButton 
                                Color="Color.Success" 
                                Variant="Variant.Filled"
                                OnClick="HandleSave" 
                                Disabled="@isUpdating"
                                StartIcon="@Icons.Material.Filled.Save">
                                @if (isUpdating)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                    <MudText Class="ms-2">Đang lưu...</MudText>
                                }
                                else
                                {
                                    <MudText>Lưu</MudText>
                                }
                            </MudButton>
                            <MudButton 
                                Color="Color.Default" 
                                Variant="Variant.Text"
                                OnClick="ToggleEditMode" 
                                Disabled="@isUpdating">
                                Hủy
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudPaper>
            }

            @if (isAddQuestionMode)
            {
                <MudDivider Class="my-4" />
                <MudPaper Elevation="0" Class="pa-4" Style="background: #f9f9f9;">
                    <MudStack Spacing="3">
                        <MudText Typo="Typo.h6" Color="Color.Success">Thêm câu hỏi mới</MudText>
                        
                        <EditForm Model="@questionRequest" OnValidSubmit="AddQuestionAsync">
                            <DataAnnotationsValidator />
                            
                            <MudStack Spacing="3">
                                <MudNumericField @bind-Value="questionRequest.Order" 
                                                 Label="Thứ tự câu hỏi" 
                                                 Variant="Variant.Outlined"
                                                 Required="true"
                                                 RequiredError="Thứ tự là bắt buộc"
                                                 Min="1"
                                                 HelperText="Số thứ tự của câu hỏi trong đề thi" />
                                
                                <MudTextField @bind-Value="questionRequest.QuestionContent" 
                                              Label="Nội dung câu hỏi" 
                                              Variant="Variant.Outlined"
                                              Lines="3"
                                              HelperText="Nhập nội dung câu hỏi" />
                                
                                <MudNumericField @bind-Value="questionRequest.CorrectAnswerIndex" 
                                                 Label="Đáp án đúng (chỉ số)" 
                                                 Variant="Variant.Outlined"
                                                 Min="1"
                                                 HelperText="Chỉ số của đáp án đúng (1, 2, 3, ...)" />
                                
                                <MudCheckBox @bind-Value="questionRequest.CanShuffleQuestion" 
                                             Label="Cho phép hoán vị câu hỏi"
                                             Color="Color.Primary" />
                                
                                <MudDivider />
                                <MudText Typo="Typo.subtitle1">Đáp án</MudText>
                                
                                @for (int i = 0; i < questionRequest.Answers.Count; i++)
                                {
                                    var index = i;
                                    <MudPaper Class="pa-3" Elevation="1">
                                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                            <MudText Typo="Typo.body1" Class="mt-2" Style="min-width: 100px;">
                                                <strong>Đáp án @(index + 1):</strong>
                                            </MudText>
                                            <MudTextField @bind-Value="questionRequest.Answers[index].AnswerContent" 
                                                          Label="Nội dung đáp án" 
                                                          Variant="Variant.Outlined"
                                                          Required="true"
                                                          RequiredError="Nội dung đáp án là bắt buộc"
                                                          Style="flex: 1;" />
                                            <MudCheckBox @bind-Value="questionRequest.Answers[index].IsCorrect" 
                                                         Label="Đáp án đúng"
                                                         Color="Color.Success"
                                                         Class="mt-2" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                           Color="Color.Error" 
                                                           OnClick="() => RemoveAnswer(index)"
                                                           Disabled="questionRequest.Answers.Count <= 2"
                                                           Class="mt-1" />
                                        </MudStack>
                                    </MudPaper>
                                }
                                
                                <MudButton Color="Color.Secondary" 
                                           Variant="Variant.Outlined" 
                                           StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddAnswer"
                                           Type="ButtonType.Button">
                                    Thêm đáp án
                                </MudButton>
                                
                                @if (!string.IsNullOrEmpty(questionMessage))
                                {
                                    <MudAlert Severity="@(questionMessage.StartsWith("Lỗi") ? Severity.Error : Severity.Success)" 
                                              Dismissible="true"
                                              OnClose="() => questionMessage = string.Empty">
                                        @questionMessage
                                    </MudAlert>
                                }
                                
                                <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                                    <MudButton 
                                        Color="Color.Success" 
                                        Variant="Variant.Filled"
                                        ButtonType="ButtonType.Submit"
                                        Disabled="@isAddingQuestion"
                                        StartIcon="@Icons.Material.Filled.Save">
                                        @if (isAddingQuestion)
                                        {
                                            <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                            <MudText Class="ms-2">Đang thêm...</MudText>
                                        }
                                        else
                                        {
                                            <MudText>Thêm câu hỏi</MudText>
                                        }
                                    </MudButton>
                                    <MudButton 
                                        Color="Color.Default" 
                                        Variant="Variant.Text"
                                        OnClick="ToggleAddQuestionMode" 
                                        Disabled="@isAddingQuestion">
                                        Hủy
                                    </MudButton>
                                </MudStack>
                            </MudStack>
                        </EditForm>
                    </MudStack>
                </MudPaper>
            }
                    </div>

        <MudDivider Class="my-4" />

        <!-- Questions Preview -->
        <div class="preview-questions-list">
            @if (Exam?.Details != null && Exam.Details.Count > 0)
            {
                var flatQuestions = GetFlatQuestions();
                var groupParents = GetGroupParentQuestions();
                
                @for (int i = 0; i < flatQuestions.Count; i++)
                {
                    var q = flatQuestions[i];
                    // Xác định xem có phải là matching question không
                    var isMatchingParent = IsMatchingParent(q);
                    // Xác định xem có phải là parent question không (có child questions nhưng không phải matching)
                    var isParentQuestion = q.ParentQuestionId == null && q.ChildQuestions != null && q.ChildQuestions.Count > 0 && !isMatchingParent;
                    // Bỏ qua parent question thông thường ở đây (sẽ render riêng ở section group questions)
                    if (isParentQuestion)
                    {
                        continue;
                    }
                    // Lấy số thứ tự của câu hỏi
                    var questionNumber = GetQuestionNumber(q, i);
                    
                    <div class="preview-question-container">
                        @if (editingQuestionId == q.OriginalExamPaperDetailId)
                        {
                            <!-- Form chỉnh sửa câu hỏi -->
                            <MudStack Spacing="3">
                                <MudText Typo="Typo.h6" Color="Color.Primary">Chỉnh sửa câu hỏi</MudText>
                                
                                <EditForm Model="@editQuestionRequest" OnValidSubmit="UpdateQuestionAsync">
                                    <DataAnnotationsValidator />
                                    
                                    <MudStack Spacing="3">
                                        <MudNumericField @bind-Value="editQuestionRequest.Order" 
                                                         Label="Thứ tự câu hỏi" 
                                                         Variant="Variant.Outlined"
                                                         Required="true"
                                                         RequiredError="Thứ tự là bắt buộc"
                                                         Min="1"
                                                         HelperText="Số thứ tự của câu hỏi trong đề thi" />
                                        
                                        <MudTextField @bind-Value="editQuestionRequest.QuestionContent" 
                                                      Label="Nội dung câu hỏi" 
                                                      Variant="Variant.Outlined"
                                                      Lines="3"
                                                      HelperText="Nhập nội dung câu hỏi" />
                                        
                                        <MudNumericField @bind-Value="editQuestionRequest.CorrectAnswerIndex" 
                                                         Label="Đáp án đúng (chỉ số)" 
                                                         Variant="Variant.Outlined"
                                                         Min="1"
                                                         HelperText="Chỉ số của đáp án đúng (1, 2, 3, ...)" />
                                        
                                        <MudCheckBox @bind-Value="editQuestionRequest.CanShuffleQuestion" 
                                                     Label="Cho phép hoán vị câu hỏi"
                                                     Color="Color.Primary" />
                                        
                                        <MudDivider />
                                        <MudText Typo="Typo.subtitle1">Đáp án</MudText>
                                        
                                        @for (int j = 0; j < editQuestionRequest.Answers.Count; j++)
                                        {
                                            var answerIndex = j;
                                            <MudPaper Class="pa-3" Elevation="1">
                                                <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                                    <MudText Typo="Typo.body1" Class="mt-2" Style="min-width: 100px;">
                                                        <strong>Đáp án @(answerIndex + 1):</strong>
                                                    </MudText>
                                                    <MudTextField @bind-Value="editQuestionRequest.Answers[answerIndex].AnswerContent" 
                                                                  Label="Nội dung đáp án" 
                                                                  Variant="Variant.Outlined"
                                                                  Required="true"
                                                                  RequiredError="Nội dung đáp án là bắt buộc"
                                                                  Style="flex: 1;" />
                                                    <MudCheckBox @bind-Value="editQuestionRequest.Answers[answerIndex].IsCorrect" 
                                                                 Label="Đáp án đúng"
                                                                 Color="Color.Success"
                                                                 Class="mt-2" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                                   Color="Color.Error" 
                                                                   OnClick="() => RemoveEditAnswer(answerIndex)"
                                                                   Disabled="editQuestionRequest.Answers.Count <= 2"
                                                                   Class="mt-1" />
                                                </MudStack>
                                            </MudPaper>
                                        }
                                        
                                        <MudButton Color="Color.Secondary" 
                                                   Variant="Variant.Outlined" 
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   OnClick="AddEditAnswer"
                                                   Type="ButtonType.Button">
                                            Thêm đáp án
                                        </MudButton>
                                        
                                        @if (!string.IsNullOrEmpty(editQuestionMessage))
                                        {
                                            <MudAlert Severity="@(editQuestionMessage.StartsWith("Lỗi") ? Severity.Error : Severity.Success)" 
                                                      Dismissible="true"
                                                      OnClose="() => editQuestionMessage = string.Empty">
                                                @editQuestionMessage
                                            </MudAlert>
                                        }
                                        
                                        <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                                            <MudButton 
                                                Color="Color.Primary" 
                                                Variant="Variant.Filled"
                                                ButtonType="ButtonType.Submit"
                                                Disabled="@isUpdatingQuestion"
                                                StartIcon="@Icons.Material.Filled.Save">
                                                @if (isUpdatingQuestion)
                                                {
                                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                                                    <MudText Class="ms-2">Đang lưu...</MudText>
                                                }
                                                else
                                                {
                                                    <MudText>Lưu</MudText>
                                                }
                                            </MudButton>
                                            <MudButton 
                                                Color="Color.Default" 
                                                Variant="Variant.Text"
                                                OnClick="CloseEditQuestion" 
                                                Disabled="@isUpdatingQuestion">
                                                Hủy
                                            </MudButton>
                                        </MudStack>
                                    </MudStack>
                                </EditForm>
                            </MudStack>
                        }
                        else
                        {
                            <!-- Hiển thị câu hỏi -->
                            <MudStack Spacing="2" Style="@(isMatchingParent ? "display: block !important;" : "")">
                                <div class="preview-question-header">
                                    <div class="preview-question-number">
                                        @if (questionNumber.HasValue)
                                        {
                                            <span class="preview-question-number-chip">@questionNumber.Value</span>
                                        }
                                        <span class="preview-question-title">
                                            Câu hỏi
                                        </span>
                                    </div>
                                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Color="Color.Default">
                                        <MudMenuItem OnClick="() => OpenEditQuestion(q.OriginalExamPaperDetailId)">
                                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-2" />
                                            Sửa
                                        </MudMenuItem>
                                        <MudMenuItem OnClick="() => DeleteQuestion(q.OriginalExamPaperDetailId)" Disabled="true">
                                            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-2" />
                                            Xóa
                                        </MudMenuItem>
                                    </MudMenu>
                                </div>
                                <div class="katex-content question-content-preview">
                                    @((MarkupString)RenderHtml(q.QuestionContent))
                                </div>
                                
                                @if (isMatchingParent)
                                {
                                    @* Render matching question với 2 cột và đường nối *@
                                    var leftItems = GetMatchingLeftItems(q);
                                    var rightItems = GetMatchingRightItems(q);
                                    var correctPairs = GetMatchingCorrectPairs(q);
                                    <div class="preview-matching-container">
                                        <MatchingQuestion LeftItems="@leftItems" 
                                                        RightItems="@rightItems" 
                                                        OnPair="@((pair) => { })"
                                                        OriginalExamPaperCore="@Exam?.OriginalExamPaperCore"
                                                        IsPreviewMode="true"
                                                        CorrectPairs="@correctPairs" />
                                    </div>
                                }
                                else if (q.Answers != null && q.Answers.Count > 0)
                                {
                                    <div class="answers-preview">
                                        @foreach (var ans in q.Answers.OrderBy(a => a.Order))
                                        {
                                            <div class="answer-preview-item @(ans.IsCorrect ? "answer-correct" : "")">
                                                <span class="answer-letter-preview">@GetLetter(ans.Order).</span>
                                                <div class="katex-content answer-text-preview">
                                                    @((MarkupString)RenderHtml(ans.AnswerContent))
                                                </div>
                                                @if (ans.IsCorrect)
                                                {
                                                    <span class="answer-correct-badge">Đúng</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </MudStack>
                        }
                    </div>
                }
                
                @* Render Group Questions (Parent-Child Questions không phải matching) *@
                @foreach (var groupParent in groupParents)
                {
                    var parentNumber = GetGroupParentNumber(groupParent);
                    var childRange = GetChildQuestionsRange(groupParent);
                    var startNumber = childRange.start;
                    var endNumber = childRange.end;
                    
                    // Thử trích xuất range từ nội dung nếu có pattern {<...>}
                    var extractedRange = ExtractGroupRange(groupParent.QuestionContent ?? string.Empty);
                    if (extractedRange.start.HasValue && extractedRange.end.HasValue)
                    {
                        startNumber = extractedRange.start.Value;
                        endNumber = extractedRange.end.Value;
                    }
                    
                    <GroupQuestion ParentContent="@groupParent.QuestionContent"
                                   ChildQuestions="@groupParent.ChildQuestions"
                                   ParentNumber="@parentNumber"
                                   StartNumber="@startNumber"
                                   EndNumber="@endNumber"
                                   ShowMenu="true"
                                   OnEdit="@(() => OpenEditQuestion(groupParent.OriginalExamPaperDetailId))"
                                   OnDelete="@(() => DeleteQuestion(groupParent.OriginalExamPaperDetailId))"
                                   GetChildNumber="@((child) => GetChildQuestionNumber(child, groupParent))"
                                   OriginalExamPaperCore="@Exam?.OriginalExamPaperCore" />
                }
            }
            else if (isLoading)
            {
                <div class="preview-loading-container">
                    <MudProgressCircular Indeterminate="true" />
                    <div class="preview-loading-text">Đang tải chi tiết đề...</div>
                </div>
            }
            else
            {
                <div class="preview-empty-container">
                    <MudAlert Severity="Severity.Info" Class="text-center">
                        Không có dữ liệu câu hỏi cho đề này.
                    </MudAlert>
                </div>
            }
        </div>
        </MudPaper>
    </MudContainer>

    <!-- Footer -->
    <Footer
        ModeLabel="Exam Preview System"
        Version="1.0.1"
        DevelopedBy="Developed by Natwodev & Juo"
        ShowClock="true" />
</div>
