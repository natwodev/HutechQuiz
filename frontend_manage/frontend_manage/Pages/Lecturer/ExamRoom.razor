@page "/lecturer/exam-room"
@using frontend_manage.DTOs
@using frontend_manage.Services
@using frontend_manage.Pages.Lecturer
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject Api LecturerApi
@inject IJSRuntime JSRuntime

<PageTitle>Chi tiết phòng thi</PageTitle>

<!-- Header -->
<div class="bg-primary text-white p-3 mb-4 rounded shadow-sm d-flex justify-content-between align-items-center">
    <div>
        <h2 class="mb-0">Chi tiết phòng thi</h2>
        <small>@(selectedRoom?.SubjectName ?? "Đang tải...") - @(selectedRoom?.RoomName ?? "")</small>
    </div>
    <div>
        <button class="btn btn-outline-light btn-sm me-2" @onclick="GoBack">
            <i class="fas fa-arrow-left"></i> Quay lại
        </button>
        <button class="btn btn-outline-light btn-sm" @onclick="RefreshData">
            <i class="fas fa-sync-alt"></i> Làm mới
        </button>
    </div>
</div>

<!-- Nội dung chính -->
<div class="container-fluid">
    <!-- Loading -->
    <div class="text-center text-secondary" hidden="@(!isLoading)">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2">Đang tải dữ liệu...</p>
    </div>

    <!-- Lỗi -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    <!-- Thông báo thành công -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <!-- Thông tin phòng thi -->
    @if (selectedRoom != null)
    {
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Thông tin phòng thi</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-borderless">
                            <tr>
                                <td><strong>Môn học:</strong></td>
                                <td>@selectedRoom.SubjectName</td>
                            </tr>
                            <tr>
                                <td><strong>Phòng thi:</strong></td>
                                <td>@selectedRoom.RoomName</td>
                            </tr>
                            <tr>
                                <td><strong>Giảng viên:</strong></td>
                                <td>@selectedRoom.LecturerName</td>
                            </tr>
                            <tr>
                                <td><strong>Trạng thái:</strong></td>
                                <td>
                                    <span class="badge @GetStatusBadgeClass(selectedRoom.ExamStatus)">
                                        @GetStatusText(selectedRoom.ExamStatus)
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Thống kê sinh viên</h5>
                    </div>
                    <div class="card-body">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="border rounded p-3">
                                    <h4 class="text-primary mb-0">@(students?.Count ?? 0)</h4>
                                    <small class="text-muted">Tổng số</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border rounded p-3">
                                    <h4 class="text-success mb-0">@(students?.Count(s => s.IsLogin) ?? 0)</h4>
                                    <small class="text-muted">Đã đăng nhập</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="border rounded p-3">
                                    <h4 class="text-warning mb-0">@(students?.Count(s => s.IsCompleted) ?? 0)</h4>
                                    <small class="text-muted">Đã hoàn thành</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Các nút thao tác -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Thao tác</h5>
                    </div>
                    <div class="card-body">
                        <button class="btn btn-primary me-2" @onclick="SendNotification">
                            <i class="fas fa-bell"></i> Gửi thông báo
                        </button>
                        <button class="btn btn-warning me-2" @onclick="LogoutAllStudents">
                            <i class="fas fa-sign-out-alt"></i> Logout tất cả sinh viên
                        </button>
                        <button class="btn btn-info" @onclick="ExportStudentList">
                            <i class="fas fa-download"></i> Xuất danh sách
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Danh sách sinh viên -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Danh sách sinh viên</h5>
                <div>
                    <input type="text" class="form-control form-control-sm" 
                           placeholder="Tìm kiếm sinh viên..." 
                           @bind="searchTerm" 
                           @bind:event="oninput" />
                </div>
            </div>
            <div class="card-body">
                @if (isLoadingStudents)
                {
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2">Đang tải danh sách sinh viên...</p>
                    </div>
                }
                else if (students == null || !students.Any())
                {
                    <div class="alert alert-info">Không có sinh viên nào trong phòng thi này.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã sinh viên</th>
                                    <th>Họ và tên</th>
                                    <th>Trạng thái đăng nhập</th>
                                    <th>Trạng thái thi</th>
                                    <th>Thời gian bắt đầu</th>
                                    <th>Thời gian kết thúc</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in filteredStudents)
                                {
                                    <tr>
                                        <td>@student.StudentCode</td>
                                        <td>@student.LastName @student.FirstName</td>
                                        <td>
                                            <span class="badge @(student.IsLogin ? "bg-success" : "bg-secondary")">
                                                @(student.IsLogin ? "Đã đăng nhập" : "Chưa đăng nhập")
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge @(student.IsCompleted ? "bg-success" : "bg-warning")">
                                                @(student.IsCompleted ? "Đã hoàn thành" : "Đang thi")
                                            </span>
                                        </td>
                                        <td>
                                            @if (student.StartTime.HasValue)
                                            {
                                                @student.StartTime.Value.ToString("HH:mm:ss")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (student.EndTime.HasValue)
                                            {
                                                @student.EndTime.Value.ToString("HH:mm:ss")
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (student.IsLogin && !student.IsCompleted)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" 
                                                        @onclick="() => LogoutStudent(student.StudentCode)">
                                                    <i class="fas fa-sign-out-alt"></i> Logout
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int? examRoomId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery]
    public int? examSessionSubjectId { get; set; }

    private bool isLecturer;
    private bool isLecturerChecked = false;
    private bool isLoading = false;
    private bool isLoadingStudents = false;
    private LecturerExamRoomDto? selectedRoom;
    private List<StudentExamRoomStatusDto>? students;
    private string? errorMessage;
    private string? successMessage;
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        isLecturer = await AuthService.IsLecturer();
        isLecturerChecked = true;
        if (!isLecturer)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (examRoomId.HasValue && examSessionSubjectId.HasValue)
        {
            await LoadExamRoomData();
        }
        else
        {
            errorMessage = "Thiếu thông tin phòng thi";
        }
    }

    private async Task LoadExamRoomData()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            // Tạm thời tạo dữ liệu mẫu cho selectedRoom
            selectedRoom = new LecturerExamRoomDto
            {
                ExamRoomId = examRoomId.Value,
                ExamSessionSubjectId = examSessionSubjectId.Value,
                RoomName = $"Phòng {examRoomId}",
                SubjectName = "Môn học mẫu",
                LecturerName = "Giảng viên mẫu",
                ExamStatus = "ongoing"
            };

            await LoadStudents();
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải dữ liệu: {ex.Message}";
        }
        isLoading = false;
    }

    private async Task LoadStudents()
    {
        if (!examRoomId.HasValue || !examSessionSubjectId.HasValue) return;

        isLoadingStudents = true;
        try
        {
            students = await LecturerApi.GetStudentsByExamRoomAsync(examRoomId.Value, examSessionSubjectId.Value);
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi tải danh sách sinh viên: {ex.Message}";
            students = null;
        }
        isLoadingStudents = false;
    }

    private async Task SendNotification()
    {
        try
        {
            var message = await JSRuntime.InvokeAsync<string>("prompt", "Nhập thông báo:");
            if (!string.IsNullOrEmpty(message))
            {
                var result = await LecturerApi.SendNotificationToRoomAsync(examRoomId.Value, message);
                successMessage = result;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi gửi thông báo: {ex.Message}";
        }
    }

    private async Task LogoutStudent(string studentCode)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Bạn có chắc muốn logout sinh viên {studentCode}?"))
            return;

        try
        {
            var result = await LecturerApi.LogoutStudentAsync(studentCode, examRoomId.Value);
            successMessage = result;
            await LoadStudents(); // Reload danh sách
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi logout sinh viên: {ex.Message}";
        }
    }

    private async Task LogoutAllStudents()
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Bạn có chắc muốn logout tất cả sinh viên trong phòng thi?"))
            return;

        try
        {
            var result = await LecturerApi.LogoutAllStudentsInRoomAsync(examRoomId.Value);
            successMessage = result;
            await LoadStudents(); // Reload danh sách
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi logout sinh viên: {ex.Message}";
        }
    }

    private async Task ExportStudentList()
    {
        try
        {
            // Tạo nội dung CSV
            var csvContent = "Mã sinh viên,Họ và tên,Trạng thái đăng nhập,Trạng thái thi,Thời gian bắt đầu,Thời gian kết thúc\n";
            
            if (students != null)
            {
                foreach (var student in students)
                {
                    csvContent += $"{student.StudentCode},{student.LastName} {student.FirstName}," +
                                 $"{(student.IsLogin ? "Đã đăng nhập" : "Chưa đăng nhập")}," +
                                 $"{(student.IsCompleted ? "Đã hoàn thành" : "Đang thi")}," +
                                 $"{(student.StartTime?.ToString("HH:mm:ss") ?? "-")}," +
                                 $"{(student.EndTime?.ToString("HH:mm:ss") ?? "-")}\n";
                }
            }

            // Tạo và download file
            var fileName = $"danh_sach_sinh_vien_phong_{examRoomId}_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, csvContent);
            successMessage = "Đã xuất danh sách sinh viên thành công";
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi khi xuất danh sách: {ex.Message}";
        }
    }

    private async Task RefreshData()
    {
        await LoadStudents();
        successMessage = "Đã làm mới dữ liệu";
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/lecturer/dashboard");
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "pending" => "bg-warning",
            "ongoing" => "bg-success",
            "completed" => "bg-secondary",
            _ => "bg-light"
        };
    }

    private string GetStatusText(string status)
    {
        return status switch
        {
            "pending" => "Chờ thi",
            "ongoing" => "Đang thi",
            "completed" => "Đã kết thúc",
            _ => "Không xác định"
        };
    }

    private IEnumerable<StudentExamRoomStatusDto> filteredStudents
    {
        get
        {
            if (students == null) return Enumerable.Empty<StudentExamRoomStatusDto>();
            
            if (string.IsNullOrWhiteSpace(searchTerm))
                return students;

            return students.Where(s => 
                s.StudentCode.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                s.FirstName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                s.LastName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            );
        }
    }
} 