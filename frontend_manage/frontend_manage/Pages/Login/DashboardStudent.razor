@page "/student-dashboard"
@using frontend_manage.Services
@using FrontEnd.DTOs
@using frontend_manage.Pages.Login
@using MudBlazor

<ExamNotification />

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex justify-center align-center" Style="height: 100vh;">
    <MudCard Class="pa-6" Elevation="3" Style="margin: auto; text-align: center; width: 100%">
        <!-- Logo -->
        <MudCardContent Class="d-flex justify-center">
            <MudImage Src="images/exam/Logo.svg" Width="200" />
        </MudCardContent>
        <MudGrid>
            <MudItem xs="4">
                <MudCardHeader>
                    <MudAvatar Size="Size.Large" Icon="@Icons.Material.Filled.Person" Color="Color.Primary" Style="width: 120px; height: 120px; border-radius: 50%;" />
                </MudCardHeader>
            </MudItem>
            <MudItem xs="8">
                <MudCardContent Style="padding-bottom:0">
                    @if (studentInfo != null)
                    {
                        <MudText Style="margin-bottom: 2%" Align="Align.Left" Typo="Typo.subtitle1">Mã số sinh viên: @studentInfo.StudentCode</MudText>
                        <MudText Style="margin-bottom: 2%" Align="Align.Left" Typo="Typo.subtitle1">Họ và tên: @studentInfo.LastName @studentInfo.FirstName</MudText>
                        <MudText Style="margin-bottom: 2%" Align="Align.Left" Typo="Typo.subtitle1">Thời gian hiện tại: @currentTime</MudText>
                    }
                </MudCardContent>
            </MudItem>
        </MudGrid>
        <MudCardActions Style="display: flex; justify-content: center;">
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Logout" Color="Color.Error" OnClick="Logout">Đăng xuất</MudButton>
        </MudCardActions>

        <MudDivider Class="my-3" />
        <MudCardContent>
            <MudText Typo="Typo.subtitle1" Style="font-weight:bold">Danh sách ca thi của bạn</MudText>
            @if (examSessions == null)
            {
                <MudProgressCircular Indeterminate Color="Color.Primary" />
                <MudText>Đang tải dữ liệu ca thi...</MudText>
            }
            else if (examSessions.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Filled">Bạn chưa có ca thi nào.</MudAlert>
            }
            else
            {
                <MudList T="object" Dense="true">
                    @foreach (var session in examSessions)
                    {
                        <MudListItem T="object">
                            <MudText Typo="Typo.subtitle2"><b>@session.SubjectName</b></MudText>
                            <MudText>Phòng: <b>@session.RoomName</b> | Thời lượng: <b>@session.Duration phút</b> | Bắt đầu: <b>@(session.StartTime.ToString("HH:mm dd/MM/yyyy"))</b></MudText>
                        </MudListItem>
                    }
                </MudList>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    // ... giữ nguyên code-behind, không thay đổi logic ...
}
