@page "/student-dashboard"
@using frontend_manage.Services
@using FrontEnd.DTOs
@using frontend_manage.Pages.Login
<link href="css/info/info.css" rel="stylesheet" />

<ExamNotification />

<div class="dashboard-student-center">
    <div class="component-thong-tin">
        <div class="overlap">
            <!-- Logo trường -->
            <img src="images/exam/Logo.svg" class="logo" />

            <!-- Thông tin sinh viên -->
            <div class="student-info-wrapper">
                <img src="images/exam/ava.jpg" class="avatar" />

                <div class="student-info">
                    @if (studentInfo != null)
                    {
                        <div class="id">Mã số sinh viên: @studentInfo.StudentCode</div>
                        <div class="name">Họ và tên: @($"{studentInfo.LastName} {studentInfo.FirstName}")</div>
                    }
                    <div class="time">Thời gian hiện tại: @currentTime</div>
                    <button class="button-sign-out" @onclick="Logout">
                        <span><span>&#x2190;</span> ĐĂNG XUẤT</span>
                    </button>
                </div>
            </div>

            <!-- Exam Sessions Cards inside the same component-thong-tin -->
            <div style="margin-top: 2rem;">
                <h4>Danh sách ca thi của bạn</h4>
                @if (examSessions == null)
                {
                    <div>Đang tải dữ liệu ca thi...</div>
                }
                else if (examSessions.Count == 0)
                {
                    <div>Bạn chưa có ca thi nào.</div>
                }
                else
                {
                    <div class="exam-session-list">
                        @foreach (var session in examSessions)
                        {
                            <div class="exam-session-card">
                                <div class="exam-session-title">@session.SubjectName</div>
                                <div class="exam-session-details">
                                    <span>Phòng: @session.RoomName</span>
                                    <span>Thời lượng: @session.Duration phút</span>
                                    <span>Bắt đầu: @session.StartTime.ToString("HH:mm dd/MM/yyyy")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

