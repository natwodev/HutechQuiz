@using MudBlazor
@using System

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Timer" Class="mr-2" />
            Thêm thời gian thi
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Thêm thời gian cho sinh viên: <strong>@StudentCode</strong>
                </MudAlert>
            </MudItem>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Warning" Class="mb-4">
                    Thời gian thêm không được quá 30% giờ thi
                </MudAlert>
            </MudItem>
            <MudItem xs="12">
                <MudNumericField @bind-Value="ExtraMinutes" Label="Số phút cộng thêm"
                                 Variant="Variant.Outlined" Required="true"
                                 Min="1" Max="@MaxExtraMinutes" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="Reason" Label="Lý do"
                              Variant="Variant.Outlined"
                              Lines="3"
                              MaxLength="200"
                              Counter="200"
                              Placeholder="Nhập lý do cộng thêm thời gian..." />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text" Color="Color.Default" Class="mr-2">Huỷ bỏ</MudButton>
        <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary">
            Xác nhận
        </MudButton>
    </DialogActions>
</MudDialog>