@using frontend_manage.Services
@using frontend_manage.DTOs
@using frontend_manage.Pages.Monitor.Components
@using frontend_manage.Enums
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.SignalR.Client
@using MudBlazor
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks

<link href="css/monitor/StudentListTab.css" rel="stylesheet" />

<div class="student-list-tab">
    <div class="student-list-header">
        <div class="title-area">
            <h2>DANH SÁCH SINH VIÊN</h2>
            @if (Students != null && Students.Any())
            {
                <div class="exam-info">
                    Ca thi: <strong>@(ExamSessionName ?? ExamSessionSubjectId?.ToString() ?? "N/A")</strong> | 
                    Số sinh viên: <strong>@Students.Count</strong>
                </div>
            }
        </div>
        <div class="search-area">
            <MudButton Variant="Variant.Filled" Color="Color.Success" Class="excel-button" Size="Size.Small" OnClick="ExportStudentGradesToExcelAsync" Disabled="@(Students == null || !Students.Any())">
                <MudIcon Icon="@Icons.Material.Filled.TableChart" Class="mr-1" />
                Tải danh sách bảng điểm
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" Class="mx-2" Size="Size.Small" OnClick="() => ToggleIsLoginForAllStudentsAsync(true)" Disabled="@(Students == null || !Students.Any())">
                <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-1" />
                Khóa đăng nhập tất cả
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Class="mx-2" Size="Size.Small" OnClick="() => ToggleIsLoginForAllStudentsAsync(false)" Disabled="@(Students == null || !Students.Any())">
                <MudIcon Icon="@Icons.Material.Filled.LockOpen" Class="mr-1" />
                Mở đăng nhập tất cả
            </MudButton>
            <div class="search-input-wrapper">
                <MudIcon Icon="@Icons.Material.Filled.Search" Class="search-icon" Size="Size.Small"/>
                <input type="text" class="search-input" placeholder="Tìm kiếm theo mã SV hoặc họ tên..." @bind="searchText" @bind:event="oninput"/>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="search-button" Size="Size.Small" OnClick="PerformSearch">Tìm kiếm</MudButton>
        </div>
    </div>

    @if (Students != null && Students.Any())
    {
        <div class="stats-cards">
            <div class="stat-card">
                <div class="stat-icon blue">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" />
                </div>
                <div class="stat-content">
                    <div class="stat-value">@TotalStudents</div>
                    <div class="stat-label">Tổng số SV</div>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon green">
                    <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Large" />
                </div>
                <div class="stat-content">
                    <div class="stat-value">@LoggedInStudents</div>
                    <div class="stat-label">Đã đăng nhập</div>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon amber">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Large" />
                </div>
                <div class="stat-content">
                    <div class="stat-value">@TakingExamStudents</div>
                    <div class="stat-label">Đang thi</div>
                </div>
            </div>
            
            <div class="stat-card">
                <div class="stat-icon purple">
                    <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Size="Size.Large" />
                </div>
                <div class="stat-content">
                    <div class="stat-value">@SubmittedStudents</div>
                    <div class="stat-label">Đã nộp bài</div>
                </div>
            </div>
        </div>

        <div class="student-table-container">
            <table class="student-table">
                <thead>
                    <tr>
                        <th class="col-stt">STT</th>
                        <th class="col-student-code">Mã SV</th>
                        <th class="col-name">Họ tên</th>
                        <th class="col-exam-status">Trạng thái thi</th>
                        <th class="col-login-status">Trạng thái đăng nhập</th>
                        <th class="col-cheat">Cảnh báo gian lận</th>
                        <th class="col-extra-time">Giờ cộng</th>
                        <th class="col-score">Điểm số</th>
                        <th class="col-actions">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var student in FilteredStudents)
                    {
                        var index = Students.IndexOf(student) + 1;
                        <tr>
                            <td class="col-stt">@index</td>
                            <td class="col-student-code">@($"#{student.StudentCode}")</td>
                            <td class="col-name">@($"{student.FirstName} {student.LastName}")</td>
                            <td class="col-exam-status">
                                @{
                                    var examStatus = GetExamStatus(student);
                                    var statusDisplayName = GetExamStatusDisplayName(examStatus);
                                    var statusCssClass = GetExamStatusCssClass(examStatus);
                                }
                                <span class="@statusCssClass">@statusDisplayName</span>
                            </td>
                            <td class="col-login-status">
                                @if (student.IsLogin)
                                {
                                    <span class="status-tag success">Đã đăng nhập</span>
                                }
                                else
                                {
                                    <span class="status-tag danger">Chưa đăng nhập</span>
                                }
                            </td>
                            <td class="col-cheat">
                                @if (student.CheatingWarningCount > 0)
                                {
                                    <span class="cheating-pill has-warning" @onclick="() => ShowCheatingWarnings(student)">
                                        <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" Class="cheating-pill__icon" />
                                        <span>@student.CheatingWarningCount cảnh báo</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="cheating-pill no-warning">
                                        <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" Class="cheating-pill__icon" />
                                        <span>An toàn</span>
                                    </span>
                                }
                            </td>
                            <td class="col-extra-time">@student.ExtraMinutes phút</td>
                            <td class="col-score">@(student.Score.ToString("0.0"))</td>
                            <td class="actions-cell col-actions">
                                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                                    <ActivatorContent>
                                        <MudIconButton Icon="@Icons.Material.Filled.Settings" 
                                                      Size="Size.Small" 
                                                      Color="Color.Default" 
                                                      Class="mx-1"
                                                      Title="Quản lý" />
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem OnClick="() => ToggleStudentLogin(student)">
                                            @if (student.IsLogin)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mr-2" Size="Size.Small" />
                                                <span>Khóa đăng nhập</span>
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.LockOpen" Class="mr-2" Size="Size.Small" />
                                                <span>Mở đăng nhập</span>
                                            }
                                        </MudMenuItem>
                                        <MudMenuItem OnClick="() => AddExtraTime(student)">
                                            <MudIcon Icon="@Icons.Material.Filled.Timer" Class="mr-2" Size="Size.Small" />
                                            <span>Thêm thời gian thi</span>
                                        </MudMenuItem>
                                        <MudMenuItem OnClick="() => MessageStudent(student.StudentCode)">
                                            <MudIcon Icon="@Icons.Material.Filled.Message" Class="mr-2" Size="Size.Small" />
                                            <span>Gửi thông báo</span>
                                        </MudMenuItem>
                                        <MudDivider />
                                        <MudMenuItem OnClick="() => ViewStudentDetails(student)">
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Class="mr-2" Size="Size.Small" />
                                            <span>Xem chi tiết</span>
                                        </MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!FilteredStudents.Any())
            {
                <div class="no-data">
                    Không tìm thấy sinh viên nào
                </div>
            }
        </div>
        
    }
    else
    {
        <div class="no-data">
            <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                Không có dữ liệu sinh viên
            </MudAlert>
        </div>
    }
</div>
