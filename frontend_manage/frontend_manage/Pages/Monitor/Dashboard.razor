@page "/monitor/dashboard"
@using frontend_manage.Services
@using MudBlazor

<div style="position:fixed; inset:0; width:100vw; height:100vh; z-index:-1; background: url('/images/Home_Page2.jpg') no-repeat center center fixed; background-size: cover;"></div>

<MudContainer MaxWidth="MaxWidth.False" Style="margin: 0; padding: 0;">
    <MudGrid Justify="Justify.Center" AlignItems="AlignItems.Center" Style="margin: 0; padding: 20px 0;">
        <MudItem xs="12" sm="10" md="8" lg="6">
            <MudPaper Elevation="24" Class="pa-4" Style="border-radius: 24px; max-width: 800px; width: 100%; margin: auto; background: white;">
                <MudStack Spacing="3" AlignItems="AlignItems.Center">
                    <MudImage Src="images/exam/Logo.svg" Width="200" />
                    <MudDivider />
                    
                    <MudText Typo="Typo.h5" Color="Color.Primary" Style="font-weight: 600; text-align: center; letter-spacing: 0.5px;">
                        DASHBOARD GIÁM SÁT
                    </MudText>
                    
                    <MudDivider Style="margin: 6px 0;" />
                    
                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Style="border-radius: 12px; font-size: 0.9rem;">
                        Bạn đã vào trang giám sát. Đây là nơi để theo dõi và quản lý quá trình thi.
                    </MudAlert>
                    
                    <MudDivider Style="margin: 6px 0;" />
                    
                    <MudStack Direction="Direction.Row" Justify="Justify.Center" Spacing="2">
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.ArrowBack" 
                                   OnClick="GoBackToExamRoomManagement" 
                                   Style="border-radius: 12px; font-weight: 500; height: 40px; font-size: 0.9rem;">
                            Quay lại quản lý phòng thi
                        </MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    [Inject] private NavigationManager Navigation { get; set; }

    private void GoBackToExamRoomManagement()
    {
        Navigation.NavigateTo("/monitor/exam-room-management");
    }
}
