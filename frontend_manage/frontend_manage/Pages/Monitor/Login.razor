@page "/monitor/login"
@using frontend_manage.DTOs
@using frontend_manage.Services
@using MudBlazor
@using Microsoft.AspNetCore.Components.Forms
@inject AuthService AuthService
@inject MonitorApi MonitorApi
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Đăng nhập Giảng viên - Hệ thống Giám sát</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Style="margin: 0; padding: 0; position: relative; overflow: hidden;">
    
    <!-- Background Image phủ full trang -->
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background-image: url('/images/Home_Page2.jpg'); background-size: cover; background-position: center; background-repeat: no-repeat; z-index: 1;"></div>
    
    <!-- Overlay -->
    <div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0, 0, 0, 0.4); z-index: 2;"></div>
    
    <!-- Error Message ở góc màn hình -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div style="position: fixed; top: 20px; right: 20px; z-index: 1000; max-width: 400px;">
            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Style="border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.3);">
                <MudText Style="font-weight: 700;">Lỗi đăng nhập</MudText>
                <MudText Style="font-size: 0.9rem;">@ErrorMessage</MudText>
            </MudAlert>
        </div>
    }
    
    <!-- Main Content căn giữa -->
    <MudGrid Justify="Justify.Center" AlignItems="AlignItems.Center" Style="position: relative; z-index: 3; margin: 0; padding: 40px 20px;">
        <MudItem xs="12" sm="10" md="6" lg="5" xl="4">
            <MudPaper Elevation="25" Style="border-radius: 32px; background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(20px); overflow: hidden;">
                
                <MudContainer Style="padding: 40px 30px;">
                    
                    <!-- Header -->
                    <MudStack Spacing="3" AlignItems="AlignItems.Center" Style="margin-bottom: 20px;">
                        <MudImage Src="/images/exam/Logo.svg" Width="140" Alt="HUTECH Logo" />
                        <MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight: 700; text-align: center; letter-spacing: 1px; text-transform: uppercase;">
                            Đăng nhập giảng viên
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-align: center; opacity: 0.8; font-weight: 500; font-size: 0.8rem;">
                            Đăng nhập để truy cập hệ thống giám sát thi cử
                        </MudText>
                    </MudStack>
                    
                    <!-- Login Form -->
                    <MudStack Spacing="3">
                        <EditForm Model="loginModel" OnValidSubmit="HandleLogin">
                            <DataAnnotationsValidator />
                            
                            <MudStack Spacing="2">
                                <!-- Lecturer Code 1 Field -->
                                <MudTextField @bind-Value="loginModel.LecturerCode1"
                                             Label="Mã giảng viên"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.Person"
                                             Required="true"
                                             RequiredError="Vui lòng nhập mã giảng viên"
                                             Style="border-radius: 12px;" />
                                
                                <!-- Lecturer Code 2 Field -->
                                <MudTextField @bind-Value="loginModel.LecturerCode2"
                                             Label="Mật khẩu"
                                             Variant="Variant.Outlined"
                                             Adornment="Adornment.Start"
                                             AdornmentIcon="@Icons.Material.Filled.Lock"
                                             InputType="InputType.Password"
                                             Required="true"
                                             RequiredError="Vui lòng nhập mật khẩu"
                                             Style="border-radius: 12px;" />
                                
                                <!-- Login Button -->
                                <MudButton ButtonType="ButtonType.Submit"
                                           Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@(_isLoading ? Icons.Material.Filled.HourglassEmpty : Icons.Material.Filled.Login)"
                                           Disabled="@_isLoading"
                                           FullWidth="true"
                                           Size="Size.Medium"
                                           Style="border-radius: 16px; font-weight: 600; height: 44px; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; margin-top: 10px;">
                                    @(_isLoading ? "Đang xử lý..." : "Đăng nhập")
                                </MudButton>
                            </MudStack>
                        </EditForm>
                    </MudStack>
                    
                    <!-- Footer -->
                    <MudStack Spacing="1" AlignItems="AlignItems.Center" Style="margin-top: 20px;">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-align: center; opacity: 0.7; font-size: 0.7rem;">
                            © 2024 HUTECH - Hệ thống giám sát thi cử
                        </MudText>
                    </MudStack>
                </MudContainer>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private LecturerLoginDto loginModel = new();
    private string? ErrorMessage;
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        // Kiểm tra xem đã đăng nhập chưa
        if (await AuthService.IsAuthenticated())
        {
            var role = await AuthService.GetUserRoleFromToken();
            if (role == "Lecturer")
            {
                Navigation.NavigateTo("/monitor/dashboard");
            }
            else
            {
                // Nếu không phải Lecturer, đăng xuất và quay lại trang login
                await AuthService.Logout();
                Navigation.NavigateTo("/monitor/login");
            }
        }
    }

    private async Task HandleLogin()
    {
        ErrorMessage = null;
        _isLoading = true;
        
        try
        {
            // Sử dụng MonitorApi để đăng nhập giảng viên
            var result = await MonitorApi.LoginLecturerAsync(loginModel.LecturerCode1, loginModel.LecturerCode2);
            
            if (result?.IsSuccess == true)
            {
                // Lưu token vào localStorage
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "authType", "jwt");
                await JSRuntime.InvokeVoidAsync("localStorage.setItem", "userType", "lecturer");
                
                // Sử dụng role từ LecturerAuthResultDto
                var role = result.Role;
                
                // Chỉ cho phép role Lecturer truy cập monitor
                if (role == "Lecturer")
                {
                    Navigation.NavigateTo("/monitor/dashboard");
                }
                else
                {
                    ErrorMessage = "Chỉ giảng viên mới có quyền truy cập hệ thống giám sát.";
                    await AuthService.Logout(); // Đăng xuất nếu không có quyền
                }
            }
            else
            {
                ErrorMessage = result?.ErrorMessage ?? "Đăng nhập thất bại";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Lỗi đăng nhập: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
