@page "/monitor"
@using Microsoft.AspNetCore.Components
@using frontend_manage.Services
@using frontend_manage.Pages.Monitor.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.SignalR.Client
@using MudBlazor
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks
@using frontend_manage.Components.MonitorLayout
@inherits ComponentBase
@implements IDisposable

<link href="css/monitor/MonitorPage.css" rel="stylesheet" />

<div class="monitor-page">
    <!-- Header -->
    <Header
        Subtitle="EXAM SUITE - MONITOR"
        EditionTag="Professional Edition"
        Description="Hệ thống quản lý và theo dõi Ca thi"
        ModeTag="Monitor (Testing Mode)">
        <RightContent>
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Color="Color.Inherit"
                           OnClick="GoBackToExamRoomManagement"
                           Title="Quay lại quản lý phòng thi" />
            <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" />
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
        </RightContent>
    </Header>

    <!-- Navigation -->
    <div class="monitor-nav">
        <div class="nav-item @(activeTab == 0 ? "active" : "")" @onclick="() => ActivateTab(0)">
            <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" />
            <span>DANH SÁCH SINH VIÊN</span>

        </div>
        <div class="nav-item @(activeTab == 1 ? "active" : "")" @onclick="() => ActivateTab(1)">
            <MudIcon Icon="@Icons.Material.Filled.Info" />
            <span>THÔNG TIN CA THI</span>
        </div>
    </div>



    <!-- Content Area -->
    <div class="monitor-content">
        @if (isLoading)
        {
            <div class="@(activeTab == 0 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 0 || previousTab == 0)
                {
                    <div class="loading-container">
                        <div class="loading-spinner"></div>
                        <div class="loading-text">Đang tải dữ liệu...</div>
                    </div>
                }
            </div>
            <div class="@(activeTab == 1 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 1 || previousTab == 1)
                {
                    <div class="loading-container">
                        <div class="loading-spinner"></div>
                        <div class="loading-text">Đang tải dữ liệu...</div>
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="@(activeTab == 0 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 0 || previousTab == 0)
                {
                    <div class="error-container">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                            @errorMessage
                        </MudAlert>
                    </div>
                }
            </div>
            <div class="@(activeTab == 1 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 1 || previousTab == 1)
                {
                    <div class="error-container">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
                            @errorMessage
                        </MudAlert>
                    </div>
                }
            </div>
        }
        else if (examData != null)
        {
            <div class="@(activeTab == 0 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 0 || previousTab == 0)
                {
                    <StudentListTab Students="@examData.Students" ExamSessionSubjectId="@ExamSessionSubjectId" ExamSessionName="@examData.Subject?.ExamSessionName" ExamSessionStartTime="@examData.Subject?.ExamSessionStartTime" />
                }
            </div>
            <div class="@(activeTab == 1 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 1 || previousTab == 1)
                {
                    <ExamInfoTab Subject="@examData.Subject" ExamSessionSubjectId="@ExamSessionSubjectId" />
                }
            </div>
        }
        else
        {
            <div class="@(activeTab == 0 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 0 || previousTab == 0)
                {
                    <div class="no-data-container">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                            Vui lòng chọn phòng thi để xem danh sách sinh viên
                        </MudAlert>
                    </div>
                }
            </div>
            <div class="@(activeTab == 1 ? "tab-content-active" : "tab-content-hidden")">
                @if (activeTab == 1 || previousTab == 1)
                {
                    <div class="no-data-container">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                            Vui lòng chọn phòng thi để xem thông tin ca thi
                        </MudAlert>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Footer -->
    <Footer
        ModeLabel="Exam Monitoring System"
        Version="1.0.1"
        DevelopedBy="Developed by Natwodev & Juo" />
</div>

@* Code is now in MonitorPage.razor.cs *@
